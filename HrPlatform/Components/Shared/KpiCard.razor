<div class="col-12 col-md-6 col-lg-4">
    @if (!string.IsNullOrEmpty(Href))
    {
        <a href="@Href" class="text-decoration-none d-block h-100">
            <div class="card shadow-sm h-100 kpi-card position-relative overflow-hidden"
                 style="background-color: var(--bg-card); border: 1px solid var(--border-color) !important;">
                <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background-color: @IconColor;"></div>
                
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="flex-grow-1">
                        <h6 class="text-secondary fw-semibold mb-2 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.8rem;">@Label</h6>
                        <h2 class="mb-0 fw-bold text-white display-6">@Value</h2>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width: 54px; height: 54px; background-color: @IconBg;">
                        <i class="bi @Icon fs-3" style="color: @IconColor;"></i>
                    </div>
                </div>
            </div>
        </a>
    }
    else
    {
        <div class="card shadow-sm h-100 kpi-card position-relative overflow-hidden"
             style="background-color: var(--bg-card); border: 1px solid var(--border-color) !important;">
            <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background-color: @IconColor;"></div>
            
            <div class="card-body p-4 d-flex align-items-center">
                <div class="flex-grow-1">
                    <h6 class="text-secondary fw-semibold mb-2 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.8rem;">@Label</h6>
                    <h2 class="mb-0 fw-bold text-white display-6">@Value</h2>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width: 54px; height: 54px; background-color: @IconBg;">
                    <i class="bi @Icon fs-3" style="color: @IconColor;"></i>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .kpi-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out, border-color 0.2s ease-in-out;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .25) !important;
    }
    a:hover .kpi-card {
        border-color: rgba(255, 255, 255, 0.3) !important;
    }
</style>

@code {
    [Parameter] public required string Label { get; set; }
    [Parameter] public object Value { get; set; } = 0;
    [Parameter] public required string Icon { get; set; }
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string? Href { get; set; }

    private string IconColor => Color switch
    {
        "primary" => "var(--accent-primary)",
        "success" => "#10b981",
        "warning" => "#f59e0b",
        "danger" => "#ef4444",
        "info" => "#06b6d4",
        _ => "#94a3b8"
    };

    private string IconBg => Color switch
    {
        "primary" => "rgba(230, 168, 56, 0.15)",
        "success" => "rgba(16, 185, 129, 0.15)",
        "warning" => "rgba(245, 158, 11, 0.15)",
        "info" => "rgba(6, 182, 212, 0.15)",
        "danger" => "rgba(239, 68, 68, 0.15)",
        _ => "rgba(148, 163, 184, 0.15)"
    };
}
