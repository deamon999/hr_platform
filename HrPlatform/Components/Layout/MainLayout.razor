@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="app-layout d-flex flex-column" style="min-height: 100vh;">
    <header class="top-row px-4 d-flex justify-content-between align-items-center bg-white shadow-sm" style="position: sticky; top: 0; z-index: 1050; border-bottom: 1px solid var(--border-color);">
        <a class="navbar-brand text-dark fw-bold text-decoration-none d-flex align-items-center gap-2" href="">
            <img src="/logo.jpg" alt="CDL Pool Logo" style="height: 48px; border-radius: 6px; object-fit: cover;" />
            CDL Pool
        </a>

        <div class="d-flex align-items-center mobile-auth-spacer">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link text-dark me-3" href="Account/Manage" title="Manage Account">
                        <span class="bi bi-person-fill" aria-hidden="true"></span>
                        <span class="d-none d-sm-inline ms-1">@context.User.Identity?.Name</span>
                    </NavLink>

                    <form action="Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken/>
                        <input type="hidden" name="ReturnUrl" value=""/>
                        <button type="submit" class="nav-link btn btn-link p-0 text-dark" title="Logout">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                            <span class="d-none d-sm-inline ms-1">Logout</span>
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <NavLink class="nav-link text-dark me-3" href="Account/Register" title="Register">
                        <span class="bi bi-person-plus" aria-hidden="true"></span>
                        <span class="d-none d-sm-inline ms-1">Register</span>
                    </NavLink>

                    <NavLink class="nav-link text-dark" href="Account/Login" title="Login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span>
                        <span class="d-none d-sm-inline ms-1">Login</span>
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <div class="page flex-grow-1">
        <div class="sidebar">
            <NavMenu/>
        </div>

        <main class="flex-grow-1 d-flex flex-column">
            <article class="content px-4 py-4 flex-grow-1">
                <div class="container-fluid">
                    @Body
                </div>
            </article>

        </main>
    </div>

    <footer class="mt-auto py-3 bg-white border-top text-muted" style="z-index: 1050;">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <img src="/logo.jpg" alt="CDL Pool Logo" style="height: 24px; border-radius: 4px; object-fit: cover;" />
                <span class="fw-semibold" style="font-size: 0.9rem;">CDL Pool &copy; @DateTime.Now.Year</span>
            </div>
            <ul class="nav">
                <li class="nav-item"><a href="/about" class="nav-link px-2 text-muted" style="font-size: 0.9rem;">About</a></li>
            </ul>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
