@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="app-layout d-flex flex-column" style="min-height: 100vh;">
    <header class="top-row px-4 d-flex justify-content-between align-items-center bg-white shadow-sm" style="position: sticky; top: 0; z-index: 1050; border-bottom: 1px solid var(--border-color);">
        <a class="navbar-brand text-dark fw-bold text-decoration-none d-flex align-items-center gap-2" href="">
            <img src="/logo.jpg" alt="CDL Pool Logo" style="height: 48px; border-radius: 6px; object-fit: cover;" />
            CDL Pool
        </a>

        <div class="d-flex align-items-center pe-5 pe-sm-0">
            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link text-dark me-3" href="Account/Manage">
                        <span class="bi bi-person-fill" aria-hidden="true"></span>
                        @context.User.Identity?.Name
                    </NavLink>

                    <form action="Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken/>
                        <input type="hidden" name="ReturnUrl" value=""/>
                        <button type="submit" class="nav-link btn btn-link p-0 text-dark">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                            Logout
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <NavLink class="nav-link text-dark me-3" href="Account/Register">
                        <span class="bi bi-person-plus" aria-hidden="true"></span>
                        Register
                    </NavLink>

                    <NavLink class="nav-link text-dark" href="Account/Login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span>
                        Login
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <div class="page flex-grow-1 d-flex flex-row">
        <div class="sidebar">
            <NavMenu/>
        </div>

        <main class="flex-grow-1">
            <article class="content px-4 py-4">
                <div class="container-fluid">
                    @Body
                </div>
            </article>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
