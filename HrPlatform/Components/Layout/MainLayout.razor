@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center shadow-sm">

            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link text-white me-3" href="Account/Manage">
                        <span class="bi bi-person-fill" aria-hidden="true"></span>
                        @context.User.Identity?.Name
                    </NavLink>

                    <form action="Account/Logout" method="post" class="d-inline">
                        <AntiforgeryToken/>
                        <input type="hidden" name="ReturnUrl" value=""/>
                        <button type="submit" class="nav-link btn btn-link p-0 text-white">
                            <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                            Logout
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <NavLink class="nav-link text-white me-3" href="Account/Register">
                        <span class="bi bi-person-plus" aria-hidden="true"></span>
                        Register
                    </NavLink>

                    <NavLink class="nav-link text-white" href="Account/Login">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span>
                        Login
                    </NavLink>
                </NotAuthorized>
            </AuthorizeView>
        </div>


        <article class="content px-4 py-4">
            <div class="container-fluid">
                @Body
            </div>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
