@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CDL Pool</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Jobs
            </NavLink>
        </div>

        <AuthorizeView Roles="@($"{RoleConstants.Admin}")">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="companies">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Companies
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{RoleConstants.Admin},{RoleConstants.Manager}")">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="users">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> User Management
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{RoleConstants.Admin},{RoleConstants.Manager}")">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="invitations">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Invitation Management
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@RoleConstants.Driver">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="driver/invitations">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Job Invitations
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@RoleConstants.Driver">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="my-profile">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Driver Profile
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{RoleConstants.Admin},{RoleConstants.Manager}")">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="profiles">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Driver Profiles
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{RoleConstants.Driver},{RoleConstants.Manager}")">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="applications">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Applications
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>