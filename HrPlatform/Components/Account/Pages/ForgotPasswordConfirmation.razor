@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <section class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4 text-center">
                <div class="mb-4 text-primary">
                    <i class="bi bi-envelope-check-fill" style="font-size: 3rem;"></i>
                </div>
                <h2 class="fw-bold mb-3">Check Your Email</h2>
                <p class="text-secondary mb-4" role="alert">
                    If an account exists for that email address, we have sent a link to reset your password. Please check your inbox.
                </p>
                <a href="Account/Login" class="btn btn-outline-secondary btn-lg w-100 fw-bold">Return to Login</a>
            </div>
        </section>
    </div>
</div>
