@page "/Account/ResetPasswordConfirmation"
<PageTitle>Reset password confirmation</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <section class="card shadow-sm border-0 mt-4">
            <div class="card-body p-4 text-center">
                <div class="mb-4 text-success">
                    <i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i>
                </div>
                <h2 class="fw-bold mb-3">Password Reset Successful</h2>
                <p class="text-secondary mb-4" role="alert">
                    Your password has been securely reset. You can now use your new password to log in to your account.
                </p>
                <a href="Account/Login" class="btn btn-primary btn-lg w-100 fw-bold">Log In</a>
            </div>
        </section>
    </div>
</div>
