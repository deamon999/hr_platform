@page "/applications"
@using System.Security.Claims
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Driver},{RoleConstants.Manager}")]
@inject IJobApplicationService AppSvc
@inject IJobMatchService JobMatchService
@inject AuthenticationStateProvider AuthState
@inject IApplicationMessageService MessageService
@inject NavigationManager Nav

<PageTitle>Applications</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Applications</h2>
    <div class="btn-group btn-group-sm" role="group">
        <button class="btn @(viewMode == "table" ? "btn-primary" : "btn-outline-secondary")"
                @onclick="@(() => SetView("table"))">
            <i class="bi bi-table"></i> Table
        </button>
        <button class="btn @(viewMode == "kanban" ? "btn-primary" : "btn-outline-secondary")"
                @onclick="@(() => SetView("kanban"))">
            <i class="bi bi-kanban"></i> Board
        </button>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <div style="flex: 1;">
        <select class="form-select form-select-sm w-auto" style="min-width: 180px;" @bind="sortBy" @bind:after="HandleSortChange">
            <option value="date">Sort: Date Applied</option>
            <option value="status">Sort: Status</option>
            <option value="driver">Sort: Driver Name</option>
            <option value="job">Sort: Job Title</option>
        </select>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
        <select class="form-select form-select-sm border-0 bg-white shadow-sm" style="width: 70px;" @bind="PageSize" @bind:after="OnPageSizeChanged">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (pagedApps is null)
{
    <p>Loading...</p>
}
else if (!pagedApps.Any())
{
    <div class="alert alert-info">No applications found.</div>
}
else
{
    <div>
        @if (viewMode == "table")
        {
            <div class="row g-3">
                @foreach (var app in pagedApps)
                {
                    <div class="col-12">
                        <div class="card shadow-sm border-0 bg-white h-100 app-card">
                            <div class="card-body p-4">
                                <div class="row g-3">
                                    <div class="col-md-7">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="fw-bold mb-0 text-dark">@app.Job.Title</h5>
                                        </div>
                                        <h6 class="text-primary mb-3">@DisplayCompanyName(app.Job)</h6>
                                        
                                        <div class="mb-3">
                                            <div class="fw-bold text-dark"><i class="bi bi-person"></i> @app.User.FirstName @app.User.LastName</div>
                                            <div class="text-secondary small">@app.User.Email</div>
                                        </div>

                                        <div class="d-flex flex-wrap gap-2 text-secondary small">
                                            <span class="badge @StatusBadge(app.Status) rounded-pill px-3 py-2 border">@app.Status</span>
                                            <span class="d-flex align-items-center"><i class="bi bi-calendar3 me-1"></i> Applied @app.AppliedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                            @if (app.ReviewedAt.HasValue)
                                            {
                                                <span class="d-flex align-items-center"><i class="bi bi-eye me-1"></i> Reviewed @app.ReviewedAt.Value.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-5 d-flex flex-column justify-content-between">
                                        <div class="text-md-end mb-3">
                                            <div class="text-muted small text-uppercase fw-bold mb-1">Match Score</div>
                                            @{
                                                var profile = app.User?.DriverProfile;
                                                if (profile != null)
                                                {
                                                    var s = JobMatchService.ComputeScore(profile, app.Job);
                                                    <span class="badge @JobMatchService.ScoreBadgeClass(s) rounded-pill px-3 py-2 fs-6 border" title="@JobMatchService.ScoreLabel(s)">
                                                        @s% Match
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Profile Incomplete</span>
                                                }
                                            }
                                        </div>
                                        
                                        <div class="d-flex gap-2 justify-content-md-end flex-wrap mt-auto">
                                            <a href="/applications/@app.Id/chat" class="btn btn-primary position-relative">
                                                <i class="bi bi-chat-dots"></i> Messages
                                                @if (unreadCounts.TryGetValue(app.Id, out var count) && count > 0)
                                                {
                                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light">
                                                        @count
                                                    </span>
                                                }
                                            </a>

                                            @if (isManager)
                                            {
                                                <a href="/profiles/@app.User.DriverProfile?.Id" class="btn btn-outline-secondary">
                                                    Profile
                                                </a>

                                                @if (reviewing != app.Id)
                                                {
                                                    <button class="btn btn-outline-info" @onclick="() => BeginReview(app)">
                                                        Update Status
                                                    </button>
                                                }
                                                else
                                                {
                                                    <div class="d-flex flex-column gap-2 p-2 border rounded shadow-sm bg-light w-100 mt-2 mt-md-0 position-absolute" style="max-width: 300px; z-index: 10; right: 0;">
                                                        <select class="form-select form-select-sm" @bind="reviewStatus">
                                                            @foreach (var s in Enum.GetValues<ApplicationStatus>())
                                                            {
                                                                <option value="@s">@s</option>
                                                            }
                                                        </select>
                                                        <input type="text" class="form-control form-control-sm" placeholder="Notes (optional)" @bind="reviewNotes"/>
                                                        <div class="d-flex gap-1">
                                                            <button class="btn btn-sm btn-primary flex-fill" @onclick="SaveReviewAsync">Save</button>
                                                            <button class="btn btn-sm btn-secondary" @onclick="() => reviewing = null"><i class="bi bi-x"></i></button>
                                                        </div>
                                                    </div>
                                                }
                                            }

                                            @if (isDriver)
                                            {
                                                <button type="button" class="btn btn-outline-danger" @onclick="() => ConfirmWithdraw(app)">
                                                    Withdraw
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <style>
                .app-card {
                    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
                }
                .app-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
                }
            </style>

            @if (totalPages > 1)
            {
                <nav aria-label="Application list pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                        </li>

                        @for (var i = 1; i <= totalPages; i++)
                        {
                            var pageIndex = i;
                            <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                                <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            }
        }
        else if (viewMode == "kanban" && pagedApps is not null)
        {
            var columns = Enum.GetValues<ApplicationStatus>();
            <div class="row g-3">
                @foreach (var col in columns)
                {
                    var colApps = pagedApps.Where(a => a.Status == col).ToList();
                    <div class="col-md-3">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-header d-flex justify-content-between bg-transparent border-0 pb-0">
                                <span class="badge @StatusBadge(col) rounded-pill w-100 text-start py-2 fs-6 shadow-sm border border-light text-dark bg-opacity-25">
                                    @col (@colApps.Count)
                                </span>
                            </div>
                            <div class="card-body p-2 overflow-auto" style="max-height:70vh">
                                @foreach (var app in colApps)
                                {
                                    <div class="card mb-2 shadow-sm border-0"
                                         draggable="true"
                                         @ondragstart="() => StartDrag(app.Id)">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <strong class="text-dark">
                                                    @app.User.FirstName @app.User.LastName
                                                </strong>
                                                <div class="text-muted" style="font-size:.75rem">
                                                    @app.AppliedAt.ToLocalTime().ToString("MMM dd")
                                                </div>
                                            </div>
                                            <div class="text-secondary mb-2" style="font-size:.85rem">
                                                <i class="bi bi-briefcase me-1"></i> @app.Job.Title
                                            </div>
                                            @if (isManager && app.User.DriverProfile != null)
                                            {
                                                <a href="/profiles/@app.User.DriverProfile.Id"
                                                   class="btn btn-outline-secondary btn-sm py-1 px-2"
                                                   style="font-size:.75rem">Profile</a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (isManager)
                            {
                                <div class="card-footer p-2 bg-transparent border-0 text-center"
                                     style="border: 2px dashed #dee2e6 !important; border-radius: 6px; margin: 0.5rem;"
                                     @ondragover:preventDefault
                                     @ondrop="() => DropOnColumn(col)">
                                    <small class="text-muted"><i class="bi bi-arrow-down-circle me-1"></i>Drop here</small>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@if (withdrawTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Withdraw Application</h5>
                </div>

                <div class="modal-body">
                    <p>
                        Are you sure you want to withdraw your application for
                        <strong>@withdrawTarget.Job.Title</strong>?
                    </p>
                    <p class=" small mb-0">
                        This will permanently remove this application.
                    </p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => withdrawTarget = null">
                        Cancel
                    </button>
                    <button class="btn btn-danger" @onclick="WithdrawConfirmedAsync">
                        Withdraw Application
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<JobApplication>? pagedApps;
    private bool isAdmin;
    private Dictionary<int, int> unreadCounts = new();
    private string sortBy = "date";
    private int? reviewing;
    private ApplicationStatus reviewStatus = ApplicationStatus.UnderReview;
    private string? reviewNotes;

    // Kanban State
    private string viewMode = "table";
    private int? draggingAppId;

    private bool isManager;
    private bool isDriver;
    private string? currentUserId;
    private int? currentCompanyId;

    private JobApplication? withdrawTarget;

    // Pagination State
    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 10;

    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;

        isAdmin = user.IsInRole(RoleConstants.Admin);
        isManager = user.IsInRole(RoleConstants.Manager);
        isDriver = user.IsInRole(RoleConstants.Driver);

        // Extract Claims
        currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        var companyClaim = user.FindFirst("companyId")?.Value;
        if (int.TryParse(companyClaim, out var parsedCompanyId))
        {
            currentCompanyId = parsedCompanyId;
        }
    }

    private string DisplayCompanyName(Job job)
    {
        if (job.IsConfidential && !isAdmin) return "CDL Pool Client";
        return job.Company?.Name ?? "Unknown Company";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;
        await LoadAsync();
    }

    private void HandleSortChange()
    {
        ChangePage(1);
    }

    private void OnPageSizeChanged()
    {
        ChangePage(1);
    }

    private async Task LoadAsync()
    {
        // 1. Fetch all items matching criteria and sorting
        var allApps = await AppSvc.GetAllFilteredAsync(
            currentUserId,
            isManager,
            isDriver,
            currentCompanyId,
            sortBy);

        if (allApps == null)
        {
            pagedApps = new List<JobApplication>();
            return;
        }

        // 2. Calculate Pages
        totalPages = (int)Math.Ceiling(allApps.Count / (double)PageSize);
        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        // 3. Extract current page slice
        pagedApps = allApps
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

        unreadCounts.Clear();
        if (currentUserId != null && pagedApps.Any())
        {
            foreach (var app in pagedApps)
            {
                unreadCounts[app.Id] = await MessageService.GetUnreadCountAsync(app.Id, currentUserId);
            }
        }
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = page,
            ["size"] = PageSize
        });
        Nav.NavigateTo(uri);
    }

    private static string StatusBadge(ApplicationStatus s)
    {
        return s switch
        {
            ApplicationStatus.Pending => "bg-warning ",
            ApplicationStatus.UnderReview => "bg-info ",
            ApplicationStatus.Accepted => "bg-success",
            ApplicationStatus.Rejected => "bg-danger",
            _ => ""
        };
    }

    private void BeginReview(JobApplication app)
    {
        reviewing = app.Id;
        reviewStatus = app.Status;
        reviewNotes = app.ReviewerNotes;
    }

    private async Task SaveReviewAsync()
    {
        if (reviewing is null)
            return;

        await AppSvc.ReviewAsync(reviewing.Value, reviewStatus, reviewNotes);
        reviewing = null;
        await LoadAsync();
    }

    private void ConfirmWithdraw(JobApplication app)
    {
        withdrawTarget = app;
    }

    private async Task WithdrawConfirmedAsync()
    {
        if (withdrawTarget is null)
            return;

        await AppSvc.WithdrawAsync(withdrawTarget.Id);
        withdrawTarget = null;

        await LoadAsync();

        // Smart reload: If you withdraw the last app on page 3, drop back to page 2
        if (pagedApps?.Count == 0 && currentPage > 1)
        {
            currentPage--;
            await LoadAsync();
        }
    }

    private void SetView(string mode) { viewMode = mode; }

    private void StartDrag(int appId) { draggingAppId = appId; }

    private async Task DropOnColumn(ApplicationStatus newStatus)
    {
        if (draggingAppId is null) return;
        await AppSvc.ReviewAsync(draggingAppId.Value, newStatus, null);
        draggingAppId = null;
        await LoadAsync();
    }
}







