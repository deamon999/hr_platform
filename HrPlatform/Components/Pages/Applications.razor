@page "/applications"
@using System.Security.Claims
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Driver},{RoleConstants.Manager}")]
@inject IJobApplicationService AppSvc
@inject IJobMatchService JobMatchService
@inject AuthenticationStateProvider AuthState
@inject IApplicationMessageService MessageService

<PageTitle>Applications</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Applications</h2>
    <div class="btn-group btn-group-sm" role="group">
        <button class="btn @(viewMode == "table" ? "btn-primary" : "btn-outline-secondary")"
                @onclick="@(() => SetView("table"))">
            <i class="bi bi-table"></i> Table
        </button>
        <button class="btn @(viewMode == "kanban" ? "btn-primary" : "btn-outline-secondary")"
                @onclick="@(() => SetView("kanban"))">
            <i class="bi bi-kanban"></i> Board
        </button>
    </div>
</div>

<div class="d-flex flex-wrap gap-3 mb-3 align-items-center">
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0">Sort by:</label>
        <select class="form-select form-select-sm w-auto" @bind="sortBy" @bind:after="HandleSortChange">
            <option value="date">Date Applied</option>
            <option value="status">Status</option>
            <option value="driver">Driver Name</option>
            <option value="job">Job Title</option>
        </select>
    </div>
</div>

@if (pagedApps is null)
{
    <p>Loading...</p>
}
else if (!pagedApps.Any())
{
    <div class="alert alert-info">No applications found.</div>
}
else
{
    <div>
        @if (viewMode == "table")
        {
        <div class="table-responsive d-none d-md-block">
            <table class="table  table-hover align-middle">
                <thead class="">
                <tr>
                    <th>Job</th>
                    <th>Driver</th>
                    <th>Applied</th>
                    <th>Status</th>
                    <th>Reviewed</th>
                    <th>Match Score</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var app in pagedApps)
                {
                    <tr>
                        <td>
                            <strong>@app.Job.Title</strong><br/>
                            <small class="">@(app.Job.Company?.Name ?? "")</small>
                        </td>
                        <td>
                            @app.User.FirstName @app.User.LastName<br/>
                            <small class="">@app.User.Email</small>
                        </td>
                        <td class="text-nowrap">@app.AppliedAt.ToLocalTime().ToString("MM/dd/yyyy")</td>
                        <td>
                            <span class="badge @StatusBadge(app.Status)">@app.Status</span>
                        </td>
                        <td class="text-nowrap">
                            @(app.ReviewedAt.HasValue
                                ? app.ReviewedAt.Value.ToLocalTime().ToString("MM/dd/yyyy")
                                : "—")
                        </td>
                        <td>
                            @{
                                var profile = app.User?.DriverProfile;
                                if (profile != null)
                                {
                                    // Ensure License + EmploymentHistory are loaded
                                    var s = JobMatchService.ComputeScore(profile, app.Job);
                                    <span class="badge @JobMatchService.ScoreBadgeClass(s)"
                                          title="@JobMatchService.ScoreLabel(s)">
                                        @s%
                                    </span>
                                }
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a href="/applications/@app.Id/chat" class="btn btn-sm btn-outline-primary position-relative">
                                    <i class="bi bi-chat-dots"></i> Messages
                                    @if (unreadCounts.TryGetValue(app.Id, out var count) && count > 0)
                                    {
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            @count
                                        </span>
                                    }
                                </a>

                                @if (isManager)
                                {
                                    <a href="/profiles/@app.User.DriverProfile.Id"
                                       class="btn btn-sm btn-outline-secondary">View Profile</a>

                                    @if (reviewing != app.Id)
                                    {
                                        <button class="btn btn-sm btn-outline-info"
                                                @onclick="() => BeginReview(app)">
                                            Change Status
                                        </button>
                                    }
                                    else
                                    {
                                        <select class="form-select form-select-sm w-auto" @bind="reviewStatus">
                                            @foreach (var s in Enum.GetValues<ApplicationStatus>())
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        </select>
                                        <input type="text" class="form-control form-control-sm"
                                               placeholder="Notes (optional)"
                                               @bind="reviewNotes" style="width:160px"/>
                                        <button class="btn btn-sm btn-primary" @onclick="SaveReviewAsync">Save</button>
                                        <button class="btn btn-sm btn-secondary" @onclick="() => reviewing = null">×</button>
                                    }
                                }

                                @if (isDriver)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmWithdraw(app)">
                                        Withdraw Application
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="d-block d-md-none">
            @foreach (var app in pagedApps)
            {
                <div class="card mb-3 ">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="card-title mb-0"><strong>@app.Job.Title</strong></h5>
                            <span class="badge @StatusBadge(app.Status)">@app.Status</span>
                        </div>
                        <div class=" small mb-3">@(app.Job.Company?.Name ?? "")</div>

                        <div class="row mb-3">
                            <div class="col-12 mb-2">
                                <strong>Driver:</strong> <br/>
                                @app.User.FirstName @app.User.LastName <br/>
                                <small>@app.User.Email</small>
                            </div>
                            <div class="col-6">
                                <strong>Applied:</strong><br/>
                                @app.AppliedAt.ToLocalTime().ToString("MM/dd/yyyy")
                            </div>
                            <div class="col-3">
                                <strong>Reviewed:</strong><br/>
                                @(app.ReviewedAt.HasValue ? app.ReviewedAt.Value.ToLocalTime().ToString("MM/dd/yyyy") : "—")
                            </div>
                            <div class="col-3">
                                <strong>Match Score:</strong><br/>
                                @{
                                    var profile = app.User?.DriverProfile;
                                    if (profile != null)
                                    {
                                        // Ensure License + EmploymentHistory are loaded
                                        var s = JobMatchService.ComputeScore(profile, app.Job);
                                        <span class="badge @JobMatchService.ScoreBadgeClass(s)"
                                              title="@JobMatchService.ScoreLabel(s)">
                                            @s%
                                        </span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-2 pt-3 border-top">
                            <a href="/applications/@app.Id/chat" class="btn btn-sm btn-outline-primary w-100 position-relative">
                                <i class="bi bi-chat-dots"></i> Messages
                                @if (unreadCounts.TryGetValue(app.Id, out var count2) && count2 > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        @count2
                                    </span>
                                }
                            </a>

                            @if (isManager)
                            {
                                <a href="/profiles/@app.User.DriverProfile.Id" class="btn btn-sm btn-outline-secondary w-100">
                                    View Profile
                                </a>

                                @if (reviewing != app.Id)
                                {
                                    <button class="btn btn-sm btn-outline-info w-100" @onclick="() => BeginReview(app)">
                                        Change Status
                                    </button>
                                }
                                else
                                {
                                    <div class="p-2 border rounded  d-flex flex-column gap-2 mt-2">
                                        <label class="small fw-bold mb-0">Update Status</label>
                                        <select class="form-select form-select-sm" @bind="reviewStatus">
                                            @foreach (var s in Enum.GetValues<ApplicationStatus>())
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        </select>
                                        <input type="text" class="form-control form-control-sm" placeholder="Notes (optional)" @bind="reviewNotes"/>
                                        <div class="d-flex gap-2 mt-1">
                                            <button class="btn btn-sm btn-primary flex-fill" @onclick="SaveReviewAsync">Save</button>
                                            <button class="btn btn-sm btn-secondary flex-fill" @onclick="() => reviewing = null">Cancel</button>
                                        </div>
                                    </div>
                                }
                            }

                            @if (isDriver)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger w-100" @onclick="() => ConfirmWithdraw(app)">
                                    Withdraw Application
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Application list pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                    </li>

                    @for (var i = 1; i <= totalPages; i++)
                    {
                        var pageIndex = i;
                        <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
        }
        else if (viewMode == "kanban" && pagedApps is not null)
        {
            var columns = Enum.GetValues<ApplicationStatus>();
            <div class="row g-3">
                @foreach (var col in columns)
                {
                    var colApps = pagedApps.Where(a => a.Status == col).ToList();
                    <div class="col-md-3">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-header d-flex justify-content-between bg-transparent border-0 pb-0">
                                <span class="badge @StatusBadge(col) w-100 text-start py-2 fs-6 shadow-sm">
                                    @col (@colApps.Count)
                                </span>
                            </div>
                            <div class="card-body p-2 overflow-auto" style="max-height:70vh">
                                @foreach (var app in colApps)
                                {
                                    <div class="card mb-2 shadow-sm border-0"
                                         draggable="true"
                                         @ondragstart="() => StartDrag(app.Id)">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <strong class="text-dark">
                                                    @app.User.FirstName @app.User.LastName
                                                </strong>
                                                <div class="text-muted" style="font-size:.75rem">
                                                    @app.AppliedAt.ToLocalTime().ToString("MMM dd")
                                                </div>
                                            </div>
                                            <div class="text-secondary mb-2" style="font-size:.85rem">
                                                <i class="bi bi-briefcase me-1"></i> @app.Job.Title
                                            </div>
                                            @if (isManager && app.User.DriverProfile != null)
                                            {
                                                <a href="/profiles/@app.User.DriverProfile.Id"
                                                   class="btn btn-outline-secondary btn-sm py-1 px-2"
                                                   style="font-size:.75rem">Profile</a>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (isManager)
                            {
                                <div class="card-footer p-2 bg-transparent border-0 text-center"
                                     style="border: 2px dashed #dee2e6 !important; border-radius: 6px; margin: 0.5rem;"
                                     @ondragover:preventDefault
                                     @ondrop="() => DropOnColumn(col)">
                                    <small class="text-muted"><i class="bi bi-arrow-down-circle me-1"></i>Drop here</small>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@if (withdrawTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Withdraw Application</h5>
                </div>

                <div class="modal-body">
                    <p>
                        Are you sure you want to withdraw your application for
                        <strong>@withdrawTarget.Job.Title</strong>?
                    </p>
                    <p class=" small mb-0">
                        This will permanently remove this application.
                    </p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => withdrawTarget = null">
                        Cancel
                    </button>
                    <button class="btn btn-danger" @onclick="WithdrawConfirmedAsync">
                        Withdraw Application
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<JobApplication>? pagedApps;
    private Dictionary<int, int> unreadCounts = new();
    private string sortBy = "date";
    private int? reviewing;
    private ApplicationStatus reviewStatus = ApplicationStatus.UnderReview;
    private string? reviewNotes;

    // Kanban State
    private string viewMode = "table";
    private int? draggingAppId;

    private bool isManager;
    private bool isDriver;
    private string? currentUserId;
    private int? currentCompanyId;

    private JobApplication? withdrawTarget;

    // Pagination State
    private int currentPage = 1;
    private const int PageSize = 10;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;

        isManager = user.IsInRole(RoleConstants.Manager);
        isDriver = user.IsInRole(RoleConstants.Driver);

        // Extract Claims
        currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        var companyClaim = user.FindFirst("companyId")?.Value;
        if (int.TryParse(companyClaim, out var parsedCompanyId))
        {
            currentCompanyId = parsedCompanyId;
        }

        await LoadAsync();
    }

    private async Task HandleSortChange()
    {
        currentPage = 1; // Drop to page 1 when sort order changes
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // 1. Fetch all items matching criteria and sorting
        var allApps = await AppSvc.GetAllFilteredAsync(
            currentUserId,
            isManager,
            isDriver,
            currentCompanyId,
            sortBy);

        if (allApps == null)
        {
            pagedApps = new List<JobApplication>();
            return;
        }

        // 2. Calculate Pages
        totalPages = (int)Math.Ceiling(allApps.Count / (double)PageSize);
        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        // 3. Extract current page slice
        pagedApps = allApps
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();

        unreadCounts.Clear();
        if (currentUserId != null && pagedApps.Any())
        {
            foreach (var app in pagedApps)
            {
                unreadCounts[app.Id] = await MessageService.GetUnreadCountAsync(app.Id, currentUserId);
            }
        }
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadAsync();
    }

    private static string StatusBadge(ApplicationStatus s)
    {
        return s switch
        {
            ApplicationStatus.Pending => "bg-warning ",
            ApplicationStatus.UnderReview => "bg-info ",
            ApplicationStatus.Accepted => "bg-success",
            ApplicationStatus.Rejected => "bg-danger",
            _ => ""
        };
    }

    private void BeginReview(JobApplication app)
    {
        reviewing = app.Id;
        reviewStatus = app.Status;
        reviewNotes = app.ReviewerNotes;
    }

    private async Task SaveReviewAsync()
    {
        if (reviewing is null)
            return;

        await AppSvc.ReviewAsync(reviewing.Value, reviewStatus, reviewNotes);
        reviewing = null;
        await LoadAsync();
    }

    private void ConfirmWithdraw(JobApplication app)
    {
        withdrawTarget = app;
    }

    private async Task WithdrawConfirmedAsync()
    {
        if (withdrawTarget is null)
            return;

        await AppSvc.WithdrawAsync(withdrawTarget.Id);
        withdrawTarget = null;

        await LoadAsync();

        // Smart reload: If you withdraw the last app on page 3, drop back to page 2
        if (pagedApps?.Count == 0 && currentPage > 1)
        {
            currentPage--;
            await LoadAsync();
        }
    }

    private void SetView(string mode) { viewMode = mode; }

    private void StartDrag(int appId) { draggingAppId = appId; }

    private async Task DropOnColumn(ApplicationStatus newStatus)
    {
        if (draggingAppId is null) return;
        await AppSvc.ReviewAsync(draggingAppId.Value, newStatus, null);
        draggingAppId = null;
        await LoadAsync();
    }
}







