@page "/invite/{Token}/register"
@using System.Text
@using HrPlatform.Data.Entities
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer

@inject IInvitationService InvitationService
@inject IJobInvitationService JobInvitationService
@inject IDriverProfileService ProfileService
@inject ICompanyService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IEmailService RealEmailService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Complete Registration</PageTitle>

<div>
    @if (_loading)
    {
        <div class="d-flex align-items-center justify-content-center" style="height: 100vh;">
            <div class="spinner-border text-primary" role="status"></div>
            <span class="ms-3 text-muted">Loading your invitation...</span>
        </div>
    }
    else if (_tokenInvalid)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="alert alert-danger shadow-sm border-0 d-inline-block">
                <strong><i class="bi bi-x-circle-fill me-2"></i> Invalid Invitation</strong>
                <p class="mb-0 mt-2">This invitation link is invalid or has already been used.</p>
            </div>
        </div>
    }
    else if (_success)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
            <div class="card shadow-sm border-0 text-center" style="max-width: 500px;">
                <div class="card-body p-5">
                    <i class="bi bi-check-circle-fill text-primary" style="font-size: 4rem;"></i>
                    <h2 class="mt-4 mb-3 fw-bold text-dark">Welcome to CDL Pool!</h2>
                    <p class="text-secondary mb-4">Your account has been created successfully. We've sent an email to <strong>@_profile.Email</strong>
                        with instructions to set your password and log in.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-5 overflow-hidden">
            <div class="row g-0">
                <!-- Sidebar Progress -->
                <div class="col-lg-3 p-4 d-lg-block" style="background-color: var(--bg-card);" id="sidebar-progress">
                    <div class="mb-4">
                        <h4 class="fw-bold mb-4 d-none d-lg-block">
                            @if (RoleConstants.Admin.Equals(_invitation?.Role, StringComparison.OrdinalIgnoreCase))
                            {
                                <text>Admin Registration</text>
                            }
                            else if (RoleConstants.Manager.Equals(_invitation?.Role, StringComparison.OrdinalIgnoreCase))
                            {
                                <text>Manager Registration</text>
                            }
                            else
                            {
                                <text>Driver Registration</text>
                            }
                        </h4>
                        @if (_companyName != null && _isManager)
                        {
                            <div class="alert alert-info py-2 px-3 mb-4 shadow-sm border-0 small d-none d-lg-block">
                                Joining: <strong>@_companyName</strong>
                            </div>
                        }

                        @if (!_isManager)
                        {
                            <h5 class="text-secondary fw-bold text-uppercase mb-2 d-none d-lg-block" style="font-size: 0.8rem; letter-spacing: 1px;">Application Progress</h5>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="text-muted fw-medium">@(activeTab * 100 / (tabs.Length - 1))% Complete</small>
                            </div>
                            <div class="progress mb-4 mb-lg-4" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                                <div class="progress-bar bg-primary"
                                     style="width: @(activeTab * 100 / (tabs.Length - 1))%; transition: width 0.3s ease;"></div>
                            </div>
                        }

                        <ul class="nav flex-column gap-3 wizard-steps d-none d-lg-flex">
                            @foreach (var (label, index) in tabs.Select((l, i) => (l, i)))
                            {
                                var locked = index > maxReachedTab;
                                var completed = index < maxReachedTab;
                                var active = activeTab == index;

                                <li class="nav-item">
                                    <button type="button"
                                            class="nav-link text-start w-100 p-0 d-flex align-items-center @(active ? "active-step" : "inactive-step") @(locked ? "disabled opacity-50" : "")"
                                            @onclick="() => ActivateTab(index)"
                                            disabled="@locked"
                                            style="background: transparent; border: none;">
                                        <div
                                            class="step-circle @(active ? "active-circle" : completed ? "completed-circle" : "inactive-circle") me-3 d-flex justify-content-center align-items-center rounded-circle"
                                            style="width: 24px; height: 24px; font-size: 0.75rem;">
                                            @if (completed)
                                            {
                                                <i class="bi bi-check"></i>
                                            }
                                            else
                                            {
                                                <span>@(index + 1)</span>
                                            }
                                        </div>
                                        <span style="font-size: 0.9rem;">@label</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <!-- Main Content Area -->
                <div class="col-lg-9 d-flex flex-column" style="background-color: var(--bg-card); color: var(--text-primary);">
                    <EditForm EditContext="editContext" class="d-flex flex-column">
                        <DataAnnotationsValidator/>

                        <!-- Top Bar -->
                        <div class="px-3 px-md-5 py-3 py-md-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom gap-3"
                             style="border-color: var(--border-color) !important;">
                            <!-- Desktop Title -->
                            <h4 class="mb-0 fw-bold text-uppercase d-none d-lg-flex align-items-center">
                                <span class="text-primary me-2">@(activeTab + 1).</span> @tabs[activeTab]
                            </h4>
                            
                            <!-- Mobile Dropdown Navigation -->
                            <div class="d-lg-none w-100 flex-grow-1 me-sm-3">
                                <select class="form-select bg-light fw-bold text-uppercase" style="border-color: var(--border-color);" value="@activeTab" @onchange="MobileTabSelected">
                                    @for (int i = 0; i < tabs.Length; i++)
                                    {
                                        <option value="@i" disabled="@(i > maxReachedTab)">@(i + 1). @tabs[i]</option>
                                    }
                                </select>
                            </div>
                            <div class="d-none d-sm-flex gap-2 gap-sm-3 align-items-center flex-wrap">
                                @if (activeTab > 0)
                                {
                                    <button type="button" class="btn btn-outline-secondary px-3 px-md-4" @onclick="GoPrevious">
                                        <i class="bi bi-arrow-left d-none d-sm-inline me-2"></i><i class="bi bi-arrow-left d-inline d-sm-none"></i> <span class="d-none d-sm-inline">Previous</span>
                                    </button>
                                }

                                @if (activeTab < tabs.Length - 1)
                                {
                                    <button type="button" class="btn btn-primary px-3 px-md-4 fw-medium" @onclick="SaveAndContinue">
                                        <span class="d-none d-sm-inline">Continue</span><span class="d-inline d-sm-none">Next</span> <i class="bi bi-arrow-right ms-1 ms-sm-2"></i>
                                    </button>
                                }
                                else if (activeTab == tabs.Length - 1)
                                {
                                    <button type="button" class="btn btn-primary px-3 px-md-5 fw-bold" @onclick="SubmitRegistrationAsync"
                                            disabled="@_isSubmitting">
                                        @if (_isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        <span class="d-none d-sm-inline">Complete Registration</span><span class="d-inline d-sm-none">Submit</span> <i class="bi bi-check-circle ms-1 ms-sm-2"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="px-3 px-md-5 py-3 py-md-4">
                            <ValidationSummary class="text-danger mb-4"/>

                            <div class="@(activeTab == 0 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfilePersonalForm Profile="_profile" IsReadOnly="false"
                                                                                               IsManager="_isManager"/>
                            </div>
                            @if (!_isManager)
                            {
                                <div class="@(activeTab == 1 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileLicenseForm Profile="_profile" IsReadOnly="false"/>
                                </div>
                                <div class="@(activeTab == 2 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileDrivingStatsForm Profile="_profile" IsReadOnly="false"/>
                                </div>
                                <div class="@(activeTab == 3 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileEmploymentForm Profile="_profile" IsReadOnly="false"/>
                                </div>
                                <div class="@(activeTab == 4 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileSafetyForm Profile="_profile" IsReadOnly="false"/>
                                </div>
                                <div class="@(activeTab == 5 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfilePreferencesForm Profile="_profile" IsReadOnly="false"/>
                                </div>
                                <div class="@(activeTab == 6 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileEducationForm Profile="_profile" IsReadOnly="false"/>
                                </div>
                                <div class="@(activeTab == 7 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileDocumentsForm Profile="_profile" IsReadOnly="false"/>
                                </div>
                                <div class="@(activeTab == 8 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileConsentsForm Profile="_profile" IsReadOnly="false"/>
                                </div>
                                <div class="@(activeTab == 9 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileReviewForm Profile="_profile"/>
                                </div>
                            }
                        </div>

                        <!-- Mobile Bottom Navigation -->
                        <div class="d-flex d-sm-none justify-content-between align-items-center p-3 border-top mt-auto" style="border-color: var(--border-color) !important;">
                            <div></div> <!-- spacer for justify-between if no cancel button -->
                            <div class="d-flex gap-2">
                                @if (activeTab > 0)
                                {
                                    <button type="button" class="btn btn-outline-secondary" @onclick="GoPrevious">
                                        <i class="bi bi-arrow-left"></i>
                                    </button>
                                }
                                @if (activeTab < tabs.Length - 1)
                                {
                                    <button type="button" class="btn btn-primary fw-medium" @onclick="SaveAndContinue">
                                        Next <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                }
                                else if (activeTab == tabs.Length - 1)
                                {
                                    <button type="button" class="btn btn-primary fw-bold" @onclick="SubmitRegistrationAsync" disabled="@_isSubmitting">
                                        @if (_isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        Submit <i class="bi bi-check-circle ms-1"></i>
                                    </button>
                                }
                            </div>
                        </div>

                    </EditForm>
                </div>
            </div>
        </div>

        <style>
            .wizard-steps .active-step {
                color: var(--text-primary);
                font-weight: 600;
            }

            .wizard-steps .inactive-step {
                color: var(--text-secondary);
            }

            .wizard-steps .inactive-step:hover:not(.disabled) {
                color: var(--text-primary);
            }

            .step-circle {
                border: 1px solid var(--border-color);
            }

            .active-circle {
                background-color: var(--accent-primary);
                border-color: var(--accent-primary);
                color: #000;
            }

            .completed-circle {
                background-color: transparent;
                border-color: var(--text-secondary);
                color: var(--text-secondary);
            }

            .inactive-circle {
                background-color: transparent;
                color: var(--text-secondary);
            }
            
            /* Sidebar: bottom border on mobile, right border on desktop */
            #sidebar-progress {
                border-bottom: 1px solid var(--border-color);
            }
            @@media (min-width: 992px) {
                #sidebar-progress {
                    border-bottom: none;
                    border-right: 1px solid var(--border-color);
                }
            }
        </style>

        <!-- Error Modal -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(5px);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg" style="background-color: var(--bg-card); color: var(--text-color);">
                        <div class="modal-header border-bottom border-danger">
                            <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Error</h5>
                        </div>
                        <div class="modal-body p-4 fs-5 text-center">
                            @errorMessage
                        </div>
                        <div class="modal-footer border-0 d-flex justify-content-center">
                            <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="() => errorMessage = null">Got it</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _tokenInvalid;
    private bool _success;
    private bool _isSubmitting;

    private Invitation? _invitation;
    private bool _isManager;
    private string? _companyName;

    private DriverProfile _profile = new();
    private EditContext editContext = default!;

    private string? errorMessage;
    private int activeTab;
    private int maxReachedTab;

    private string[] tabs = Array.Empty<string>();

    private static readonly string[] driverTabs =
        ["Personal Information", "CDL License & Medical", "Driving Experience", "Employment History", "Safety History", "Preferences", "Education", "Other Documents", "Consents & Authorizations", "Review & Submit"];

    private static readonly string[] managerTabs = ["Personal Information"];

    protected override async Task OnInitializedAsync()
    {
        _invitation = await InvitationService.GetValidAsync(Token);

        if (_invitation is null)
        {
            _tokenInvalid = true;
        }
        else
        {
            _isManager = RoleConstants.Manager.Equals(_invitation.Role, StringComparison.OrdinalIgnoreCase) ||
                         RoleConstants.Admin.Equals(_invitation.Role, StringComparison.OrdinalIgnoreCase);
            tabs = _isManager ? managerTabs : driverTabs;

            if (_invitation.CompanyId.HasValue)
            {
                var company = await CompanyService.GetByIdAsync(_invitation.CompanyId.Value);
                _companyName = company?.Name;
            }
            else
            {
                _companyName = "CDL Pool Group";
            }

            _profile = new DriverProfile
            {
                UserId = "temp-user-id", // Satisfies [Required] validation before actual user is created
                DateOfBirth = DateOnly.FromDateTime(DateTime.Today),
                Email = _invitation.Email ?? string.Empty,
                PhoneNumber = _invitation.Phone ?? string.Empty
            };

            editContext = new EditContext(_profile);
        }

        _loading = false;
    }

    private void MobileTabSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int index))
        {
            ActivateTab(index);
        }
    }

    private void ActivateTab(int index)
    {
        errorMessage = null;
        if (index > maxReachedTab) return;

        if (!_isManager && activeTab == 1 && index > activeTab && (!_profile.Documents.Any(d => d.DocumentType == "CDL License") || !_profile.Documents.Any(d => d.DocumentType == "Medical Card")))
        {
            errorMessage = "CDL License and DOT Medical Card documents are required before proceeding.";
            return;
        }

        if (!_isManager && activeTab == 3 && index > activeTab && !_profile.EmploymentHistory.Any())
        {
            errorMessage = "Please list your last 3 years of employment history (at least 1 record required) before proceeding.";
            return;
        }

        activeTab = index;
        _ = JS.InvokeVoidAsync("window.scrollTo", 0, 0);
    }

    private void GoPrevious()
    {
        if (activeTab > 0)
        {
            activeTab--;
            _ = JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
    }

    private void SaveAndContinue()
    {
        errorMessage = null;

        if (!_isManager && activeTab == 1 && (!_profile.Documents.Any(d => d.DocumentType == "CDL License") || !_profile.Documents.Any(d => d.DocumentType == "Medical Card")))
        {
            errorMessage = "CDL License and DOT Medical Card documents are required before proceeding.";
            return;
        }

        if (!_isManager && activeTab == 3 && !_profile.EmploymentHistory.Any())
        {
            errorMessage = "Please list your last 3 years of employment history (at least 1 record required) before proceeding.";
            return;
        }

        if (ValidateProfileSafe())
        {
            if (activeTab < tabs.Length - 1)
            {
                var nextTab = activeTab + 1;
                if (nextTab > maxReachedTab) maxReachedTab = nextTab;
                activeTab++;
                _ = JS.InvokeVoidAsync("window.scrollTo", 0, 0);
            }
        }
        else
        {
            errorMessage = "Validation failed. Please fill in all required fields.";
        }
    }

    private bool ValidateProfileSafe()
    {
        var tempLicense = _profile.License;
        if (tempLicense != null && tempLicense.Id == 0 && string.IsNullOrWhiteSpace(tempLicense.LicenseNumber))
            _profile.License = null;

        var tempMedical = _profile.MedicalCard;
        if (tempMedical != null && tempMedical.Id == 0 && tempMedical.SelfCertification == null && string.IsNullOrWhiteSpace(tempMedical.MedicalExaminerName))
            _profile.MedicalCard = null;

        var isValid = editContext.Validate();

        foreach (var edu in _profile.Educations)
        {
            if (string.IsNullOrWhiteSpace(edu.SchoolName) ||
                string.IsNullOrWhiteSpace(edu.City) ||
                string.IsNullOrWhiteSpace(edu.State) ||
                edu.Level == null)
            {
                isValid = false;
                if (string.IsNullOrWhiteSpace(errorMessage))
                {
                    errorMessage = "Please complete all required fields for your Education records.";
                }
            }
        }

        foreach (var emp in _profile.EmploymentHistory)
        {
            if (string.IsNullOrWhiteSpace(emp.JobTitle) || string.IsNullOrWhiteSpace(emp.CompanyName))
            {
                isValid = false;
                if (string.IsNullOrWhiteSpace(errorMessage))
                {
                    errorMessage = "Please complete all required fields (Company Name, Job Title) for your added Employment records.";
                }
            }
        }

        _profile.License = tempLicense;
        _profile.MedicalCard = tempMedical;

        if (_isManager)
        {
            if (string.IsNullOrWhiteSpace(_profile.FirstName) || string.IsNullOrWhiteSpace(_profile.LastName) ||
                string.IsNullOrWhiteSpace(_profile.Email) || string.IsNullOrWhiteSpace(_profile.PhoneNumber))
            {
                isValid = false;
            }
        }

        return isValid;
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }

        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private async Task SubmitRegistrationAsync()
    {
        errorMessage = null;

        if (!_isManager)
        {
            if (_profile.License == null || string.IsNullOrWhiteSpace(_profile.License.LicenseNumber))
            {
                errorMessage = "CDL License details are required before submitting.";
                return;
            }
            if (_profile.MedicalCard == null || string.IsNullOrWhiteSpace(_profile.MedicalCard.MedicalExaminerName))
            {
                errorMessage = "DOT Medical Card details are required before submitting.";
                return;
            }
            if (!_profile.Documents.Any(d => d.DocumentType == "CDL License") || !_profile.Documents.Any(d => d.DocumentType == "Medical Card"))
            {
                errorMessage = "CDL License and DOT Medical Card documents are required before submitting.";
                return;
            }
            if (!_profile.EmploymentHistory.Any())
            {
                errorMessage = "Please list your last 3 years of employment history (at least 1 record required) before submitting.";
                return;
            }
            if (!(_profile.ConsentMVR && _profile.ConsentClearinghouse && _profile.ConsentPSP && _profile.ConsentEmployment))
            {
                errorMessage = "All background check consents must be signed before submitting.";
                return;
            }
            if (string.IsNullOrWhiteSpace(_profile.ElectronicSignatureName))
            {
                errorMessage = "Electronic signature is required before submitting.";
                return;
            }
        }

        if (!ValidateProfileSafe())
        {
            errorMessage = "Please ensure all required fields are filled correctly.";
            return;
        }

        _isSubmitting = true;

        try
        {
            var user = new ApplicationUser
            {
                FirstName = _profile.FirstName.Trim(),
                LastName = _profile.LastName.Trim(),
                PhoneNumber = _profile.PhoneNumber,
                EmailConfirmed = true
            };

            if (_isManager)
            {
                user.CompanyId = _invitation!.CompanyId;
            }

            await UserStore.SetUserNameAsync(user, _profile.Email.Trim(), CancellationToken.None);
            var emailStore = GetEmailStore();
            await emailStore.SetEmailAsync(user, _profile.Email.Trim(), CancellationToken.None);

            var dummyPassword = Guid.NewGuid().ToString("N").Substring(0, 12) + "A1!";
            var result = await UserManager.CreateAsync(user, dummyPassword);

            if (!result.Succeeded)
            {
                errorMessage = $"Failed to create user: {string.Join(", ", result.Errors.Select(e => e.Description))}";
                _isSubmitting = false;
                return;
            }

            var roleToAssign = _invitation!.Role;
            await UserManager.AddToRoleAsync(user, roleToAssign);

            if (!_isManager)
            {
                _profile.IsApplicationCompleted = true;
                _profile.LastWizardStep = tabs.Length - 1;
                _profile.UserId = user.Id;

                if (_profile.License != null && string.IsNullOrWhiteSpace(_profile.License.LicenseNumber)) _profile.License = null;
                if (_profile.MedicalCard != null && string.IsNullOrWhiteSpace(_profile.MedicalCard.MedicalExaminerName)) _profile.MedicalCard = null;

                foreach (var doc in _profile.Documents)
                {
                    doc.IsUnsaved = false;
                }

                try
                {
                    await ProfileService.CreateAsync(_profile);
                }
                catch (Exception profileEx)
                {
                    // Profile creation failed — roll back the user to prevent orphaned accounts.
                    // Without a profile, the user would be redirected to /profiles/new on login
                    // with all their wizard data lost.
                    await UserManager.DeleteAsync(user);
                    throw new InvalidOperationException(
                        $"Failed to create driver profile. Your account was not created. Please try again. Details: {profileEx.Message}", profileEx);
                }

                if (_invitation!.JobId.HasValue)
                {
                    await JobInvitationService.CreateFromRegistrationAsync(user.Id, _invitation.JobId.Value);
                }
            }

            _invitation!.IsUsed = true;
            await InvitationService.MarkUsedAsync(Token);
            await InvitationService.MarkAllAsUsedByEmailAsync(_profile.Email);

            var code = await UserManager.GeneratePasswordResetTokenAsync(user);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var callbackUrl = Nav.GetUriWithQueryParameters(
                Nav.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
                new Dictionary<string, object?> { ["code"] = code, ["email"] = _profile.Email });

            var subject = "Welcome to CDL Pool! Set your password";
            var emailHtml = $@"
<div style='font-family: Arial, sans-serif; color: #333; max-width: 600px; margin: 0 auto; border: 1px solid #e9ecef; border-radius: 8px; overflow: hidden;'>
    <div style='background-color: #0d6efd; color: #fff; padding: 20px; text-align: center;'>
        <h2 style='margin: 0;'>Welcome to CDL Pool!</h2>
    </div>
    <div style='padding: 30px;'>
        <p style='font-size: 16px;'>Hi {user.FirstName},</p>
        <p style='font-size: 16px;'>Your account has been successfully created. To complete your setup and log in, please set your password by clicking the button below:</p>
        <div style='text-align: center; margin: 30px 0;'>
            <a href='{callbackUrl}' style='background-color: #0d6efd; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold; font-size: 16px; display: inline-block;'>Set Your Password</a>
        </div>
        <p style='font-size: 14px; color: #6c757d;'>If the button doesn't work, copy and paste this link into your browser:<br/>
        <a href='{callbackUrl}' style='color: #0d6efd; word-break: break-all;'>{callbackUrl}</a></p>
    </div>
    <div style='background-color: #f8f9fa; padding: 15px; text-align: center; font-size: 12px; color: #6c757d;'>
        <p style='margin: 0;'>&copy; {DateTime.Now.Year} CDL Pool Group. All rights reserved.</p>
    </div>
</div>";

            await RealEmailService.SendEmailAsync(_profile.Email, null, subject, emailHtml);

            _success = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred during registration: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

}
