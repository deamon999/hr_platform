@page "/profiles"
@using System.Security.Claims
@using HrPlatform.Models
@using HrPlatform.Utils
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject IDriverProfileService ProfileSvc
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@inject ICompanyService CompanyService
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>Driver Profiles</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h2 class="mb-0">Driver Profiles</h2>
    @if (isAdmin)
    {
        <span class="badge bg-danger">Platform Admin — all profiles</span>
    }
    else
    {
        <span class="badge bg-primary">@companyName — applicants only</span>
    }
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <select class="form-select form-select-sm w-auto" style="min-width: 160px;"
                @bind="searchAvailString" @bind:after="ResetPageAndLoad">
            <option value="">Any Availability</option>
            @foreach (var s in Enum.GetValues<AvailabilityStatus>())
            {
                <option value="@s.ToString()">@s.GetDescriptionValue()</option>
            }
        </select>
        <DebounceInput class="form-control form-control-sm"
                       style="max-width:200px"
                       placeholder="Search name..."
                       @bind-Value="searchName"
                       @bind-Value:after="ResetPageAndLoad"/>
        <select class="form-select form-select-sm w-auto" style="min-width: 160px;"
                @bind="searchCdlString" @bind:after="ResetPageAndLoad">
            <option value="">Any CDL class</option>
            @foreach (var c in Enum.GetValues<CdlClass>())
            {
                <option value="@c.ToString()">@c.GetDescriptionValue()</option>
            }
        </select>
        <select class="form-select form-select-sm w-auto" style="min-width: 180px;"
                @bind="searchEndString" @bind:after="ResetPageAndLoad">
            <option value="">Any endorsement</option>
            @foreach (var e in Enum.GetValues<CdlEndorsement>())
            {
                <option value="@e.ToString()">@e.GetDescriptionValue()</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
    </div>
    
    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
        <select class="form-select form-select-sm border-0 bg-white shadow-sm" style="width: 70px;" @bind="PageSize" @bind:after="ResetPageAndLoad">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (pagedProfiles is null)
{
    <p>Loading...</p>
}
else if (!pagedProfiles.Items.Any())
{
    <div class="alert alert-info">
        @(isAdmin ? "No profiles exist yet." : "No drivers have applied to your company's jobs yet.")
    </div>
}
else
{
    <div>
        <div class="row g-3">
            @foreach (var p in pagedProfiles.Items)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 bg-white h-100 app-card">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <div class="d-flex align-items-center mb-2 gap-2">
                                        <h4 class="fw-bold mb-0 text-dark">@p.LastName, @p.FirstName</h4>
                                        @if (p.License is not null)
                                        {
                                            <span class="badge bg-dark rounded-pill">CDL-@p.License.Class</span>
                                        }
                                    </div>
                                    
                                    <div class="mb-3 text-secondary small">
                                        <div class="d-flex align-items-center gap-3 mb-1">
                                            <span><i class="bi bi-envelope"></i> @p.Email</span>
                                            @if (!string.IsNullOrEmpty(p.PhoneNumber))
                                            {
                                                <span><i class="bi bi-telephone"></i> @p.PhoneNumber</span>
                                            }
                                        </div>
                                        @if (p.License is not null)
                                        {
                                            <div class="text-muted"><i class="bi bi-card-heading"></i> License #: @p.License.LicenseNumber</div>
                                        }
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 text-secondary small">

                                        <span class="badge bg-light text-dark rounded-pill px-3 py-2 border"><i class="bi bi-briefcase me-1"></i> @p.YearsOfExperience yrs exp</span>
                                        <span class="badge bg-light text-dark rounded-pill px-3 py-2 border"><i class="bi bi-file-earmark-text me-1"></i> @(p.User?.Applications?.Count ?? 0) Apps</span>
                                    </div>
                                </div>
                                
                                <div class="col-md-5 d-flex gap-2 justify-content-md-end align-items-end flex-wrap mt-3 mt-md-0">
                                    <button class="btn btn-primary px-4" @onclick="() => GoToView(p.Id)">View Profile</button>
                                    @if (p.UserId == currentUserId)
                                    {
                                        <button class="btn btn-outline-secondary" @onclick="() => GoToEdit(p.Id)">Edit</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .app-card {
                transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            }
            .app-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
            }
        </style>

        @if (totalPages > 1)
        {
            <nav aria-label="Profile list pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageIndex = i;
                        <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@code {
    private PaginationResult<DriverProfile>? pagedProfiles;
    private bool isAdmin;
    private string? companyName = string.Empty;
    private string? currentUserId;

    // Filter by Status
    private ProfileSearch profileSearch = new();

    [SupplyParameterFromQuery(Name = "q")]
    public string? searchName { get; set; }

    [SupplyParameterFromQuery(Name = "avail")]
    public string? searchAvailString { get; set; }

    [SupplyParameterFromQuery(Name = "cdl")]
    public string? searchCdlString { get; set; }

    [SupplyParameterFromQuery(Name = "end")]
    public string? searchEndString { get; set; }

    // Pagination State
    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 10;

    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        isAdmin = auth.User.IsInRole(RoleConstants.Admin);
        currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;

        await LoadAsync();
    }

    // Helper to reset to page 1 when filtering/sorting changes
    private async Task ResetPageAndLoad()
    {
        currentPage = 1;
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = null,
            ["size"] = PageSize == 10 ? null : PageSize,
            ["q"] = string.IsNullOrWhiteSpace(searchName) ? null : searchName,
            ["avail"] = string.IsNullOrWhiteSpace(searchAvailString) ? null : searchAvailString,
            ["cdl"] = string.IsNullOrWhiteSpace(searchCdlString) ? null : searchCdlString,
            ["end"] = string.IsNullOrWhiteSpace(searchEndString) ? null : searchEndString
        });
        await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", uri);
        await LoadAsync();
    }

    private void ClearFilters()
    {
        searchName = null;
        searchAvailString = null;
        searchCdlString = null;
        searchEndString = null;
        _ = ResetPageAndLoad();
    }

    private async Task LoadAsync()
    {
        profileSearch.Name = searchName;
        if (Enum.TryParse<AvailabilityStatus>(searchAvailString, out var a)) profileSearch.Availability = a; else profileSearch.Availability = null;
        if (Enum.TryParse<CdlClass>(searchCdlString, out var c)) profileSearch.CdlClass = c; else profileSearch.CdlClass = null;
        if (Enum.TryParse<CdlEndorsement>(searchEndString, out var e)) profileSearch.RequiredEndorsement = e; else profileSearch.RequiredEndorsement = null;

        // NOTE: You may need to pass 'sortBy' into your ProfileSvc methods if you want it to actually sort in the DB.
        if (isAdmin)
        {
            pagedProfiles = await ProfileSvc.GetAllPagedAsync(profileSearch, currentPage, PageSize);
        }
        else
        {
            if (currentUserId == null)
            {
                pagedProfiles = new PaginationResult<DriverProfile>
                {
                    Items = new List<DriverProfile>(),
                    TotalCount = 0,
                    PageNumber = 0,
                    PageSize = 0
                };
            }
            else
            {
                var auth = await AuthState.GetAuthenticationStateAsync();
                var companyClaim = auth.User.FindFirst("companyId")?.Value;
                int? companyId = null;
                if (int.TryParse(companyClaim, out var cid))
                {
                    companyId = cid;
                    var comp = await CompanyService.GetByIdAsync(cid);
                    if (comp != null)
                    {
                        companyName = comp.Name;
                    }
                }
                
                pagedProfiles = companyId.HasValue
                    ? await ProfileSvc.GetByCompanyPagedAsync(profileSearch, companyId.Value, currentPage, PageSize)
                    : new PaginationResult<DriverProfile>
                    {
                        Items = new List<DriverProfile>(),
                        TotalCount = 0,
                        PageNumber = 0,
                        PageSize = 0
                    };
            }
        }

        // Calculate Pages
        if (pagedProfiles != null)
        {
            totalPages = pagedProfiles.TotalPages;
        }

        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = page,
            ["size"] = PageSize,
            ["q"] = string.IsNullOrWhiteSpace(searchName) ? null : searchName,
            ["avail"] = searchAvailString,
            ["cdl"] = searchCdlString,
            ["end"] = searchEndString
        });
        Nav.NavigateTo(uri);
    }

    private void GoToView(int id)
    {
        Nav.NavigateTo($"/profiles/{id}");
    }

    private void GoToEdit(int id)
    {
        Nav.NavigateTo($"/profiles/edit/{id}");
    }

}

