@page "/profiles"
@using System.Security.Claims
@using HrPlatform.Models
@using HrPlatform.Utils
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject IDriverProfileService ProfileSvc
@inject AuthenticationStateProvider AuthState
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav

<PageTitle>Driver Profiles</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Driver Profiles</h2>
    @if (isAdmin)
    {
        <span class="badge bg-danger">Platform Admin — all profiles</span>
    }
    else
    {
        <span class="badge bg-primary">@companyName — applicants only</span>
    }
</div>


<div class="d-flex flex-wrap gap-3 mb-3 align-items-center">
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0">Availability:</label>
        <select class="form-select form-select-sm w-auto"
                @bind="availFilter" @bind:after="ResetPageAndLoad">
            <option value="">All</option>
            @foreach (var s in Enum.GetValues<AvailabilityStatus>())
            {
                <option value="@s">@s.GetDescriptionValue()</option>
            }
        </select>
    </div>
</div>

@if (pagedProfiles is null)
{
    <p>Loading...</p>
}
else if (!pagedProfiles.Items.Any())
{
    <div class="alert alert-info">
        @(isAdmin ? "No profiles exist yet." : "No drivers have applied to your company's jobs yet.")
    </div>
}
else
{
    <div>
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Contact</th>
                    <th>CDL</th>
                    <th>Availability</th>
                    <th>Experience</th>
                    <th>Applications</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var p in pagedProfiles.Items)
                {
                    <tr>
                        <td><strong>@p.LastName, @p.FirstName</strong></td>
                        <td>
                            @p.Email<br/>
                            <small class="text-muted">@p.PhoneNumber</small>
                        </td>
                        <td>
                            @if (p.License is not null)
                            {
                                <span class="badge bg-dark">CDL-@p.License.Class</span>
                                <small class="ms-1">@p.License.LicenseNumber</small>
                            }
                        </td>
                        <td>
                            @{
                                var (badge, bg) = p.AvailabilityStatus switch
                                {
                                    AvailabilityStatus.ActivelyLooking => ("Actively looking", "bg-success"),
                                    AvailabilityStatus.OpenToOpportunities => ("Open", "bg-info text-dark"),
                                    _ => ("Not available", "bg-secondary")
                                };
                            }
                            <span class="badge @bg">@badge</span>
                        </td>
                        <td>@p.YearsOfExperience yrs</td>
                        <td>@p.User.Applications.Count</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToView(p.Id)">View</button>
                                @if (p.UserId == currentUserId)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToEdit(p.Id)">Edit
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="d-block d-md-none">
            @foreach (var p in pagedProfiles.Items)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0"><strong>@p.LastName, @p.FirstName</strong></h5>
                            @if (p.License is not null)
                            {
                                <span class="badge bg-dark">CDL-@p.License.Class</span>
                            }
                        </div>

                        <div class="card-text text-muted mb-3">
                            <div class="mb-2">
                                <div>@p.Email</div>
                                <div>@p.PhoneNumber</div>
                            </div>

                            @if (p.License is not null)
                            {
                                <div><strong>License #:</strong> @p.License.LicenseNumber</div>
                            }
                            <div><strong>Availability:</strong>
                                @{
                                    var (badge, bg) = p.AvailabilityStatus switch
                                    {
                                        AvailabilityStatus.ActivelyLooking => ("Actively looking", "bg-success"),
                                        AvailabilityStatus.OpenToOpportunities => ("Open", "bg-info text-dark"),
                                        _ => ("Not available", "bg-secondary")
                                    };
                                }
                                <span class="badge @bg">@badge</span></div>
                            <div><strong>Experience:</strong> @p.YearsOfExperience yrs</div>
                            <div><strong>Applications:</strong> @p.User.Applications.Count</div>
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top">
                            <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => GoToView(p.Id)">
                                View
                            </button>
                            @if (p.UserId == currentUserId)
                            {
                                <button class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => GoToEdit(p.Id)">
                                    Edit
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Profile list pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        var pageIndex = i;
                        <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@code {
    private PaginationResult<DriverProfile>? pagedProfiles;
    private bool isAdmin;
    private string? companyName;
    private string? currentUserId;

    // Filter by Status
    private AvailabilityStatus? availFilter;

    // Pagination State
    private int currentPage = 1;
    private const int PageSize = 10;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        isAdmin = auth.User.IsInRole(RoleConstants.Admin);
        currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        await LoadAsync();
    }

    // Helper to reset to page 1 when filtering/sorting changes
    private async Task ResetPageAndLoad()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // NOTE: You may need to pass 'sortBy' into your ProfileSvc methods if you want it to actually sort in the DB.
        if (isAdmin)
        {
            pagedProfiles = await ProfileSvc.GetAllPagedAsync(availFilter, currentPage, PageSize);
        }
        else
        {
            if (currentUserId == null)
            {
                pagedProfiles = new PaginationResult<DriverProfile>
                {
                    Items = new List<DriverProfile>(),
                    TotalCount = 0,
                    PageNumber = 0,
                    PageSize = 0
                };
            }
            else
            {
                var user = await UserManager.FindByIdAsync(currentUserId);
                var companyId = user?.CompanyId;

                pagedProfiles = companyId.HasValue
                    ? await ProfileSvc.GetByCompanyPagedAsync(availFilter, companyId.Value, currentPage, PageSize)
                    : new PaginationResult<DriverProfile>
                    {
                        Items = new List<DriverProfile>(),
                        TotalCount = 0,
                        PageNumber = 0,
                        PageSize = 0
                    };
            }
        }

        // Calculate Pages
        if (pagedProfiles != null)
        {
            totalPages = pagedProfiles.TotalPages;
        }

        if (totalPages < 1) totalPages = 1;
        if (currentPage > totalPages) currentPage = totalPages;
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadAsync();
    }

    private void GoToView(int id)
    {
        Nav.NavigateTo($"/profiles/{id}");
    }

    private void GoToEdit(int id)
    {
        Nav.NavigateTo($"/profiles/edit/{id}");
    }

}