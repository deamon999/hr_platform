@page "/users"
@rendermode InteractiveServer

@using System.Security.Claims
@using HrPlatform.Models
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject NavigationManager Nav
@inject IAdminUserService UserService
@inject AuthenticationStateProvider AuthState

<PageTitle>Users</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Users</h2>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        Loading users…
    </div>
}
else if (!pagedUsers.Any() && string.IsNullOrEmpty(_searchTerm))
{
    <p>No registered users found.</p>
}
else
{
    <div class="mb-3" style="max-width:320px">
        <input class="form-control"
               placeholder="Search by email or user name or company name"
               value="@_searchTerm"
               @oninput="HandleSearchInput"/>
    </div>

    @if (_statusMessage is not null)
    {
        <div class="alert @_statusClass alert-dismissible mb-3" role="alert">
            @_statusMessage
            <button type="button" class="btn-close"
                    @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <div>
        <div class="table-responsive d-none d-md-block">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Roles Assigned</th>
                    <th>Company Name</th>
                    <th>Confirmed</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var user in pagedUsers)
                {
                    <tr>
                        <td>
                            <strong>@user.Username</strong>
                        </td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                        <td>
                            @if (!string.IsNullOrEmpty(user.Roles))
                            {
                                <span class="badge bg-info">@user.Roles</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Roles</span>
                            }
                        </td>
                        <td>@user.CompanyName</td>
                        <td>
                            @if (user.IsConfirmed)
                            {
                                <span class="text-success fw-bold">✓</span>
                            }
                            else
                            {
                                <span class="text-muted">✗</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToView(user.UserId)">
                                    View
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToEdit(user.UserId)">
                                    Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ConfirmDelete(user)">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="d-block d-md-none">
            @foreach (var user in pagedUsers)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0"><strong>@user.Username</strong></h5>
                            <div>
                                @if (user.IsConfirmed)
                                {
                                    <span class="text-success fw-bold fs-5" title="Confirmed">✓</span>
                                }
                                else
                                {
                                    <span class="text-muted fs-5" title="Not Confirmed">✗</span>
                                }
                            </div>
                        </div>

                        <div class="card-text text-muted mb-2">
                            <div><strong>Email:</strong> @user.Email</div>
                            <div><strong>Phone:</strong> @user.Phone</div>
                            <div><strong>Company:</strong> @user.CompanyName</div>
                        </div>

                        <div class="mb-3">
                            <strong>Roles:</strong>
                            @if (!string.IsNullOrEmpty(user.Roles))
                            {
                                <span class="badge bg-info">@user.Roles</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Roles</span>
                            }
                        </div>

                        <div class="d-flex gap-2 pt-3 border-top">
                            <button class="btn btn-sm btn-outline-primary flex-fill" @onclick="() => GoToView(user.UserId)">
                                View
                            </button>
                            <button class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => GoToEdit(user.UserId)">
                                Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger flex-fill" @onclick="() => ConfirmDelete(user)">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        @if (pagedUsers.Count == 0 && !string.IsNullOrEmpty(_searchTerm))
        {
            <div class="alert alert-info">No users match your search.</div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav aria-label="User list pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@if (deleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>
                        Are you sure you want to permanently delete
                        <strong>@deleteTarget.Username</strong>?
                    </p>
                    <p class="text-muted small mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserViewModel> pagedUsers = new();
    
    // UI State
    private string _searchTerm = string.Empty;
    private string? _statusMessage;
    private string _statusClass = "alert-success";
    private bool isLoading = true;
    private UserViewModel? deleteTarget;
    
    // Auth State
    private bool isAdmin;
    private int? companyId;
    
    // Pagination State
    private int currentPage = 1;
    private const int PageSize = 10;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;

        isAdmin = user.IsInRole(RoleConstants.Admin);

        if (!isAdmin)
        {
            var companyIdClaim = user.FindFirst("companyId")?.Value;

            if (int.TryParse(companyIdClaim, out var parsedCompanyId))
            {
                companyId = parsedCompanyId;
            }
        }

        await LoadAsync(null);
    }

    private async Task LoadAsync(string? searchTerm)
    {
        try
        {
            isLoading = true;

            // 1. Fetch entire accessible roster
            var allUsers = isAdmin
                ? await UserService.GetAllUsersWithRolesAsync()
                : companyId.HasValue
                    ? await UserService.GetUsersByCompanyWithRolesAsync(companyId.Value)
                    : new List<UserViewModel>();

            // 2. Apply Search Filter
            var filteredUsers = allUsers;
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filteredUsers = allUsers.Where(u =>
                        (u.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.Username?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.CompanyName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }

            // 3. Calculate Pages
            totalPages = (int)Math.Ceiling(filteredUsers.Count / (double)PageSize);
            if (totalPages < 1) totalPages = 1;

            if (currentPage > totalPages) currentPage = totalPages; // Safety guard

            // 4. Extract current page slice
            pagedUsers = filteredUsers
                .Skip((currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching users: {ex.Message}");
            _statusMessage = "Error loading users.";
            _statusClass = "alert-danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1; // Always reset to page 1 when typing a new search
        await LoadAsync(_searchTerm);
    }
    
    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadAsync(_searchTerm);
    }

    private void GoToView(string id)
    {
        Nav.NavigateTo($"/users/{id}");
    }

    private void GoToEdit(string id)
    {
        Nav.NavigateTo($"/users/edit/{id}");
    }

    private void ConfirmDelete(UserViewModel? userModel)
    {
        deleteTarget = userModel;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget is null) return;

        await UserService.DeleteAsync(deleteTarget.UserId);
        deleteTarget = null;
        
        // Smart reload: go back one page if we delete the last item on the current page
        await LoadAsync(_searchTerm);
        if (pagedUsers.Count == 0 && currentPage > 1)
        {
            currentPage--;
            await LoadAsync(_searchTerm);
        }
    }
}