@page "/users"
@rendermode InteractiveServer

@using System.Security.Claims
@using HrPlatform.Models
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject NavigationManager Nav
@inject IAdminUserService UserService
@inject AuthenticationStateProvider AuthState

<PageTitle>User Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Users</h2>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        Loading users…
    </div>
}
else if (!users.Any())
{
    <p>No registered users found.</p>
}
else
{
    <div class="mb-3" style="max-width:320px">
        <input class="form-control"
               placeholder="Search by email or user name or company name"
               value="@_searchTerm"
               @oninput="HandleSearchInput"/>
    </div>

    @if (_statusMessage is not null)
    {
        <div class="alert @_statusClass alert-dismissible mb-3" role="alert">
            @_statusMessage
            <button type="button" class="btn-close"
                    @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Roles Assigned</th>
                <th>Company Name</th>
                <th>Confirmed</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>
                        <strong>@user.Username</strong>
                    </td>
                    <td>@user.Email</td>
                    <td>@user.Phone</td>
                    <td>
                        @if (!string.IsNullOrEmpty(user.Roles))
                        {
                            <span class="badge bg-info">@user.Roles</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No Roles</span>
                        }
                    </td>
                    <td>@user.CompanyName</td>
                    <td>
                        @if (user.IsConfirmed)
                        {
                            <span class="text-success fw-bold">✓</span>
                        }
                        else
                        {
                            <span class="text-muted">✗</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToView(user.UserId)">
                                View
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToEdit(user.UserId)">
                                Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    @onclick="() => ConfirmDelete(user)">
                                Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (deleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>
                        Are you sure you want to permanently delete
                        <strong>@deleteTarget.Username</strong>?
                    </p>
                    <p class="text-muted small mb-0">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserViewModel> users = new();
    private string _searchTerm = string.Empty;
    private string? _statusMessage;
    private string _statusClass = "alert-success";
    private bool isLoading = true;
    private UserViewModel? deleteTarget;
    private bool isAdmin;
    private int? companyId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;

        isAdmin = user.IsInRole(RoleConstants.Admin);

        if (!isAdmin)
        {
            var companyIdClaim = user.FindFirst("companyId")?.Value;

            if (int.TryParse(companyIdClaim, out var parsedCompanyId))
            {
                companyId = parsedCompanyId;
            }
        }

        await LoadAsync(null);
    }

    private async Task LoadAsync(string? searchTerm)
    {
        try
        {
            isLoading = true;

            users = isAdmin
                ? await UserService.GetAllUsersWithRolesAsync()
                : companyId.HasValue
                    ? await UserService.GetUsersByCompanyWithRolesAsync(companyId.Value)
                    : new List<UserViewModel>();

            if (!string.IsNullOrEmpty(searchTerm))
            {
                users = users.Where(u =>
                        string.IsNullOrEmpty(_searchTerm) ||
                        (u.Email?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.Username?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.CompanyName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching users: {ex.Message}");
            _statusMessage = "Error loading users.";
            _statusClass = "alert-danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadAsync(_searchTerm);
    }

    private void GoToView(string id)
    {
        Nav.NavigateTo($"/users/{id}");
    }

    private void GoToEdit(string id)
    {
        Nav.NavigateTo($"/users/edit/{id}");
    }

    private void ConfirmDelete(UserViewModel? userModel)
    {
        deleteTarget = userModel;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget is null)
        {
            return;
        }

        await UserService.DeleteAsync(deleteTarget.UserId);
        deleteTarget = null;
        await LoadAsync(null);
    }
}