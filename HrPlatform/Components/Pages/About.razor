@page "/about"

<PageTitle>About CDL Pool</PageTitle>

<div class="container-fluid py-4 px-4 px-md-5">
    <!-- Hero Section -->
    <div class="row justify-content-center mb-4 text-center">
        <div class="col-lg-10 col-xl-8">
            <img src="/images/logo.png" alt="CDL Pool Logo" style="max-width: 350px; height: auto;" class="mb-2" />
            
            <h1 class="display-4 fw-bold text-white mb-4" style="letter-spacing: -0.02em;">
                The New Generation <span class="text-primary">CDL Platform</span>
            </h1>
            
            <p class="lead text-secondary mx-auto" style="max-width: 700px; line-height: 1.7;">
                <strong>CDL Pool</strong> is a revolutionary platform designed to bridge the gap between commercial drivers and top-tier logistics companies with unified, seamless, and intelligent matching.
            </p>
        </div>
    </div>

    <!-- Value Proposition Cards -->
    <div class="row justify-content-center g-4 mt-2 mb-5">
        
        <!-- Driver Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 p-4 feature-card shadow-sm">
                <div class="card-body">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4 icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--accent-primary)" class="bi bi-person-lines-fill" viewBox="0 0 16 16">
                            <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zM11 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5zm.5 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1h-4zm2 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2zm0 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1h-2z"/>
                        </svg>
                    </div>
                    <h4 class="fw-bold mb-3 text-white">For Drivers</h4>
                    <p class="text-secondary" style="line-height: 1.7; font-size: 1.05rem;">
                        Effortlessly maintain digital profiles, manage certifications, and apply to multiple jobs with a single click. Take full control of your CDL career trajectory.
                    </p>
                </div>
            </div>
        </div>

        <!-- Company Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 p-4 feature-card shadow-sm">
                <div class="card-body">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4 icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--accent-primary)" class="bi bi-buildings" viewBox="0 0 16 16">
                            <path d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022zM6 8.694 1 10.36V15h5V8.694zM7 15h2v-1.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5V15h2V1.309l-7 3.5V15z"/>
                            <path d="M2 11h1v1H2v-1zm2 0h1v1H4v-1zm-2 2h1v1H2v-1zm2 0h1v1H4v-1zm4-4h1v1H8V9zm2 0h1v1h-1V9zm-2 2h1v1H8v-1zm2 0h1v1h-1v-1zm2-2h1v1h-1V9zm0 2h1v1h-1v-1zM8 7h1v1H8V7zm2 0h1v1h-1V7zm2 0h1v1h-1V7zM8 5h1v1H8V5zm2 0h1v1h-1V5zm2 0h1v1h-1V5zm0-2h1v1h-1V3z"/>
                        </svg>
                    </div>
                    <h4 class="fw-bold mb-3 text-white">For Companies</h4>
                    <p class="text-secondary" style="line-height: 1.7; font-size: 1.05rem;">
                        Gain access to a curated pool of verified, highly-qualified drivers. Utilize our advanced skill-matching algorithms to find the perfect fit for your fleet.
                    </p>
                </div>
            </div>
        </div>

        <!-- Mission Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 p-4 feature-card shadow-sm">
                <div class="card-body">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4 icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="var(--accent-primary)" class="bi bi-shield-check" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
                            <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                        </svg>
                    </div>
                    <h4 class="fw-bold mb-3 text-white">Our Mission</h4>
                    <p class="text-secondary" style="line-height: 1.7; font-size: 1.05rem;">
                        We believe in empowering the trucking industry through technology, transparency, and trust. Simplifying the hiring and application process for everyone.
                    </p>
                </div>
            </div>
        </div>
        
    </div>
</div>
