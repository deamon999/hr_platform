@page "/users/new"
@page "/users/{Id}"
@page "/users/edit/{Id}"
@using HrPlatform.Models
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject ICompanyService CompanySvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject AdminUserService UserService

<h2>User Management</h2>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (IsViewMode)
{
    <h3>View User</h3>
    <div class="card">
        <div class="card-body">
            <p><strong>Username:</strong> @model?.Username</p>
            <p><strong>Email:</strong> @model?.Email</p>
            <p><strong>Role:</strong> @model?.Roles</p>
            <p><strong>Company ID:</strong> @model?.CompanyId</p>
        </div>
    </div>
    <button class="btn btn-outline-secondary" type="button" @onclick="GoToUsers">Back</button>
}
else if (IsEditMode)
{
    <h3>Edit User: </h3>
    <EditForm Model="model" OnValidSubmit="UpdateAsync">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <div class="mb-3">
            <label class="form-label">Email *</label>
            <InputText class="form-control" @bind-Value="model.Email"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Password *</label>
            <InputText class="form-control" type="password" @bind-Value="model.Password"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Role</label>
            <InputSelect class="form-select" @bind-Value="model.Roles">
                @foreach (var r in roles)
                {
                    <option value="@r">@r</option>
                }
            </InputSelect>
        </div>

        @if (isAdmin)
        {
            <div class="mb-3">
                <label class="form-label">Company</label>
                <InputSelect class="form-select" @bind-Value="model.CompanyId">
                    <option value="">— none —</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Company</label>
                <div>@(myCompany?.Name ?? "(none)")</div>
            </div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save User</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="GoToUsers">Back</button>
        </div>
    </EditForm>
}
else
{
    <EditForm Model="model" OnValidSubmit="CreateAsync">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <div class="mb-3">
            <label class="form-label">Email *</label>
            <InputText class="form-control" @bind-Value="model.Email"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Password *</label>
            <InputText class="form-control" type="password" @bind-Value="model.Password"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Role</label>
            <InputSelect class="form-select" @bind-Value="model.Roles">
                @foreach (var r in roles)
                {
                    <option value="@r">@r</option>
                }
            </InputSelect>
        </div>

        @if (isAdmin)
        {
            <div class="mb-3">
                <label class="form-label">Company</label>
                <InputSelect class="form-select" @bind-Value="model.CompanyId">
                    <option value="">— none —</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Company</label>
                <div>@(myCompany?.Name ?? "(none)")</div>
            </div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Create User</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="GoToUsers">Cancel</button>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success mt-3">@successMessage</div>
        }
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }
    </EditForm>
}

@code {
    [Parameter] public string Id { get; set; }
    private bool isLoading = true;
    private bool IsViewMode = false;
    private bool IsEditMode = false;
    private bool isAdmin = false;

    private Company? myCompany;
    private List<Company>? companies;
    private List<string> roles = new();

    private UserViewModel model = new();
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.IsInRole(RoleConstants.Admin);

        // load roles synchronously from RoleManager (store may not support EF async here)
        roles = [RoleConstants.Manager];

        if (isAdmin)
        {
            companies = await CompanySvc.GetAllAsync();
        }
        else
        {
            // manager: determine their company
            var currentUser = await UserManager.GetUserAsync(user);
            if (currentUser?.CompanyId != null)
            {
                myCompany = await CompanySvc.GetByIdAsync(currentUser.CompanyId.Value);
                model.CompanyId = myCompany?.Id;
            }
        }

        // Check if we are in view or edit mode based on the current route
        var uri = Nav.Uri.ToLower();
        if (uri.Contains("/edit/"))
        {
            IsEditMode = true;
            model = await UserService.GetUserByIdAsync(Id);
        }
        else if (uri.Contains("/view/")) // Assuming /users/{Id:string} maps to /users/view/{Id} or similar, adjusting logic based on context
        {
            // Since the routes are defined as @page "/users/{Id:string}", we use UserId directly for view mode
            IsViewMode = true;
        }
        else
        {
            isLoading = false;
        }
    }

    private void GoToUsers()
    {
        Nav.NavigateTo("/users"); // Assuming /users is a list view if implemented elsewhere
    }

    private async Task CreateAsync()
    {
        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(model.Email) || string.IsNullOrWhiteSpace(model.Password))
        {
            errorMessage = "Email and password are required.";
            return;
        }

        var user = new ApplicationUser
        {
            UserName = model.Email,
            Email = model.Email,
            EmailConfirmed = true,
            CompanyId = model.CompanyId
        };

        var result = await UserManager.CreateAsync(user, model.Password);
        if (!result.Succeeded)
        {
            errorMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            return;
        }

        //TODD split roles by comma and save them one by one
        await UserManager.AddToRoleAsync(user, model.Roles ?? RoleConstants.Driver);

        successMessage = "User created.";
        model = new UserViewModel();
        GoToUsers();
    }

    private async Task UpdateAsync()
    {
        errorMessage = null;

        var user = await UserManager.FindByIdAsync(Id);
        if (user == null)
        {
            errorMessage = "User not found.";
            return;
        }

        // Update user details
        user.Email = model.Email;
        // Password update logic might be needed here if you allow password change, but for simplicity based on original code, we focus on other fields unless explicitly handling password reset flow.

        if (isAdmin)
        {
            user.CompanyId = model.CompanyId ?? user.CompanyId; // Keep existing if null in form submission
        }
        else
        {
            // For non-admins, company ID is usually inherited or managed differently based on context.
            // We use the value submitted from the form.
            user.CompanyId = model.CompanyId ?? user.CompanyId;
        }


        var result = await UserManager.UpdateAsync(user);

        if (!result.Succeeded)
        {
            errorMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            return;
        }

        successMessage = "User updated successfully.";
        GoToUsers();
    }

}