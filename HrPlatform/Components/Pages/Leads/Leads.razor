@page "/leads"
@rendermode InteractiveServer

@using HrPlatform.Data.Entities
@using HrPlatform.Data.Enums
@using HrPlatform.Models
@using HrPlatform.Services
@using HrPlatform.Utils
@using System.Security.Claims

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]

@inject ILeadService LeadService
@inject ICompanyService CompanyService
@inject ILeadNoteService LeadNoteService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>Leads</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Leads</h2>
    <button type="button" class="btn btn-primary px-4" @onclick="OpenAddLeadModal">+ Add Lead</button>
</div>

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div class="d-flex flex-column flex-md-row flex-grow-1 gap-2" style="max-width: 800px;">
        <div class="input-group shadow-sm flex-grow-1">
            <span class="input-group-text bg-dark border-secondary text-secondary"><i class="bi bi-search"></i></span>
            <input class="form-control bg-dark text-light border-secondary border-start-0 ps-0 shadow-none"
                   placeholder="Search..."
                   @bind="_searchTerm"
                   @bind:after="ResetPageAndLoad"
                   disabled="@isLoading" />
        </div>
               
        <select class="form-select shadow-sm bg-dark text-light border-secondary" style="min-width: 140px; max-width: 250px;" @bind="_filterStatusStr" @bind:after="ResetPageAndLoad">
            <option value="">All Statuses</option>
            <option value="Actionable">Actionable</option>
            @foreach (var status in Enum.GetValues<LeadStatus>().Where(s => s != LeadStatus.Contacted && s != LeadStatus.Invited && s != LeadStatus.Converted))
            {
                <option value="@status">@(status.GetDescriptionValue() ?? status.ToString())</option>
            }
        </select>
        
        <select class="form-select shadow-sm bg-dark text-light border-secondary" style="min-width: 140px; max-width: 250px;" @bind="_filterUserId" @bind:after="ResetPageAndLoad">
            <option value="">All Users</option>
            @foreach (var u in _users)
            {
                <option value="@u.Id">@u.Email</option>
            }
        </select>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
        <select class="form-select shadow-sm" style="width: 75px;" @bind="PageSize" @bind:after="ResetPageAndLoad">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        Loading leads…
    </div>
}
else if (!pagedLeads.Any() && string.IsNullOrEmpty(_searchTerm))
{
    <div class="alert alert-info">No leads found in the CRM. Start by adding one!</div>
}
else
{
    <!-- Responsive Card List -->
    <div class="row g-3">
        @foreach (var lead in pagedLeads)
        {
            <div class="col-12">
                <div class="card shadow-sm border bg-dark text-light" style="cursor:pointer; @GetCardStyle(lead.Status)" @onclick="() => OpenLeadDrawer(lead, false)">
                    <div class="card-body p-3 d-flex flex-column flex-lg-row align-items-lg-stretch gap-3">
                        
                        <!-- Col 1: Identity & Mobile Actions -->
                        <div class="d-flex flex-column" style="min-width: 220px;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0">
                                    @lead.FirstName @lead.LastName
                                    @if(IsLeadRegistered(lead))
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success ms-2" style="font-size: 0.65rem; vertical-align: middle;">Registered</span>
                                    }
                                </h5>
                                <div class="d-lg-none" @onclick:stopPropagation="true">
                                    @if (lead.Status != LeadStatus.Hired)
                                    {
                                        <button class="btn btn-sm btn-outline-primary border-0 p-1 me-1" @onclick="() => OpenInviteModal(lead)"><i class="bi bi-envelope-paper"></i></button>
                                    }
                                    <button class="btn btn-sm btn-outline-secondary border-0 p-1 me-1" @onclick="() => OpenLeadDrawer(lead, true)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger border-0 p-1" @onclick="() => ConfirmDelete(lead)"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(lead.Email))
                            {
                                <div class="small mb-1"><i class="bi bi-envelope text-secondary me-2"></i>@lead.Email</div>
                            }
                            @if (!string.IsNullOrEmpty(lead.Phone))
                            {
                                <div class="small"><i class="bi bi-telephone text-secondary me-2"></i>@lead.Phone</div>
                            }
                        </div>
                        
                        <!-- Col 2: Details -->
                        <div class="flex-grow-1 d-flex flex-column justify-content-center gap-2">
                            @if(lead.TrailerTypes.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach(var tt in lead.TrailerTypes)
                                    {
                                        <span class="badge bg-secondary">@tt.ToString()</span>
                                    }
                                </div>
                            }
                            <div class="text-secondary small">
                                <i class="bi bi-chat-square-text me-1"></i> @lead.Notes.Count Notes
                            </div>
                        </div>
                        
                        <!-- Col 3: Status & Reminder -->
                        <div class="d-flex flex-column justify-content-center" style="min-width: 220px; max-width: 300px;">
                            <select class="form-select form-select-sm border-0 fw-bold mb-1 @GetStatusClass(lead.Status) w-100" 
                                    value="@lead.Status.ToString()"
                                    @onclick:stopPropagation="true"
                                    @onchange="@(async (ChangeEventArgs e) => await UpdateStatusAsync(lead, e.Value?.ToString()))">
                                @foreach (var status in Enum.GetValues<LeadStatus>().Where(s => s != LeadStatus.Contacted && s != LeadStatus.Invited && s != LeadStatus.Converted))
                                {
                                    <option value="@status">@(status.GetDescriptionValue() ?? status.ToString())</option>
                                }
                            </select>
                            @if (lead.Status != LeadStatus.Hired && lead.Status != LeadStatus.NotInterested && (lead.Status == LeadStatus.NeedsToBeContacted || lead.ReminderDate.HasValue))
                            {
                                var isDue = lead.ReminderDate.HasValue && lead.ReminderDate.Value.Date <= DateTime.UtcNow.Date;
                                var colorClass = isDue ? "text-danger fw-bold" : "text-secondary";
                                <div class="d-flex align-items-center px-1 mt-1 @colorClass" @onclick:stopPropagation="true">
                                    <i class="bi bi-bell-fill small me-1"></i>
                                    <input type="date" class="form-control form-control-sm border-0 bg-transparent px-1 py-0 shadow-none @colorClass" style="max-width: 130px; font-size: 0.75rem;" 
                                           value="@lead.ReminderDate?.ToString("yyyy-MM-dd")" 
                                           @onchange="@(async (ChangeEventArgs e) => await UpdateReminderDateAsync(lead, e.Value?.ToString()))" />
                                </div>
                            }
                        </div>

                        <!-- Col 4: Desktop Actions & Meta -->
                        <div class="d-flex flex-column justify-content-between align-items-lg-end" style="min-width: 180px;">
                            <div class="d-none d-lg-block mb-3" @onclick:stopPropagation="true">
                                @if (lead.Status != LeadStatus.Hired)
                                {
                                    <button class="btn btn-sm btn-outline-primary border-0 p-1 me-1" title="Invite to CDL Pool" @onclick="() => OpenInviteModal(lead)">
                                        <i class="bi bi-envelope-paper"></i>
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-secondary border-0 p-1 me-1" title="Edit" @onclick="() => OpenLeadDrawer(lead, true)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger border-0 p-1" title="Delete" @onclick="() => ConfirmDelete(lead)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            
                            <div class="text-lg-end mt-auto pt-2 pt-lg-0 border-top border-secondary border-lg-0 w-100">
                                <div class="small text-secondary">Added @lead.CreatedAt.ToString("MMM dd, yyyy")</div>
                                @if(lead.AddedByUser != null)
                                {
                                    <div class="small text-secondary mt-1">by @lead.AddedByUser.Email</div>
                                }
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
            }
        </div>

    @if (pagedLeads.Count == 0 && !string.IsNullOrEmpty(_searchTerm))
    {
        <div class="alert alert-info mt-3">No leads match your search.</div>
    }

    @if (totalPages > 1)
    {
        <nav aria-label="Lead list pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)">Previous</button>
                </li>
                @for (var i = 1; i <= totalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@if (deleteTarget != null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5); z-index: 1050;">
        <div class="modal-dialog">
            <div class="modal-content bg-dark border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-light">Confirm Delete</h5>
                </div>
                <div class="modal-body text-light">
                    Are you sure you want to delete lead <strong>@deleteTarget.FirstName @deleteTarget.LastName</strong>?
                    This will also remove all associated notes.
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isDrawerOpen)
{
    <LeadDrawer Lead="@selectedLead" OnClose="CloseDrawer" OnLeadSaved="HandleLeadSaved" CompanyId="userCompanyId" />
}

@if (isEditModalOpen)
{
    <LeadEditModal Lead="@editTargetLead" OnClose="CloseEditModal" OnLeadSaved="HandleLeadSaved" />
}

@if (isInviteModalOpen && inviteTargetLead != null)
{
    <InviteLeadModal Lead="inviteTargetLead" IsAdmin="isAdmin" ManagerCompanyId="userCompanyId" OnClose="CloseInviteModal" OnInvited="HandleInviteSent" />
}

@code {
    private List<Lead> pagedLeads = new();
    
    [SupplyParameterFromQuery(Name = "q")]
    public string? _searchTerm { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "status")]
    public string? _filterStatusStr { get; set; }
    private LeadStatus? _filterStatus => Enum.TryParse<LeadStatus>(_filterStatusStr, out var s) ? s : null;

    [SupplyParameterFromQuery(Name = "user")]
    public string? _filterUserId { get; set; }

    private List<ApplicationUser> _users = new();
    
    private bool isLoading = true;
    
    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;
    
    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 10;
    
    private int totalPages = 1;

    private bool isAdmin;
    private int? userCompanyId;

    private bool isDrawerOpen;
    private Lead? selectedLead;
    private bool isEditModalOpen;
    private Lead? editTargetLead;
    private bool isInviteModalOpen;
    private Lead? inviteTargetLead;
    private Lead? deleteTarget;

    private HashSet<string> _registeredEmails = new(StringComparer.OrdinalIgnoreCase);

    private bool IsLeadRegistered(Lead lead)
    {
        if (string.IsNullOrWhiteSpace(lead.Email)) return false;
        return _registeredEmails.Contains(lead.Email);
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.IsInRole(RoleConstants.Admin);
        
        if (!isAdmin)
        {
            var companyIdClaim = user.FindFirst("companyId")?.Value;
            if (int.TryParse(companyIdClaim, out var parsedCompanyId))
            {
                userCompanyId = parsedCompanyId;
            }
        }

        _users = await LeadService.GetUsersWithLeadsAsync(userCompanyId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;
        await LoadAsync(_searchTerm);
    }

    private async Task LoadAsync(string? searchTerm)
    {
        isLoading = true;
        try
        {
            bool isActionable = _filterStatusStr == "Actionable";
            var result = await LeadService.GetLeadsPagedAsync(currentPage, PageSize, userCompanyId, searchTerm, _filterStatus, _filterUserId, isActionable);
            pagedLeads = result.Items.ToList();
            totalPages = result.TotalPages;

            var emails = pagedLeads.Select(l => l.Email).Where(e => !string.IsNullOrWhiteSpace(e)).Cast<string>();
            _registeredEmails = await LeadService.GetRegisteredEmailsAsync(emails);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ResetPageAndLoad()
    {
        ChangePage(1);
    }

    private void HandleLeadSaved(bool isNew)
    {
        if (isEditModalOpen) CloseEditModal();
        if (isNew)
        {
            _searchTerm = string.Empty;
            _filterStatusStr = string.Empty;
            _filterUserId = string.Empty;
            ChangePage(1);
        }
        else
        {
            ChangePage(currentPage);
        }
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = page,
            ["size"] = PageSize,
            ["q"] = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
            ["status"] = string.IsNullOrWhiteSpace(_filterStatusStr) ? null : _filterStatusStr,
            ["user"] = string.IsNullOrWhiteSpace(_filterUserId) ? null : _filterUserId
        });
        Nav.NavigateTo(uri);
    }

    private string GetStatusClass(LeadStatus status)
    {
        return status switch
        {
            LeadStatus.New => "text-primary bg-primary bg-opacity-10",
            LeadStatus.NotInterested => "text-danger bg-danger bg-opacity-10",
            LeadStatus.ReadyToStart => "text-success bg-success bg-opacity-10",
            LeadStatus.AttemptContact => "text-warning bg-warning bg-opacity-10",
            LeadStatus.NeedsToBeContacted => "text-warning bg-warning bg-opacity-10",
            LeadStatus.ReadyIn2Weeks => "text-info bg-info bg-opacity-10",
            LeadStatus.Hired => "text-success bg-success bg-opacity-25 border border-success",
            LeadStatus.Contacted => "text-warning bg-warning bg-opacity-10",
            LeadStatus.Invited => "text-warning bg-warning bg-opacity-10",
            LeadStatus.Rejected => "text-danger bg-danger bg-opacity-10 border border-danger",
            _ => "text-secondary bg-light"
        };
    }

    private string GetCardStyle(LeadStatus status)
    {
        return status switch
        {
            LeadStatus.New => "background-color: rgba(var(--bs-primary-rgb), 0.1) !important; border-color: var(--bs-primary) !important;",
            LeadStatus.NotInterested => "background-color: rgba(var(--bs-danger-rgb), 0.1) !important; border-color: var(--bs-danger) !important;",
            LeadStatus.ReadyToStart => "background-color: rgba(var(--bs-success-rgb), 0.1) !important; border-color: var(--bs-success) !important;",
            LeadStatus.AttemptContact => "background-color: rgba(var(--bs-warning-rgb), 0.1) !important; border-color: var(--bs-warning) !important;",
            LeadStatus.NeedsToBeContacted => "background-color: rgba(var(--bs-warning-rgb), 0.1) !important; border-color: var(--bs-warning) !important;",
            LeadStatus.ReadyIn2Weeks => "background-color: rgba(var(--bs-info-rgb), 0.1) !important; border-color: var(--bs-info) !important;",
            LeadStatus.Hired => "background-color: rgba(var(--bs-success-rgb), 0.25) !important; border-color: var(--bs-success) !important; border-width: 2px !important;",
            LeadStatus.Rejected => "background-color: rgba(var(--bs-danger-rgb), 0.1) !important; border-color: var(--bs-danger) !important;",
            _ => "border-color: var(--bs-secondary) !important;"
        };
    }

    private async Task UpdateStatusAsync(Lead lead, string? newStatusStr)
    {
        if (Enum.TryParse<LeadStatus>(newStatusStr, out var newStatus))
        {
            lead.Status = newStatus;
            
            if (newStatus == LeadStatus.ReadyIn2Weeks)
            {
                lead.ReminderDate = DateTime.UtcNow.Date.AddDays(14);
            }
            
            await LeadService.UpdateAsync(lead);
        }
    }

    private async Task UpdateReminderDateAsync(Lead lead, string? newDateStr)
    {
        if (string.IsNullOrWhiteSpace(newDateStr))
        {
            lead.ReminderDate = null;
        }
        else if (DateTime.TryParse(newDateStr, out var newDate))
        {
            // Set the reminder date exactly to the date selected.
            lead.ReminderDate = DateTime.SpecifyKind(newDate, DateTimeKind.Utc);
        }
        await LeadService.UpdateAsync(lead);
    }



    private void OpenAddLeadModal()
    {
        editTargetLead = new Lead { CompanyId = userCompanyId };
        isEditModalOpen = true;
    }

    private void OpenLeadDrawer(Lead lead, bool editMode = false)
    {
        if (editMode)
        {
            editTargetLead = lead;
            isEditModalOpen = true;
        }
        else
        {
            selectedLead = lead;
            isDrawerOpen = true;
        }
    }

    private void OpenInviteModal(Lead lead)
    {
        inviteTargetLead = lead;
        isInviteModalOpen = true;
    }

    private void CloseInviteModal()
    {
        isInviteModalOpen = false;
        inviteTargetLead = null;
    }

    private async Task HandleInviteSent(string message)
    {
        if (inviteTargetLead != null)
        {
            var currentUserId = (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
            var note = new LeadNote
            {
                LeadId = inviteTargetLead.Id,
                AuthorUserId = currentUserId,
                Content = $"System: {message}."
            };
            await LeadNoteService.CreateAsync(note);
        }
        
        isInviteModalOpen = false;
        inviteTargetLead = null;
        await LoadAsync(_searchTerm);
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
        selectedLead = null;
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        editTargetLead = null;
    }

    private void ConfirmDelete(Lead lead)
    {
        deleteTarget = lead;
    }

    private void CancelDelete()
    {
        deleteTarget = null;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget != null)
        {
            await LeadService.DeleteAsync(deleteTarget.Id);
            deleteTarget = null;
            await LoadAsync(_searchTerm);
        }
    }
}
