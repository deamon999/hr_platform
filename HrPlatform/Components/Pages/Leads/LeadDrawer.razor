@using System.Security.Claims
@using HrPlatform.Data.Entities
@inject ILeadNoteService LeadNoteService

@inject AuthenticationStateProvider AuthStateProvider
@inject ICompanyService CompanyService

<style>
    @@keyframes drawerSlideUp {
        from {
            transform: translateY(100%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @@keyframes backdropFadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .lead-drawer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        width: 100%;
        height: 75vh;
        background-color: #1a1a1a;
        color: #fff;
        border-top: 1px solid #444;
        box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.9);
        z-index: 1060;
        display: flex;
        flex-direction: column;
        border-radius: 12px 12px 0 0;
        animation: drawerSlideUp 0.38s cubic-bezier(0.32, 0.72, 0, 1) both;
    }

    .lead-drawer.closing {
        animation: drawerSlideDown 0.32s cubic-bezier(0.32, 0.72, 0, 1) both;
    }

    @@keyframes drawerSlideDown {
        from {
            transform: translateY(0);
            opacity: 1;
        }
        to {
            transform: translateY(100%);
            opacity: 0;
        }
    }

    .lead-drawer-header {
        flex-shrink: 0;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #333;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .lead-drawer-body {
        flex: 1 1 0;
        overflow-y: auto;
        padding: 0;
    }

    .notes-timeline {
        overflow-y: auto;
        max-height: 320px;
        padding-right: 4px;
    }

    .lead-drawer-backdrop {
        animation: backdropFadeIn 0.3s ease both;
    }

    .lead-drawer-backdrop.closing {
        animation: backdropFadeOut 0.3s ease both;
    }

    @@keyframes backdropFadeOut {
        from {
            opacity: 1;
        }
        to {
            opacity: 0;
        }
    }

    @@media (min-width: 768px) {
        .lead-drawer {
            left: auto;
            right: 0;
            bottom: 0;
            width: 520px;
            height: 100vh;
            border-radius: 12px 0 0 0;
            border-top: 1px solid #444;
            border-left: 1px solid #333;
        }

        .notes-timeline {
            max-height: 100%;
        }
    }
</style>

<div class="lead-drawer @(_isClosing ? "closing" : "")">
    <div class="lead-drawer-header">
        <h5 class="fw-bold mb-0">@(Lead?.FirstName) @(Lead?.LastName) - Notes</h5>
        <button type="button" class="btn-close btn-close-white" @onclick="CloseWithAnimation"></button>
    </div>
    <div class="lead-drawer-body">

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger m-3">@_errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success m-3">@_successMessage</div>
        }

        @if (Lead != null)
        {
            <!-- Notes Section -->
            <div class="p-4">

                <div class="mb-4">
                    <textarea class="form-control mb-2 bg-dark text-light border-secondary" rows="2"
                              placeholder="@(editingNote != null ? "Edit note..." : "Write a note...")" @bind="newNoteContent"></textarea>
                    <div class="d-flex justify-content-end gap-2">
                        @if (editingNote != null)
                        {
                            <button class="btn btn-sm btn-outline-secondary px-3" @onclick="CancelEditNote">Cancel</button>
                            <button class="btn btn-sm btn-primary px-3 text-dark fw-bold" style="background-color: #f6c046; border-color: #f6c046;"
                                    @onclick="SaveNoteEditAsync" disabled="@(string.IsNullOrWhiteSpace(newNoteContent) || isSavingNote)">
                                @(isSavingNote ? "Saving..." : "Save")
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-primary px-3 text-dark fw-bold" style="background-color: #f6c046; border-color: #f6c046;"
                                    @onclick="AddNoteAsync" disabled="@(string.IsNullOrWhiteSpace(newNoteContent) || isSavingNote)">
                                @(isSavingNote ? "Saving..." : "Add Note")
                            </button>
                        }
                    </div>
                </div>

                <div class="notes-timeline position-relative ps-3" style="border-left: 2px solid #444;">
                    @foreach (var note in notes.OrderByDescending(n => n.Timestamp))
                    {
                        <div class="mb-4 position-relative">
                            <span class="position-absolute top-0 start-0 translate-middle bg-primary rounded-circle"
                                  style="width: 10px; height: 10px; margin-left: -16px; margin-top: 8px;"></span>
                            <div class="card bg-dark border-secondary shadow-sm text-light">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between mb-2 align-items-center">
                                        <span class="fw-bold small">@(note.AuthorUser?.FirstName ?? note.AuthorUser?.UserName ?? "User")</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="text-secondary small"
                                                  style="font-size: 0.75rem;">@TimeZoneService.ToUserTime(note.Timestamp).ToString("MMM dd, h:mm tt")</span>
                                            @if (note.AuthorUserId == currentUserId || isAdmin)
                                            {
                                                <button class="btn btn-sm btn-link text-secondary p-0 border-0" @onclick="() => EditNote(note)"><i
                                                        class="bi bi-pencil small"></i></button>
                                                <button class="btn btn-sm btn-link text-danger p-0 border-0"
                                                        @onclick="() => DeleteNoteAsync(note.Id)"><i class="bi bi-trash small"></i></button>
                                            }
                                        </div>
                                    </div>
                                    <p class="mb-0 small" style="white-space: pre-wrap;">
                                        @note.Content
                                        @if (note.IsEdited)
                                        {
                                            <span class="text-secondary ms-1" style="font-size: 0.70rem;">(edited)</span>
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                    @if (notes.Count == 0)
                    {
                        <p class="text-secondary small ms-2">No notes yet.</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Backdrop -->
<div class="modal-backdrop show lead-drawer-backdrop @(_isClosing ? "closing" : "")" style="z-index: 1055;" @onclick="CloseWithAnimation"></div>



@code {
    [Parameter] public Lead? Lead { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<bool> OnLeadSaved { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public int? CompanyId { get; set; }

    private bool _isClosing;
    private int _lastLeadId;

    private async Task CloseWithAnimation()
    {
        _isClosing = true;
        StateHasChanged();
        await Task.Delay(320);
        _isClosing = false;
        await OnClose.InvokeAsync();
    }

    private List<LeadNote> notes = new();
    private List<Company> companies = new();
    private string newNoteContent = string.Empty;
    private LeadNote? editingNote;

    private bool isSavingNote;
    private string _errorMessage = "";
    private string _successMessage = "";
    private bool isAdmin;
    private string currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.IsInRole(RoleConstants.Admin);
        currentUserId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";

        if (isAdmin)
        {
            companies = await CompanyService.GetAllAsync();
        }

        if (Lead != null && Lead.Id > 0)
        {
            _lastLeadId = Lead.Id;
            await LoadNotesAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var changedLead = Lead != null && Lead.Id > 0 && Lead.Id != _lastLeadId;

        if (changedLead)
        {
            _lastLeadId = Lead!.Id;
            editingNote = null;
            newNoteContent = string.Empty;
            _errorMessage = string.Empty;
            _successMessage = string.Empty;
            notes = new List<LeadNote>();
            await LoadNotesAsync();
        }
    }

    private async Task TriggerEdit()
    {
        await OnEdit.InvokeAsync();
    }

    private async Task LoadNotesAsync()
    {
        if (Lead != null && Lead.Id > 0)
        {
            notes = await LeadNoteService.GetNotesForLeadAsync(Lead.Id);
        }
    }

    private async Task AddNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(newNoteContent) || Lead == null) return;

        isSavingNote = true;
        try
        {
            var note = new LeadNote
            {
                LeadId = Lead.Id,
                AuthorUserId = currentUserId,
                Content = newNoteContent
            };
            await LeadNoteService.CreateAsync(note);
            newNoteContent = "";
            await LoadNotesAsync();
        }
        finally
        {
            isSavingNote = false;
        }
    }

    private void EditNote(LeadNote note)
    {
        editingNote = note;
        newNoteContent = note.Content;
    }

    private void CancelEditNote()
    {
        editingNote = null;
        newNoteContent = string.Empty;
    }

    private async Task SaveNoteEditAsync()
    {
        if (editingNote == null || string.IsNullOrWhiteSpace(newNoteContent)) return;

        isSavingNote = true;
        try
        {
            editingNote.Content = newNoteContent;
            await LeadNoteService.UpdateAsync(editingNote);
            editingNote = null;
            newNoteContent = string.Empty;
            await LoadNotesAsync();
        }
        finally
        {
            isSavingNote = false;
        }
    }

    private async Task DeleteNoteAsync(int noteId)
    {
        await LeadNoteService.DeleteAsync(noteId);
        if (editingNote?.Id == noteId)
        {
            CancelEditNote();
        }

        await LoadNotesAsync();
    }


}
