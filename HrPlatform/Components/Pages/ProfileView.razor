@page "/profiles/{Id:int}"
@page "/profiles/user/{UserId}"
@page "/my-profile"
@using System.Security.Claims
@using HrPlatform.Utils
@rendermode InteractiveServer

@attribute [Authorize]
@inject IDriverProfileService ProfileSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

<PageTitle>Driver Profile</PageTitle>

<div class="@(isAdminOrManager ? "d-print-none" : "")">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="mb-0 fw-bold">Driver Profile</h1>

        @if (profile is not null)
        {
            <div class="d-flex gap-2">
                @if (isOwner)
                {
                    <button class="btn btn-primary px-4 rounded-pill"
                            @onclick="GoToEditProfile">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </button>
                }

                @if (isAdminOrManager)
                {
                    <button type="button" @onclick="PrintPage" class="btn btn-primary px-4 rounded-pill">
                        <i class="bi bi-printer me-1"></i> Print / Save PDF
                    </button>
                }

                @if (canDelete)
                {
                    <button class="btn btn-outline-danger px-4 rounded-pill" @onclick="ConfirmDelete">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                }

                <button class="btn btn-outline-secondary px-4 rounded-pill" @onclick="GoBack">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </button>
            </div>
        }
    </div>

    <div>
        <hr/>
        @if (profile is not null && isOwner)
        {
            <div class="p-3 mb-4 mt-3 rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" style="background-color: #242526; border: 1px solid rgba(255,255,255,0.05);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px; background-color: rgba(223, 177, 85, 0.1); color: #dfb155;">
                        <i class="bi bi-broadcast fs-4"></i>
                    </div>
                    <div>
                        <h5 class="mb-1 fw-bold text-white">Availability Status</h5>
                        <small class="text-secondary">Keep your status updated so carriers know exactly when to send you new job offers.</small>
                    </div>
                </div>
                <div>
                    <select class="form-select border-0 shadow-sm" style="min-width: 260px; background-color: #2b2d31; color: #e9ecef;" value="@profile.AvailabilityStatus" @onchange="UpdateAvailabilityStatusAsync">
                        @foreach (var status in Enum.GetValues<AvailabilityStatus>())
                        {
                            <option value="@status">@(status.GetDescriptionValue() ?? status.ToString())</option>
                        }
                    </select>
                </div>
            </div>
            <hr/>
        }

        @if (profile is null)
        {
            @if (isAdminOrManager)
            {
                <EmptyState Icon="bi-person-x"
                            Title="Profile Not Available"
                            Message="The requested driver profile could not be found or has not been created yet."
                            ActionText="Back to Profiles"
                            ActionIcon="bi-arrow-left"
                            ActionHref="/profiles" />
            }
            else
            {
                <div class="card shadow-sm border-0 app-card mb-4 mt-2">
                    <div class="card-body p-5 text-center">
                        <i class="bi bi-person-lines-fill text-primary" style="font-size: 3rem;"></i>
                        <h3 class="mt-3 fw-bold">Welcome to your Driver Profile</h3>
                        <p class="text-secondary fs-5 mt-3 mx-auto" style="max-width: 600px;">
                            Before you can apply to jobs, you'll need to complete your profile. This gives employers everything they need to hire you fast!
                        </p>
                        <div class="d-flex justify-content-center gap-4 mt-4 text-secondary small fw-medium mb-4">
                            <div><i class="bi bi-clock me-1"></i> Takes ~5-10 minutes</div>
                            <div><i class="bi bi-shield-check me-1"></i> Secure & Private</div>
                            <div><i class="bi bi-briefcase me-1"></i> Required for Jobs</div>
                        </div>
                        <button class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm" @onclick="GoToCreateProfile">
                            Get Started Now
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-3 mb-4 mb-lg-0">
                    <div class="card shadow-sm border-0 app-card">
                        <div class="card-body p-3">
                            <ul class="nav nav-pills flex-column gap-2">
                                @for (var index = 0; index < tabs.Length; index++)
                                {
                                    var tabIndex = index;
                                    var label = tabs[tabIndex];

                                    <li class="nav-item">
                                        <button type="button"
                                                class="nav-link text-start w-100 rounded-pill @(activeTab == tabIndex ? "active fw-semibold shadow-sm" : "text-secondary")"
                                                @onclick="() => ActivateTab(tabIndex)">
                                            @label
                                        </button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-lg-9">
                    <div class="card shadow-sm border bg-dark text-light app-card">
                        <div class="card-header bg-transparent border-bottom border-secondary p-4">
                            <h4 class="mb-0 fw-bold">@tabs[activeTab]</h4>
                        </div>

                        <div class="card-body p-4">
                            <EditForm Model="profile">
                                <div class="@(activeTab == 0 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfilePersonalForm Profile="profile" IsReadOnly="true" />
                                </div>
                                <div class="@(activeTab == 1 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileLicenseForm Profile="profile" IsReadOnly="true" />
                                </div>
                                <div class="@(activeTab == 2 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileDrivingStatsForm Profile="profile" IsReadOnly="true" />
                                </div>
                                <div class="@(activeTab == 3 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileEmploymentForm Profile="profile" IsReadOnly="true" />
                                </div>
                                <div class="@(activeTab == 4 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileSafetyForm Profile="profile" IsReadOnly="true" />
                                </div>
                                <div class="@(activeTab == 5 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfilePreferencesForm Profile="profile" IsReadOnly="true" />
                                </div>
                                <div class="@(activeTab == 6 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileEducationForm Profile="profile" IsReadOnly="true" />
                                </div>
                                <div class="@(activeTab == 7 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileDocumentsForm Profile="profile" IsReadOnly="true" />
                                </div>
                                <div class="@(activeTab == 8 ? "" : "d-none")">
                                    <HrPlatform.Components.Pages.ProfileShared.ProfileConsentsForm Profile="profile" IsReadOnly="true" />
                                </div>
                            </EditForm>
                        </div>
                    </div>
                </div>
            </div>

            <style>
                .app-card {
                    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
                }
                .nav-pills .nav-link {
                    color: var(--text-secondary);
                }
                .nav-pills .nav-link:hover:not(.active) {
                    background-color: rgba(255, 255, 255, 0.05);
                    color: var(--text-primary);
                }
                .nav-pills .nav-link.active {
                    background-color: var(--accent-primary) !important;
                    color: #000 !important;
                }
            </style>
        }

        <ConfirmDialog IsOpen="@(showDeleteConfirm && profile is not null)"
                       Title="Confirm Delete Profile"
                       ConfirmText="Delete"
                       ConfirmButtonClass="btn-danger"
                       IsProcessing="@isDeleting"
                       OnConfirm="DeleteAsync"
                       OnCancel="() => showDeleteConfirm = false">
            <BodyContent>
                @if (profile is not null)
                {
                    <p class="mb-2">
                        Are you sure you want to permanently delete the profile for
                        <strong class="text-light">@profile.FirstName @profile.LastName</strong>?
                    </p>
                    <p class="text-secondary small mb-0">
                        This action cannot be undone and will also remove all their job applications.
                    </p>
                }
            </BodyContent>
        </ConfirmDialog>
    </div>
</div>

@if (profile != null && isAdminOrManager)
{
    <div class="d-none d-print-block">
        <PrintProfile Profile="profile" />
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? UserId { get; set; }

    private DriverProfile? profile;
    private List<TrailerType> trailerTypes = new();
    private bool showDeleteConfirm;
    private bool canDelete;
    private string backUrl = "/";
    private bool isOwner;
    private bool isAdminOrManager;
    private int activeTab;

    private static readonly string[] tabs =
        ["Personal Information", "CDL License & Medical", "Driving Experience", "Employment History", "Safety History", "Preferences", "Education", "Other Documents", "Consents & Authorizations"];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        isAdminOrManager = auth.User.IsInRole(RoleConstants.Admin) || auth.User.IsInRole(RoleConstants.Manager);

        if (!string.IsNullOrEmpty(UserId))
        {
            profile = await ProfileSvc.GetByUserIdAsync(UserId);
            backUrl = "/driver-pipeline";
        }
        else if (Id == 0)
        {
            profile = await ProfileSvc.GetByUserIdAsync(currentUserId);
            backUrl = "/";
        }
        else
        {
            profile = await ProfileSvc.GetByIdAsync(Id);
            backUrl = isAdminOrManager ? "/profiles" : "/";
        }

        if (profile is not null)
        {
            isOwner = profile.UserId == currentUserId;
            canDelete = isOwner || isAdminOrManager;

            activeTab = 0;
            trailerTypes = profile.AllTrailerTypes.ToList();
        }
    }

    private async Task PrintPage()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task UpdateAvailabilityStatusAsync(ChangeEventArgs e)
    {
        if (profile != null && Enum.TryParse<AvailabilityStatus>(e.Value?.ToString(), out var status))
        {
            profile.AvailabilityStatus = status;
            var auth = await AuthState.GetAuthenticationStateAsync();
            var currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? profile.UserId;
            await ProfileSvc.UpdateAsync(profile, currentUserId);
        }
    }

    private void ActivateTab(int index)
    {
        if (index < 0 || index >= tabs.Length)
            return;

        activeTab = index;
    }

    private void ConfirmDelete()
    {
        showDeleteConfirm = true;
    }

    private bool isDeleting;

    private async Task DeleteAsync()
    {
        if (profile is null)
            return;

        try
        {
            isDeleting = true;
            var auth = await AuthState.GetAuthenticationStateAsync();
            var currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)!.Value;
            var isAdmin = auth.User.IsInRole(RoleConstants.Admin);

            await ProfileSvc.DeleteAsync(profile.Id, currentUserId, isAdmin);
            Nav.NavigateTo(backUrl);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void GoToCreateProfile()
    {
        Nav.NavigateTo("/profiles/new");
    }

    private void GoToEditProfile()
    {
        if (profile is not null)
        {
            Nav.NavigateTo($"/profiles/edit/{profile.Id}", forceLoad: true);
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo(backUrl);
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? string.Empty : value;
    }

    private static string FormatDate(DateOnly value)
    {
        return value == default ? string.Empty : value.ToString("yyyy-MM-dd");
    }

    private static string FormatDate(DateOnly? value)
    {
        return value.HasValue && value.Value != default ? value.Value.ToString("yyyy-MM-dd") : string.Empty;
    }



}

