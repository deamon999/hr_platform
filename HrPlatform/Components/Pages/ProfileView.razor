@page "/profiles/{Id:int}"
@page "/my-profile"
@using System.Security.Claims
@using HrPlatform.Utils
@rendermode InteractiveServer

@attribute [Authorize]
@inject IDriverProfileService ProfileSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>Driver Profile</PageTitle>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="mb-0 fw-bold">Driver Profile</h1>

    @if (profile is not null)
    {
        <div class="d-flex gap-2">
            @if (isOwner)
            {
                <button class="btn btn-primary px-4 rounded-pill"
                        @onclick="GoToEditProfile">
                    <i class="bi bi-pencil me-1"></i> Edit
                </button>
            }

            @if (canDelete)
            {
                <button class="btn btn-outline-danger px-4 rounded-pill" @onclick="ConfirmDelete">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            }

            <button class="btn btn-outline-secondary px-4 rounded-pill" @onclick="GoBack">
                <i class="bi bi-arrow-left me-1"></i> Back
            </button>
        </div>
    }
</div>

<div>
    <hr/>

    @if (profile is null)
    {
        @if (isAdminOrManager)
        {
            <p>This profile is not available</p>
        }
        else
        {
            <div class="alert alert-warning">
                <strong>Driver profile is required in order to be able to apply for any job</strong>
                <a class="alert-link ms-1" role="button" style="cursor:pointer" @onclick="GoToCreateProfile">
                    Create your profile
                </a>
            </div>
        }
    }
    else
    {
        @if (!isAdminOrManager)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h4 class="text-muted">Profile completeness</h4>
                    <span class="badge @profile.CompletenessBadgeClass">
                        @profile.CompletenessLabel (@profile.CompletenessScore%)
                    </span>
                </div>
                <div class="progress" style="height:6px">
                    <div class="progress-bar @profile.CompletenessBadgeClass"
                         style="width:@(profile.CompletenessScore)%">
                    </div>
                </div>
                @if (profile.MissingFields.Any() && isOwner)
                {
                    <div class="mt-2">
                        <span class="text-muted small d-block mb-1">Missing information:</span>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var field in profile.MissingFields)
                            {
                                <span class="badge bg-secondary">@field</span>
                            }
                        </div>
                    </div>
                }
            </div>
            <hr/>
        }

        <div class="row g-4">
            <div class="col-lg-3 mb-4 mb-lg-0">
                <div class="card shadow-sm border-0 app-card">
                    <div class="card-body p-3">
                        <ul class="nav nav-pills flex-column gap-2">
                            @for (var index = 0; index < tabs.Length; index++)
                            {
                                var tabIndex = index;
                                var label = tabs[tabIndex];

                                <li class="nav-item">
                                    <button type="button"
                                            class="nav-link text-start w-100 rounded-pill @(activeTab == tabIndex ? "active fw-semibold shadow-sm" : "text-dark")"
                                            @onclick="() => ActivateTab(tabIndex)">
                                        @label
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="card shadow-sm border-0 app-card">
                    <div class="card-header bg-white border-bottom p-4">
                        <h4 class="mb-0 fw-bold">@tabs[activeTab]</h4>
                    </div>

                    <div class="card-body p-4">
                        <EditForm Model="profile">
                            <div class="@(activeTab == 0 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfilePersonalForm Profile="profile" IsReadOnly="true" />
                            </div>
                            <div class="@(activeTab == 1 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileDrivingStatsForm Profile="profile" IsReadOnly="true" />
                            </div>
                            <div class="@(activeTab == 2 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileLicenseForm Profile="profile" IsReadOnly="true" />
                            </div>
                            <div class="@(activeTab == 3 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileSkillsForm Profile="profile" IsReadOnly="true" />
                            </div>
                            <div class="@(activeTab == 4 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileEmploymentForm Profile="profile" IsReadOnly="true" />
                            </div>
                            <div class="@(activeTab == 5 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileEducationForm Profile="profile" IsReadOnly="true" />
                            </div>
                            <div class="@(activeTab == 6 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileCertificationsForm Profile="profile" IsReadOnly="true" />
                            </div>
                            <div class="@(activeTab == 7 ? "" : "d-none")">
                                @if (profile.ViolationHistory == null || !profile.ViolationHistory.Any())
                                {
                                    <div class="text-center text-muted py-5">
                                        <i class="bi bi-shield-check fs-1 text-success mb-3 d-block"></i>
                                        <p class="fs-5 mb-0">No safety records or violations reported.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="row g-3">
                                        @foreach (var viol in profile.ViolationHistory)
                                        {
                                            <div class="col-12">
                                                <div class="card shadow-sm border-0 bg-light">
                                                    <div class="card-header bg-white border-bottom fw-bold text-dark d-flex justify-content-between align-items-center">
                                                        <span>@viol.Type</span>
                                                        @if (viol.AtFault)
                                                        {
                                                            <span class="badge bg-danger rounded-pill">At Fault</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-success rounded-pill">Not At Fault</span>
                                                        }
                                                    </div>
                                                    <div class="card-body">
                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <span class="text-muted d-block small mb-1"><i class="bi bi-calendar-event me-1"></i> Date</span>
                                                                <span class="fw-medium">@viol.OccurredDate.ToString("MMM dd, yyyy")</span>
                                                            </div>
                                                            @if (!string.IsNullOrEmpty(viol.Description))
                                                            {
                                                                <div class="col-12">
                                                                    <span class="text-muted d-block small mb-1"><i class="bi bi-file-text me-1"></i> Description</span>
                                                                    <span>@viol.Description</span>
                                                                </div>
                                                            }
                                                            @if (!string.IsNullOrEmpty(viol.Resolution))
                                                            {
                                                                <div class="col-12">
                                                                    <span class="text-muted d-block small mb-1"><i class="bi bi-check-circle me-1"></i> Resolution</span>
                                                                    <span>@viol.Resolution</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>

        <style>
            .app-card {
                transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            }
            .nav-pills .nav-link:hover:not(.active) {
                background-color: #f8f9fa;
            }
        </style>
    }

    @if (showDeleteConfirm && profile is not null)
    {
        <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                    </div>

                    <div class="modal-body">
                        Permanently delete the profile for
                        <strong>@profile.FirstName @profile.LastName</strong>?
                        This will also remove all their applications.
                    </div>

                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="() => showDeleteConfirm = false">
                            Cancel
                        </button>
                        <button class="btn btn-danger" @onclick="DeleteAsync">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private DriverProfile? profile;
    private List<TrailerType> trailerTypes = new();
    private bool showDeleteConfirm;
    private bool canDelete;
    private string backUrl = "/";
    private bool isOwner;
    private bool isAdminOrManager;
    private int activeTab;

    private static readonly string[] tabs =
        ["Personal", "Driving Stats", "License & Medical", "Skills", "Employment", "Education", "Certifications", "Safety Record"];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)!.Value;
        isAdminOrManager = auth.User.IsInRole(RoleConstants.Admin) || auth.User.IsInRole(RoleConstants.Manager);

        if (Id == 0)
        {
            profile = await ProfileSvc.GetByUserIdAsync(currentUserId);
            backUrl = "/";
        }
        else
        {
            profile = await ProfileSvc.GetByIdAsync(Id);
            backUrl = isAdminOrManager ? "/profiles" : "/";
        }

        if (profile is not null)
        {
            trailerTypes = profile.AllTrailerTypes?.ToList() ?? new List<TrailerType>();
            isOwner = profile.UserId == currentUserId;
            canDelete = auth.User.IsInRole(RoleConstants.Admin) || isOwner;
        }
    }

    private void ActivateTab(int index)
    {
        if (index < 0 || index >= tabs.Length)
            return;

        activeTab = index;
    }

    private void ConfirmDelete()
    {
        showDeleteConfirm = true;
    }

    private async Task DeleteAsync()
    {
        if (profile is null)
            return;

        var auth = await AuthState.GetAuthenticationStateAsync();
        var currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)!.Value;
        var isAdmin = auth.User.IsInRole(RoleConstants.Admin);

        await ProfileSvc.DeleteAsync(profile.Id, currentUserId, isAdmin);
        Nav.NavigateTo(backUrl);
    }

    private void GoToCreateProfile()
    {
        Nav.NavigateTo("/profiles/new");
    }

    private void GoToEditProfile()
    {
        if (profile is not null)
        {
            Nav.NavigateTo($"/profiles/edit/{profile.Id}");
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo(backUrl);
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? string.Empty : value;
    }

    private static string FormatDate(DateOnly value)
    {
        return value == default ? string.Empty : value.ToString("yyyy-MM-dd");
    }

    private static string FormatDate(DateOnly? value)
    {
        return value.HasValue && value.Value != default ? value.Value.ToString("yyyy-MM-dd") : string.Empty;
    }



}

