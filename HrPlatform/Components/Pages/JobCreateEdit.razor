@page "/jobs/new"
@page "/jobs/edit/{Id:int}"
@using HrPlatform.Utils
@rendermode InteractiveServer

@attribute [Authorize]
@inject IJobService JobSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@(Id == 0 ? "Post New Job" : "Edit Job")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@(Id == 0 ? "Post New Job" : "Edit Job")</h2>
</div>

@if (job is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="job" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator/>
        <ValidationSummary class="text-danger"/>

        <HrPlatform.Components.Pages.JobShared.JobForm Job="job" IsReadOnly="false" Companies="companies" IsCompanySelectionDisabled="isCompanySelectionDisabled" />

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(Id == 0 ? "Post Job" : "Save Changes")</button>
            <a href="/jobs" class="btn btn-outline-secondary">Cancel</a>
        </div>

    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }
    private Job? job;
    private List<Company> companies = new();
    private bool isCompanySelectionDisabled = false;

    protected override async Task OnInitializedAsync()
    {
        job = Id == 0 ? new Job() : await JobSvc.GetByIdAsync(Id) ?? new Job();
        companies = await JobSvc.GetCompaniesAsync();
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        if (user.FindFirst("companyId") != null)
        {
            isCompanySelectionDisabled = true;
            job.CompanyId = Convert.ToInt32(user.FindFirst("companyId").Value);
        }
    }

    private async Task SaveAsync()
    {
        if (job is null) return;

        if (Id == 0)
        {
            await JobSvc.CreateAsync(job);
            Nav.NavigateTo("/jobs");
        }
        else
        {
            await JobSvc.UpdateAsync(job);
            // After successful save, return to jobs list
            Nav.NavigateTo("/jobs");
        }
    }


}

