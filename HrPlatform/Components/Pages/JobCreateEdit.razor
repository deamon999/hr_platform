@page "/jobs/new"
@page "/jobs/edit/{Id:int}"
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject IJobService JobSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@(Id == 0 ? "Post New Job" : "Edit Job")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">@(Id == 0 ? "Post New Job" : "Edit Job")</h2>
    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="Cancel">
        <i class="bi bi-arrow-left me-1"></i> Back to Jobs
    </button>
</div>

@if (isLoading)
{
    <LoadingSpinner Text="Loading job..." />
}
else if (notFound)
{
    <EmptyState Icon="bi-search" Title="Job Not Found" Message="The requested job posting could not be found." ActionText="Back to Jobs" ActionIcon="bi-arrow-left" OnAction="Cancel" />
}
else if (notAuthorized)
{
    <EmptyState Icon="bi-shield-x" Title="Access Denied" Message="You do not have permission to edit this job posting." ActionText="Back to Jobs" ActionIcon="bi-arrow-left" OnAction="Cancel" />
}
else if (noCompanyAssigned)
{
    <EmptyState Icon="bi-building-exclamation" Title="No Company Assigned" Message="Your manager account is not assigned to a company. Please contact an administrator." ActionText="Back to Jobs" ActionIcon="bi-arrow-left" OnAction="Cancel" />
}
else if (job is not null)
{
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 app-card">
                <div class="card-body p-4 p-md-5">
                    <EditForm Model="job" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator/>
                        <ValidationSummary class="text-danger small mb-4"/>

                        <HrPlatform.Components.Pages.JobShared.JobForm Job="job" IsReadOnly="false" Companies="companies"
                                                                       IsCompanySelectionDisabled="isCompanySelectionDisabled"/>

                        <div class="d-flex gap-2 mt-5 pt-4 border-top border-secondary border-opacity-25 justify-content-end">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2" @onclick="Cancel" disabled="@isSaving">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <i class="bi @(Id == 0 ? "bi-check-circle" : "bi-save") me-1"></i> @(Id == 0 ? "Post Job" : "Save Changes")
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .app-card {
        background-color: #242526;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        border-radius: 0.75rem;
    }

    .dark-input {
        background-color: #2b2d31 !important;
        color: #e9ecef !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
    }

    .dark-input:focus {
        background-color: #313338 !important;
        color: #fff !important;
        border-color: #dfb155 !important;
        box-shadow: 0 0 0 0.25rem rgba(223, 177, 85, 0.25) !important;
    }

    .dark-input:disabled {
        background-color: #1e1f22 !important;
        opacity: 0.7;
    }

    .section-title {
        color: #dfb155;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .form-label {
        color: #adb5bd !important;
    }

    .input-group-text.dark-addon {
        background-color: #2b2d31;
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: #adb5bd;
    }
</style>

@code {
    [SupplyParameterFromQuery] public string? returnUrl { get; set; }

    [Parameter] public int Id { get; set; }
    private Job? job;
    private List<Company> companies = new();
    private bool isCompanySelectionDisabled;
    private bool isLoading = true;
    private bool notFound;
    private bool notAuthorized;
    private bool noCompanyAssigned;
    private bool isSaving;
    private bool isAdmin;
    private int? userCompanyId;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var user = auth.User;
            isAdmin = user.IsInRole(RoleConstants.Admin);
            if (int.TryParse(user.FindFirst("companyId")?.Value, out var cid))
            {
                userCompanyId = cid;
            }

            companies = await JobSvc.GetCompaniesAsync();

            if (!isAdmin && !userCompanyId.HasValue)
            {
                noCompanyAssigned = true;
                return;
            }

            if (Id == 0)
            {
                job = new Job();
                if (!isAdmin && userCompanyId.HasValue)
                {
                    job.CompanyId = userCompanyId.Value;
                    isCompanySelectionDisabled = true;
                }
            }
            else
            {
                var existing = await JobSvc.GetByIdAsync(Id);
                if (existing is null)
                {
                    notFound = true;
                    return;
                }

                if (!isAdmin && userCompanyId.HasValue && existing.CompanyId != userCompanyId.Value)
                {
                    notAuthorized = true;
                    return;
                }

                job = existing;
                if (!isAdmin)
                {
                    isCompanySelectionDisabled = true;
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (job is null || isSaving) return;

        isSaving = true;
        try
        {
            if (Id == 0)
            {
                await JobSvc.CreateAsync(job);
            }
            else
            {
                await JobSvc.UpdateAsync(job);
            }

            Cancel();
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        if (!string.IsNullOrEmpty(returnUrl))
        {
            Nav.NavigateTo(returnUrl);
        }
        else
        {
            Nav.NavigateTo("/jobs");
        }
    }


}

