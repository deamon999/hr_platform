@page "/jobs/new"
@page "/jobs/edit/{Id:int}"
@using HrPlatform.Utils
@rendermode InteractiveServer

@attribute [Authorize]
@inject IJobService JobSvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@(Id == 0 ? "Post New Job" : "Edit Job")</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-dark">@(Id == 0 ? "Post New Job" : "Edit Job")</h2>
    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="Cancel">
        <i class="bi bi-arrow-left me-1"></i> Back to Jobs
    </button>
</div>

@if (job is null)
{
    <p>Loading...</p>
}
else
{
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 app-card">
                <div class="card-body p-4 p-md-5">
                    <EditForm Model="job" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator/>
                        <ValidationSummary class="text-danger small mb-4"/>

                        <HrPlatform.Components.Pages.JobShared.JobForm Job="job" IsReadOnly="false" Companies="companies" IsCompanySelectionDisabled="isCompanySelectionDisabled" />

                        <div class="d-flex gap-2 mt-5 pt-4 border-top border-secondary border-opacity-25 justify-content-end">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2" @onclick="Cancel">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                                <i class="bi @(Id == 0 ? "bi-check-circle" : "bi-save") me-1"></i> @(Id == 0 ? "Post Job" : "Save Changes")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .app-card {
        background-color: #242526;
        border: 1px solid rgba(255,255,255,0.05) !important;
        border-radius: 0.75rem;
    }
    .dark-input {
        background-color: #2b2d31 !important;
        color: #e9ecef !important;
        border: 1px solid rgba(255,255,255,0.05) !important;
    }
    .dark-input:focus {
        background-color: #313338 !important;
        color: #fff !important;
        border-color: #dfb155 !important;
        box-shadow: 0 0 0 0.25rem rgba(223, 177, 85, 0.25) !important;
    }
    .dark-input:disabled {
        background-color: #1e1f22 !important;
        opacity: 0.7;
    }
    .section-title {
        color: #dfb155;
        font-weight: 700;
        font-size: 1.1rem;
    }
    .form-label {
        color: #adb5bd !important;
    }
    .input-group-text.dark-addon {
        background-color: #2b2d31;
        border: 1px solid rgba(255,255,255,0.05);
        color: #adb5bd;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? returnUrl { get; set; }

    [Parameter] public int Id { get; set; }
    private Job? job;
    private List<Company> companies = new();
    private bool isCompanySelectionDisabled = false;

    protected override async Task OnInitializedAsync()
    {
        job = Id == 0 ? new Job() : await JobSvc.GetByIdAsync(Id) ?? new Job();
        companies = await JobSvc.GetCompaniesAsync();
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        var companyClaim = user.FindFirst("companyId");
        if (companyClaim != null)
        {
            isCompanySelectionDisabled = true;
            job.CompanyId = Convert.ToInt32(companyClaim.Value);
        }
    }

    private async Task SaveAsync()
    {
        if (job is null) return;

        if (Id == 0)
        {
            await JobSvc.CreateAsync(job);
        }
        else
        {
            await JobSvc.UpdateAsync(job);
        }
        
        Cancel();
    }

    private void Cancel()
    {
        if (!string.IsNullOrEmpty(returnUrl))
        {
            Nav.NavigateTo(returnUrl);
        }
        else
        {
            Nav.NavigateTo("/jobs");
        }
    }


}

