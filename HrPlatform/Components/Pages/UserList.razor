@rendermode InteractiveServer
@implements IDisposable

@using HrPlatform.Models
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject NavigationManager Nav
@inject IAdminUserService UserService
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JSRuntime


@if (isLoading)
{
    <LoadingSpinner Text="Loading users..." />
}
else
{
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2">
            <DebounceInput class="form-control form-control-sm bg-dark text-light border-secondary shadow-sm"
                           placeholder="Search by email, username, or company"
                           @bind-Value="_searchTerm"
                           @bind-Value:after="HandleSearchInput"/>
            <select class="form-select form-select-sm bg-dark text-light border-secondary shadow-sm" style="min-width: 140px;" @bind="_filterRole" @bind:after="HandleSearchInput">
                <option value="">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="Manager">Manager</option>
                <option value="Driver">Driver</option>
            </select>
            <select class="form-select form-select-sm bg-dark text-light border-secondary shadow-sm" style="min-width: 140px;" @bind="_filterVerified" @bind:after="HandleSearchInput">
                <option value="">All Verification</option>
                <option value="Verified">Verified</option>
                <option value="Unverified">Unverified</option>
            </select>
            @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_filterRole) || !string.IsNullOrWhiteSpace(_filterVerified))
            {
                <button class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="ClearFilters">Clear</button>
            }
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
            <select class="form-select form-select-sm bg-dark text-light border-secondary shadow-sm" style="width: 70px;" @bind="PageSize" @bind:after="ResetPageAndLoad">
                <option value="10">10</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    @if (_statusMessage is not null)
    {
        <div class="alert @_statusClass alert-dismissible mb-3" role="alert">
            @_statusMessage
            <button type="button" class="btn-close"
                    @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <div>
        <div class="row g-3">
            @foreach (var user in pagedUsers)
            {
                <div class="col-12">
                    <div class="card shadow-sm border bg-dark text-light h-100 app-card">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <div class="d-flex flex-wrap align-items-center mb-2 gap-2">
                                        <h4 class="fw-bold mb-0 text-light text-break">@user.Username</h4>
                                        <StatusBadge Status="@user.IsConfirmed" Text="@(user.IsConfirmed ? "Verified" : "Unverified")" />
                                    </div>
                                    
                                    <div class="mb-3 text-secondary small">
                                        <div class="d-flex flex-wrap align-items-center gap-3 mb-1">
                                            <span><i class="bi bi-envelope"></i> @user.Email</span>
                                            @if (!string.IsNullOrEmpty(user.Phone))
                                            {
                                                <span><i class="bi bi-telephone"></i> @user.Phone</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(user.CompanyName))
                                        {
                                            <div class="text-muted"><i class="bi bi-building"></i> @user.CompanyName</div>
                                        }
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 text-secondary small">
                                        @if (!string.IsNullOrEmpty(user.Roles))
                                        {
                                            <span class="badge bg-info bg-opacity-25 text-info border border-info rounded-pill px-3 py-2"><i class="bi bi-person-badge me-1"></i> @user.Roles</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary rounded-pill px-3 py-2">No Roles</span>
                                        }
                                    </div>
                                </div>
                                
                                <div class="col-md-5 d-flex gap-2 justify-content-md-end align-items-end flex-wrap mt-3 mt-md-0">
                                    <button class="btn btn-primary px-4" @onclick="() => GoToView(user.UserId)">View</button>
                                    <button class="btn btn-outline-secondary" @onclick="() => GoToEdit(user.UserId)">Edit</button>
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => ConfirmDelete(user)" title="Delete User"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .app-card {
                transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            }
            .app-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
            }
        </style>

        @if (pagedUsers.Count == 0)
        {
            <EmptyState Icon="bi-people"
                        Title="No users found"
                        Message="No users matched your current search or filter criteria."
                        ActionText="@(!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_filterRole) || !string.IsNullOrWhiteSpace(_filterVerified) ? "Clear Filters" : null)"
                        ActionIcon="bi-x-circle"
                        OnAction="ClearFilters" />
        }
    </div>

    <PaginationNav TotalPages="totalPages" CurrentPage="currentPage" OnPageChanged="ChangePage" AriaLabel="User list pagination" />
}

<ConfirmDialog IsOpen="@(deleteTarget is not null)"
               Title="Confirm Delete User"
               ConfirmText="Delete"
               ConfirmButtonClass="btn-danger"
               IsProcessing="@isDeleting"
               OnConfirm="DeleteConfirmedAsync"
               OnCancel="() => deleteTarget = null">
    <BodyContent>
        @if (deleteTarget is not null)
        {
            <p class="mb-2">Are you sure you want to permanently delete <strong class="text-light">@deleteTarget.Username</strong>?</p>
            <p class="text-secondary small mb-0">This action cannot be undone and will remove all their access permissions.</p>
        }
    </BodyContent>
</ConfirmDialog>

@code {
    private List<UserViewModel> pagedUsers = new();

    // UI State
    private string? _statusMessage;
    private string _statusClass = "alert-success";
    public string? SearchQuery { get; set; }
    public int? PageQuery { get; set; }
    public int? SizeQuery { get; set; }

    private int currentPage = 1;
    public int PageSize { get; set; } = 10;
    private int totalPages = 1;
    private string? _searchTerm;
    private string? _filterRole;
    private string? _filterVerified;
    private bool isLoading = true;
    private UserViewModel? deleteTarget;

    // Auth State
    private bool isAdmin;
    private int? companyId;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        ParseParametersFromUri();

        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;

        isAdmin = user.IsInRole(RoleConstants.Admin);

        if (!isAdmin)
        {
            var companyIdClaim = user.FindFirst("companyId")?.Value;

            if (int.TryParse(companyIdClaim, out var parsedCompanyId))
            {
                companyId = parsedCompanyId;
            }
        }
    }

    private void ResetPageAndLoad()
    {
        currentPage = 1;
        var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            { "page", null }, // reset to page 1
            { "size", PageSize == 10 ? null : PageSize },
            { "q", string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm },
            { "role", string.IsNullOrWhiteSpace(_filterRole) ? null : _filterRole },
            { "verified", string.IsNullOrWhiteSpace(_filterVerified) ? null : _filterVerified }
        });
        Nav.NavigateTo(url);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            ParseParametersFromUri();
            await LoadAsync(_searchTerm);
            StateHasChanged();
        });
    }

    private void ParseParametersFromUri()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        
        _searchTerm = query.TryGetValue("q", out var q) ? (string?)q : null;
        _filterRole = query.TryGetValue("role", out var r) ? (string?)r : null;
        _filterVerified = query.TryGetValue("verified", out var v) ? (string?)v : null;
        currentPage = query.TryGetValue("page", out var p) && int.TryParse(p, out var page) ? page : 1;
        PageSize = query.TryGetValue("size", out var s) && int.TryParse(s, out var size) ? size : 10;
        
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        ParseParametersFromUri();
        await LoadAsync(_searchTerm);
    }

    private async Task LoadAsync(string? searchTerm)
    {
        try
        {
            isLoading = true;

            // 1. Fetch entire accessible roster
            var allUsers = isAdmin
                ? await UserService.GetAllUsersWithRolesAsync()
                : companyId.HasValue
                    ? await UserService.GetUsersByCompanyWithRolesAsync(companyId.Value)
                    : new List<UserViewModel>();

            // 2. Apply Search Filter
            var filteredUsers = allUsers;
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filteredUsers = allUsers.Where(u =>
                        (u.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.Username?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.CompanyName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }

            // 2.5 Apply Dropdown Filters
            if (!string.IsNullOrWhiteSpace(_filterRole))
            {
                filteredUsers = filteredUsers.Where(u => u.Roles.Contains(_filterRole, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (!string.IsNullOrWhiteSpace(_filterVerified))
            {
                bool wantVerified = _filterVerified.Equals("Verified", StringComparison.OrdinalIgnoreCase);
                filteredUsers = filteredUsers.Where(u => u.IsConfirmed == wantVerified).ToList();
            }

            // 3. Calculate Pages
            totalPages = (int)Math.Ceiling(filteredUsers.Count / (double)PageSize);
            if (totalPages < 1) totalPages = 1;

            if (currentPage > totalPages) currentPage = totalPages; // Safety guard

            // 4. Extract current page slice
            pagedUsers = filteredUsers
                .Skip((currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching users: {ex.Message}");
            _statusMessage = "Error loading users.";
            _statusClass = "alert-danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearchInput()
    {
        currentPage = 1; // Always reset to page 1 when typing a new search
        var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            { "page", null }, // reset to page 1
            { "size", PageSize == 10 ? null : PageSize },
            { "q", string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm },
            { "role", string.IsNullOrWhiteSpace(_filterRole) ? null : _filterRole },
            { "verified", string.IsNullOrWhiteSpace(_filterVerified) ? null : _filterVerified }
        });
        await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", url);
        await LoadAsync(_searchTerm);
    }

    private void ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            { "page", page == 1 ? null : page },
            { "size", PageSize == 10 ? null : PageSize },
            { "q", string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm },
            { "role", string.IsNullOrWhiteSpace(_filterRole) ? null : _filterRole },
            { "verified", string.IsNullOrWhiteSpace(_filterVerified) ? null : _filterVerified }
        });
        Nav.NavigateTo(url);
    }

    private async Task ClearFilters()
    {
        _searchTerm = null;
        _filterRole = null;
        _filterVerified = null;
        await HandleSearchInput();
    }

    private void GoToView(string id)
    {
        Nav.NavigateTo($"/users/{id}");
    }

    private void GoToEdit(string id)
    {
        Nav.NavigateTo($"/users/edit/{id}");
    }

    private void ConfirmDelete(UserViewModel? userModel)
    {
        deleteTarget = userModel;
    }

    private bool isDeleting;

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget is null) return;

        try
        {
            isDeleting = true;
            await UserService.DeleteAsync(deleteTarget.UserId);
            deleteTarget = null;

            // Smart reload: go back one page if we delete the last item on the current page
            await LoadAsync(_searchTerm);
            if (pagedUsers.Count == 0 && currentPage > 1)
            {
                currentPage--;
                await LoadAsync(_searchTerm);
            }
        }
        finally
        {
            isDeleting = false;
        }
    }

}


