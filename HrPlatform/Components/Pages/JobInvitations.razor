@page "/driver/invitations"
@using System.Security.Claims
@using HrPlatform.Data.Entities
@using HrPlatform.Models
@attribute [Authorize(Roles = "Driver")]
@rendermode InteractiveServer
<TimezoneInitializer/>

@inject IJobInvitationService JobInvitationService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>My Job Invitations</PageTitle>

<div class="d-flex justify-content-between align-items-center gap-2 mb-4">
    <div class="d-flex align-items-center gap-3">
        <h3 class="mb-0">Job Invitations</h3>
        <span class="badge ">@(_paginationResult?.TotalCount ?? 0) invitation(s)</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
        <select class="form-select border-0 bg-white shadow-sm" style="width: 75px;" @bind="PageSize" @bind:after="OnPageSizeChanged">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (_loading || _paginationResult is null)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm"></div>
        Loading…
    </div>
}
else if (!_paginationResult.Items.Any())
{
    <div class="text-center text-muted py-5">
        <p class="fs-5">No job invitations yet.</p>
        <p class="small">You will receive an email when a manager invites you to a job.</p>
    </div>
}
else
{
    @if (_statusMessage is not null)
    {
        <div class="alert @_statusClass alert-dismissible mb-3">
            @_statusMessage
            <button type="button" class="btn-close"
                    @onclick="@(() => _statusMessage = null)"></button>
        </div>
    }

    <div>
        <div class="row g-3">
            @foreach (var inv in _paginationResult.Items)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 bg-white h-100 app-card">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <div class="d-flex align-items-center mb-2 gap-2">
                                        <h4 class="fw-bold mb-0 text-dark">@inv.Job.Title</h4>
                                        <span class="badge @(StatusBadgeClass(inv.Status)) rounded-pill px-3 py-1">@inv.Status</span>
                                    </div>

                                    <div class="mb-3 text-secondary small">
                                        <div class="d-flex align-items-center gap-3 mb-1">
                                            <span><i class="bi bi-building"></i> @DisplayCompanyName(inv.Job)</span>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 text-secondary small">
                                        <span class="badge bg-light text-dark rounded-pill px-3 py-2 border"><i class="bi bi-calendar-event me-1"></i> Invited: @TimeZoneService.ToUserTime(inv.CreatedAt).ToString("MMM dd, yyyy")</span>
                                        @if (inv.ReviewedAt.HasValue)
                                        {
                                            <span class="badge bg-light text-dark rounded-pill px-3 py-2 border"><i class="bi bi-reply me-1"></i> Responded: @TimeZoneService.ToUserTime(inv.ReviewedAt.Value).ToString("MMM dd, yyyy")</span>
                                        }
                                    </div>
                                </div>

                                <div class="col-md-5 d-flex gap-2 justify-content-md-end align-items-end flex-wrap mt-3 mt-md-0">
                                    @if (inv.Status == JobInvitationStatus.Pending)
                                    {
                                        <button class="btn btn-success px-4" @onclick="@(() => Respond(inv, JobInvitationStatus.Accepted))">
                                            <i class="bi bi-check-lg"></i> Accept
                                        </button>
                                        <button class="btn btn-outline-danger" @onclick="@(() => Respond(inv, JobInvitationStatus.Declined))">
                                            <i class="bi bi-x-lg"></i> Decline
                                        </button>
                                    }
                                    else if (inv.Status == JobInvitationStatus.Accepted)
                                    {
                                        <button class="btn btn-primary px-4" @onclick="@(() => GoToJobApply(inv.JobId))">
                                            Apply for This Job <i class="bi bi-arrow-right ms-1"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No further action required.</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .app-card {
                transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            }

            .app-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
            }
        </style>

        @if (_paginationResult.TotalPages > 1)
        {
            <nav aria-label="Job invitations pagination" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                    </li>

                    @for (var i = 1; i <= _paginationResult.TotalPages; i++)
                    {
                        var pageIndex = i;
                        <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                            <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                        </li>
                    }

                    <li class="page-item @(currentPage == _paginationResult.TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@code {
    private PaginationResult<JobInvitation>? _paginationResult;
    private bool _loading = true;
    private string? _statusMessage;
    private string _statusClass = "alert-success";
    private string? _userId;

    // Pagination State
    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 10;

    private string currentUserId = string.Empty;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = auth.User.IsInRole(RoleConstants.Admin);
        currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        _userId = currentUserId;
    }

    private string DisplayCompanyName(Job job)
    {
        if (job.IsConfidential && !isAdmin) return "CDL Pool Client";
        return job.Company?.Name ?? "—";
    }

    protected override async Task OnParametersSetAsync()
    {
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;

        if (_userId is not null)
            await LoadInvitations();

        _loading = false;
    }

    private async Task LoadInvitations()
    {
        _paginationResult = await JobInvitationService.GetForDriverPagedAsync(_userId!, currentPage, PageSize);
    }

    private void OnPageSizeChanged()
    {
        ChangePage(1);
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = page,
            ["size"] = PageSize
        });
        Nav.NavigateTo(uri);
    }

    private async Task Respond(JobInvitation inv, JobInvitationStatus status)
    {
        var ok = await JobInvitationService.UpdateStatusAsync(inv.Id, _userId!, status);

        if (ok)
        {
            SetStatus(status == JobInvitationStatus.Accepted
                ? "Invitation accepted. You can now apply for the job."
                : "Invitation declined.", true);
            await LoadInvitations();
        }
        else
        {
            SetStatus("Could not update invitation status.", false);
        }
    }

    private void GoToJobApply(int jobId)
    {
        Nav.NavigateTo($"/jobs/{jobId}");
    }

    private void SetStatus(string msg, bool success)
    {
        _statusMessage = msg;
        _statusClass = success ? "alert-success" : "alert-danger";
    }

    private static string StatusBadgeClass(JobInvitationStatus s)
    {
        return s switch
        {
            JobInvitationStatus.Pending => "bg-warning ",
            JobInvitationStatus.Accepted => "bg-success",
            JobInvitationStatus.Declined => "",
            _ => " "
        };
    }

    private static string CardBorderClass(JobInvitationStatus s)
    {
        return s switch
        {
            JobInvitationStatus.Accepted => "border-success",
            JobInvitationStatus.Declined => "border-secondary opacity-75",
            _ => ""
        };
    }

}

