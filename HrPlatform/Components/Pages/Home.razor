@page "/"
@using System.Security.Claims
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDriverProfileService ProfileService

@code {

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (!user.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/jobs", replace: true);
        }
        else if (user.IsInRole(RoleConstants.Admin) || user.IsInRole(RoleConstants.Manager))
        {
            Nav.NavigateTo("/dashboard", replace: true);
        }
        else if (user.IsInRole(RoleConstants.Driver))
        {
            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (userId != null)
            {
                var profile = await ProfileService.GetByUserIdAsync(userId);
                if (profile == null || !profile.IsApplicationCompleted)
                {
                    Nav.NavigateTo("/profiles/new", replace: true);
                    return;
                }
            }

            Nav.NavigateTo("/jobs", replace: true);
        }
        else
        {
            Nav.NavigateTo("/jobs", replace: true);
        }
    }

}

