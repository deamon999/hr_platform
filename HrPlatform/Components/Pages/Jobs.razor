@page "/"
@page "/jobs"
@using HrPlatform.Models
@rendermode InteractiveServer

@inject IJobService JobSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Jobs</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Jobs</h2>
    @if (IsPostJobVisible)
    {
        <button type="button" class="btn btn-primary" @onclick="GoToNewJob">+ Post Job</button>
    }
</div>

<div class="d-flex flex-wrap gap-3 mb-3 align-items-center">
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0">Filter:</label>
        <select class="form-select form-select-sm w-auto" @bind="filter" @bind:after="ResetPageAndLoad">
            <option value="all">All</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
        </select>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0">Sort:</label>
        <select class="form-select form-select-sm w-auto" @bind="sortBy" @bind:after="ResetPageAndLoad">
            <option value="date">Date Posted</option>
            <option value="title">Title</option>
            <option value="company">Company</option>
        </select>
    </div>
</div>

@if (paginationResult is null)
{
    <p>Loading...</p>
}
else if (!paginationResult.Items.Any())
{
    <div class="alert alert-info">No jobs found.</div>
}
else
{
    <div class="table-responsive d-none d-lg-block">
        <table class="table table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>Title</th>
                <th>Company</th>
                <th>Location</th>
                <th>Pay</th>
                <th>CDL</th>
                <th>Posted</th>
                <th>Status</th>
                <th>Apps</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var rowJob in paginationResult.Items)
            {
                <tr>
                    <td><strong>@rowJob.Title</strong></td>
                    <td>@(rowJob.Company?.Name ?? "")</td>
                    <td>@(rowJob.City != null ? $"{rowJob.City}, {rowJob.State}" : rowJob.State)</td>
                    <td>
                        @if (rowJob.PayRate.HasValue)
                        {
                            <span class="text-nowrap">$@rowJob.PayRate.Value.ToString("N2")/@rowJob.PayPeriod?.ToString().ToLower()</span>
                        }
                    </td>
                    <td>
                        @if (rowJob.RequiredCdlClass.HasValue)
                        {
                            <span class="badge bg-dark">CDL-@rowJob.RequiredCdlClass</span>
                        }
                    </td>
                    <td class="text-nowrap">@rowJob.PostedAt.ToLocalTime().ToString("MM/dd/yyyy")</td>
                    <td>
                        @if (rowJob.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                    <td>@rowJob.Applications.Count</td>
                    <td>
                        <div class="d-flex gap-1 flex-nowrap">
                            <button type="button" class="btn btn-sm btn-primary"
                                    @onclick="() => GoToDetails(rowJob.Id)">
                                View Details
                            </button>
                            @if (!isDriver)
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        @onclick="() => GoToEdit(rowJob.Id)">
                                    Edit
                                </button>
                                <button type="button"
                                        class="btn btn-sm @(rowJob.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                        @onclick="async () => await ToggleActiveAsync(rowJob.Id, rowJob.IsActive)"
                                        disabled="@(togglingJobId == rowJob.Id)">
                                    @(togglingJobId == rowJob.Id ? "Processing..." : rowJob.IsActive ? "Disable" : "Activate")
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="async () => ConfirmDelete(rowJob)">
                                    Delete
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="d-block d-lg-none">
        @foreach (var rowJob in paginationResult.Items)
        {
            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0 fw-bold">@rowJob.Title</h5>
                        <div>
                            @if (rowJob.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        @if (rowJob.Company != null && !string.IsNullOrEmpty(rowJob.Company.Name))
                        {
                            <div class="fw-bold text-primary">@rowJob.Company.Name</div>
                        }
                        <div class="text-muted small">
                            @(rowJob.City != null ? $"{rowJob.City}, {rowJob.State}" : rowJob.State)
                        </div>
                    </div>

                    <div class="card-text">
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="text-muted">Pay:</span>
                            <span class="fw-medium">
                                @if (rowJob.PayRate.HasValue)
                                {
                                    <span>$@rowJob.PayRate.Value.ToString("N2")/@rowJob.PayPeriod?.ToString().ToLower()</span>
                                }
                            </span>
                        </div>

                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="text-muted">CDL Required:</span>
                            <span>
                                @if (rowJob.RequiredCdlClass.HasValue)
                                {
                                    <span class="badge bg-dark">CDL-@rowJob.RequiredCdlClass</span>
                                }
                            </span>
                        </div>

                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="text-muted">Posted:</span>
                            <span>@rowJob.PostedAt.ToLocalTime().ToString("MM/dd/yyyy")</span>
                        </div>

                        <div class="d-flex justify-content-between pb-2">
                            <span class="text-muted">Applications:</span>
                            <span class="badge bg-light text-dark border">@rowJob.Applications.Count</span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
                        <button type="button" class="btn btn-sm btn-primary flex-grow-1"
                                @onclick="() => GoToDetails(rowJob.Id)">
                            View Details
                        </button>
                        @if (!isDriver)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1"
                                    @onclick="() => GoToEdit(rowJob.Id)">
                                Edit
                            </button>
                            <button type="button"
                                    class="btn btn-sm @(rowJob.IsActive ? "btn-outline-warning" : "btn-outline-success") flex-grow-1"
                                    @onclick="async () => await ToggleActiveAsync(rowJob.Id, rowJob.IsActive)"
                                    disabled="@(togglingJobId == rowJob.Id)">
                                @(togglingJobId == rowJob.Id ? "Processing..." : rowJob.IsActive ? "Disable" : "Activate")
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger flex-grow-1"
                                    @onclick="async () => ConfirmDelete(rowJob)">
                                Delete
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (paginationResult.TotalPages > 1)
    {
        <nav aria-label="Job list pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                </li>

                @for (int i = 1; i <= paginationResult.TotalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }

                <li class="page-item @(currentPage == paginationResult.TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@if (deleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    Delete <strong>@deleteTarget.Title</strong> at @(deleteTarget.Company?.Name ?? "")?
                    This will also remove all @deleteTarget.Applications.Count application(s).
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PaginationResult<Job>? paginationResult;

    // Filtering & Sorting State
    private string filter = "all";
    private string sortBy = "date";

    // Pagination State
    private int currentPage = 1;
    private const int PageSize = 10;

    // Component State
    private Job? deleteTarget;
    private bool IsPostJobVisible;
    private int? togglingJobId;
    private bool isDriver;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isDriver = user.IsInRole("Driver");
        IsPostJobVisible = (user.IsInRole("Manager") && user.FindFirst("companyId") != null) || user.IsInRole("Admin");

        await LoadAsync();
    }

    private async Task ResetPageAndLoad()
    {
        // Drop down to page 1 if a sort/filter changes
        currentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        paginationResult = await JobSvc.GetPagedAsync(currentPage, PageSize, filter, sortBy);
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > (paginationResult?.TotalPages ?? 1)) return;
        currentPage = page;
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(int jobId, bool currentActive)
    {
        togglingJobId = jobId;
        try
        {
            await JobSvc.SetActiveAsync(jobId, !currentActive);
            await LoadAsync();
        }
        finally
        {
            togglingJobId = null;
        }
    }

    private void GoToNewJob()
    {
        Nav.NavigateTo("/jobs/new");
    }

    private void GoToDetails(int id)
    {
        Nav.NavigateTo($"/jobs/{id}");
    }

    private void GoToEdit(int id)
    {
        Nav.NavigateTo($"/jobs/edit/{id}");
    }

    private void ConfirmDelete(Job job)
    {
        deleteTarget = job;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget is null) return;
        await JobSvc.DeleteAsync(deleteTarget.Id);
        deleteTarget = null;

        // Smart reload: go back one page if we delete the last item on the current page
        await LoadAsync();
        if (paginationResult?.Items.Any() == false && currentPage > 1)
        {
            currentPage--;
            await LoadAsync();
        }
    }

}