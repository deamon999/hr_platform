@page "/jobs"
@using HrPlatform.Models
@rendermode InteractiveServer

@inject IJobService JobSvc
@inject IDriverProfileService ProfileSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Jobs</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Jobs</h2>
    @if (IsPostJobVisible)
    {
        <button type="button" class="btn btn-primary" @onclick="GoToNewJob">+ Post Job</button>
    }
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm w-auto" style="min-width: 160px;" @bind="filter" @bind:after="ResetPageAndLoad">
                <option value="all">Any Status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm w-auto" style="min-width: 160px;" @bind="filterCdlClassString" @bind:after="ResetPageAndLoad">
                <option value="">Any CDL Class</option>
                @foreach (var c in Enum.GetValues<CdlClass>())
                { <option value="@c.ToString()">CDL-@c</option> }
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <input type="number" class="form-control form-control-sm" style="max-width:130px" placeholder="$ Min Pay" @bind="filterMinPay" @bind:after="ResetPageAndLoad"/>
        </div>

        <div class="d-flex align-items-center gap-2">
            <select class="form-select form-select-sm w-auto" style="min-width: 180px;" @bind="sortBy" @bind:after="ResetPageAndLoad">
                <option value="date">Sort: Date Posted</option>
                <option value="pay">Sort: Pay Rate</option>
            </select>
        </div>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (isDriver && driverProfile != null)
        {
            <button class="btn btn-sm @(matchProfile ? "btn-primary" : "btn-outline-primary")" @onclick="ToggleMatchProfile">
                Jobs for me
            </button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters">
            Reset Filters
        </button>
        
        <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline ms-2">Items per page:</span>
        <select class="form-select form-select-sm border-0 bg-white shadow-sm" style="width: 70px;" @bind="PageSize" @bind:after="ResetPageAndLoad">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (paginationResult is null)
{
    <p>Loading...</p>
}
else if (!paginationResult.Items.Any())
{
    <div class="alert alert-info">No jobs found.</div>
}
else
{
    <div class="row g-3">
        @foreach (var rowJob in paginationResult.Items)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 bg-white h-100 job-card">
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h4 class="fw-bold mb-0 text-dark">@rowJob.Title</h4>
                                </div>
                                <h6 class="text-primary mb-2">@(rowJob.Company?.Name ?? "Unknown Company")</h6>
                                <div class="text-secondary small mb-3">
                                    <span class="me-3"><i class="bi bi-geo-alt"></i> @(rowJob.City != null ? $"{rowJob.City}, {rowJob.State}" : rowJob.State)</span>
                                    <span class="me-3"><i class="bi bi-clock"></i> Posted @rowJob.PostedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                    @if (rowJob.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-2">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill px-2">Inactive</span>
                                    }
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (rowJob.RequiredCdlClass.HasValue)
                                    {
                                        <span class="badge bg-dark rounded-pill px-3 py-2"><i class="bi bi-truck"></i> Class @rowJob.RequiredCdlClass</span>
                                    }
                                    @if (rowJob.SignOnBonus > 0)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-gift"></i> Bonus</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4 text-md-end d-flex flex-column justify-content-between">
                                <div>
                                    <div class="text-muted small text-uppercase fw-bold mb-1">Compensation</div>
                                    <div class="fs-5 fw-bold text-success">
                                        @if (rowJob.PayRate.HasValue)
                                        {
                                            @FormatCompensation(rowJob)
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </div>
                                    <div class="text-secondary small mt-2">
                                        <i class="bi bi-people"></i> @rowJob.Applications.Count Applicants
                                    </div>
                                </div>
                                <div class="mt-3 d-flex gap-2 justify-content-md-end flex-wrap">
                                    <button type="button" class="btn btn-primary px-4" @onclick="() => GoToDetails(rowJob.Id)">
                                        View
                                    </button>
                                    @if (!isDriver)
                                    {
                                        <button type="button" class="btn btn-outline-primary" @onclick="() => GoToEdit(rowJob.Id)">
                                            Edit
                                        </button>
                                        <button type="button" class="btn @(rowJob.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                @onclick="async () => await ToggleActiveAsync(rowJob.Id, rowJob.IsActive)"
                                                disabled="@(togglingJobId == rowJob.Id)">
                                            @(togglingJobId == rowJob.Id ? "..." : rowJob.IsActive ? "Disable" : "Activate")
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" @onclick="async () => ConfirmDelete(rowJob)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <style>
        .job-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .job-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        }
    </style>

    @if (paginationResult.TotalPages > 1)
    {
        <nav aria-label="Job list pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                </li>

                @for (int i = 1; i <= paginationResult.TotalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }

                <li class="page-item @(currentPage == paginationResult.TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@if (deleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    Delete <strong>@deleteTarget.Title</strong> at @(deleteTarget.Company?.Name ?? "")?
                    This will also remove all @deleteTarget.Applications.Count application(s).
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PaginationResult<Job>? paginationResult;

    // Filtering & Sorting State
    [SupplyParameterFromQuery(Name = "filter")]
    public string filter { get; set; } = "all";

    [SupplyParameterFromQuery(Name = "sort")]
    public string sortBy { get; set; } = "date";

    [SupplyParameterFromQuery(Name = "cdl")]
    public string? filterCdlClassString { get; set; }

    [SupplyParameterFromQuery(Name = "min")]
    public decimal? filterMinPay { get; set; }

    [SupplyParameterFromQuery(Name = "match")]
    public bool matchProfile { get; set; }

    private DriverProfile? driverProfile;

    // Pagination State
    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 10;

    // Component State
    private Job? deleteTarget;
    private bool IsPostJobVisible;
    private int? togglingJobId;
    private bool isDriver;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        isDriver = user.IsInRole("Driver");
        IsPostJobVisible = (user.IsInRole("Manager") && user.FindFirst("companyId") != null) || user.IsInRole("Admin");

        var currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (isDriver && currentUserId != null)
        {
            driverProfile = await ProfileSvc.GetByUserIdAsync(currentUserId);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;
        await LoadAsync();
    }

    private void ResetPageAndLoad()
    {
        ChangePage(1);
    }

    private void ResetFilters()
    {
        filter = "all";
        sortBy = "date";
        filterCdlClassString = null;
        filterMinPay = null;
        matchProfile = false;
        ResetPageAndLoad();
    }

    private void ToggleMatchProfile()
    {
        matchProfile = !matchProfile;
        ResetPageAndLoad();
    }

    private async Task LoadAsync()
    {
        CdlClass? parsedCdl = null;
        if (Enum.TryParse<CdlClass>(filterCdlClassString, out var p))
        {
            parsedCdl = p;
        }

        paginationResult = await JobSvc.GetPagedAsync(
            currentPage, PageSize, filter, sortBy,
            cdlClass: parsedCdl,
            minPay: filterMinPay,
            matchProfileOnly: matchProfile,
            driverProfile: driverProfile);
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = page,
            ["size"] = PageSize,
            ["filter"] = filter == "all" ? null : filter,
            ["sort"] = sortBy == "date" ? null : sortBy,
            ["cdl"] = filterCdlClassString,
            ["min"] = filterMinPay,
            ["match"] = matchProfile ? true : (bool?)null
        });
        Nav.NavigateTo(uri);
    }

    private async Task ToggleActiveAsync(int jobId, bool currentActive)
    {
        togglingJobId = jobId;
        try
        {
            await JobSvc.SetActiveAsync(jobId, !currentActive);
            await LoadAsync();
        }
        finally
        {
            togglingJobId = null;
        }
    }

    private void GoToNewJob()
    {
        Nav.NavigateTo("/jobs/new");
    }

    private void GoToDetails(int id)
    {
        Nav.NavigateTo($"/jobs/{id}");
    }

    private void GoToEdit(int id)
    {
        Nav.NavigateTo($"/jobs/edit/{id}");
    }

    private void ConfirmDelete(Job job)
    {
        deleteTarget = job;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget is null) return;
        await JobSvc.DeleteAsync(deleteTarget.Id);
        deleteTarget = null;

        // Smart reload: go back one page if we delete the last item on the current page
        await LoadAsync();
        if (paginationResult?.Items.Any() == false && currentPage > 1)
        {
            currentPage--;
            await LoadAsync();
        }
    }

    private static string FormatCompensation(Job? job)
    {
        if (job == null || !job.PayRate.HasValue) return "Not specified";
        
        return job.PayPeriod switch
        {
            PayPeriod.Mile => $"{job.PayRate:N0} CPM",
            PayPeriod.PercentageOfLoad => $"{job.PayRate:N0}% of Load",
            PayPeriod.Hour => $"${job.PayRate:N2} / hr",
            PayPeriod.Week => $"${job.PayRate:N2} / wk",
            PayPeriod.Month => $"${job.PayRate:N2} / mo",
            PayPeriod.Year => $"${job.PayRate:N0} / yr",
            _ => $"${job.PayRate:N2}"
        };
    }
}


