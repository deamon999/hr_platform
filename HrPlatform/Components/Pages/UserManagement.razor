@page "/users"
@page "/invitations"
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]

<PageTitle>User Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">User Management</h3>
</div>

<div class="mb-4">
    <div class="d-flex gap-3 mb-4 pb-3 border-bottom">
        <button class="btn @(activeTab == "users" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-5"
                @onclick='@(() => NavManager.NavigateTo("/users"))'>
            Users
        </button>
        <button class="btn @(activeTab == "invitations" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-5"
                @onclick='@(() => NavManager.NavigateTo("/users?tab=invitations"))'>
            Invitations
        </button>
    </div>

    <div>
        @if (activeTab == "users")
        {
            <UserList/>
        }
        else if (activeTab == "invitations")
        {
            <InvitationList/>
        }
    </div>
</div>



@code {
    [Inject] private NavigationManager NavManager { get; set; } = default!;

    private string? Tab;
    private string activeTab = "users";

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
        ParseTabFromUri();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ParseTabFromUri();
        StateHasChanged();
    }

    private void ParseTabFromUri()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        
        if (uri.AbsolutePath.Equals("/invitations", StringComparison.OrdinalIgnoreCase))
        {
            Tab = "invitations";
        }
        else if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("Tab", out var tabValue))
        {
            Tab = tabValue;
        }
        else
        {
            Tab = null;
        }

        if (string.Equals(Tab, "invitations", StringComparison.OrdinalIgnoreCase))
        {
            activeTab = "invitations";
        }
        else
        {
            activeTab = "users";
        }
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }

}
