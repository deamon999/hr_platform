@page "/users"
@rendermode InteractiveServer
@using HrPlatform.Models
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]

<PageTitle>User Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">User Management</h3>
</div>

<div class="mb-4">
    <ul class="nav nav-tabs nav-fill border-bottom mb-4" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "users" ? "active fw-bold border-bottom border-primary border-3 text-primary" : "text-secondary border-0") py-3" 
                    @onclick="@(() => activeTab = "users")" type="button" role="tab" style="background: transparent;">
                Users
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == "invitations" ? "active fw-bold border-bottom border-primary border-3 text-primary" : "text-secondary border-0") py-3" 
                    @onclick="@(() => activeTab = "invitations")" type="button" role="tab" style="background: transparent;">
                Invitations
            </button>
        </li>
    </ul>

    <div>
        @if (activeTab == "users")
        {
            <UserList />
        }
        else if (activeTab == "invitations")
        {
            <InvitationList />
        }
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        border-radius: 0;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? Tab { get; set; }

    private string activeTab = "users";

    protected override void OnParametersSet()
    {
        if (string.Equals(Tab, "invitations", StringComparison.OrdinalIgnoreCase))
        {
            activeTab = "invitations";
        }
        else
        {
            activeTab = "users";
        }
    }
}
