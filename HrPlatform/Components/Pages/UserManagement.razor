@page "/user-management"
@rendermode InteractiveServer
@using HrPlatform.Models
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]

<PageTitle>User Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">User Management</h3>
</div>

<div class="card mb-4 border-0">
    <div class="card-header border-bottom border-secondary bg-transparent p-0">
        <ul class="nav nav-tabs nav-fill border-0" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "users" ? "active bg-secondary fw-bold text-white" : "text-white-50") border-0 rounded-top" 
                        @onclick="@(() => activeTab = "users")" type="button" role="tab">
                    Users
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "invitations" ? "active bg-secondary fw-bold text-white" : "text-white-50") border-0 rounded-top" 
                        @onclick="@(() => activeTab = "invitations")" type="button" role="tab">
                    Invitations
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        @if (activeTab == "users")
        {
            <UserList />
        }
        else if (activeTab == "invitations")
        {
            <InvitationList />
        }
    </div>
</div>

@code {
    private string activeTab = "users";
}
