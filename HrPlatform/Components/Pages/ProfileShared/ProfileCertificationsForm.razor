@using HrPlatform.Data.Models
@using HrPlatform.Services
@using System.Security.Claims

@inject IDocumentStorageService StorageSvc
@inject IDriverProfileService ProfileService
@inject AuthenticationStateProvider AuthState

<div>
    @if (!Profile.Certifications.Any())
    {
        <div class="text-center text-muted py-5 border rounded-3 bg-light mb-4">
            <i class="bi bi-award fs-1 text-secondary mb-3 d-block"></i>
            <p class="fs-5 mb-0">No certifications available.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var (cert, i) in Profile.Certifications.Select((c, i) => (c, i)))
            {
                <div class="col-12">
                    <div class="card shadow-none border bg-light">
                        <div class="card-header bg-white border-bottom fw-bold text-dark d-flex justify-content-between align-items-center py-3">
                            <span>@(string.IsNullOrEmpty(cert.Name) ? $"Certification #{i + 1}" : cert.Name)</span>
                            @if(!IsReadOnly) {
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => Profile.Certifications.Remove(cert)"><i class="bi bi-trash me-1"></i> Remove</button>
                            }
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-secondary small text-uppercase">Certification Name *</label>
                                    <InputText disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="cert.Name"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-secondary small text-uppercase">Issuing Authority</label>
                                    <InputText disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="cert.IssuingAuthority"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold text-secondary small text-uppercase">Certification Number</label>
                                    <InputText disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="cert.CertificationNumber"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold text-secondary small text-uppercase">Issued Date</label>
                                    <InputDate disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="cert.IssuedDate"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold text-secondary small text-uppercase">Expiration Date</label>
                                    <InputDate disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="cert.ExpiryDate"/>
                                    <div class="form-text mt-1"><i class="bi bi-info-circle me-1"></i> Leave blank if it doesn't expire</div>
                                </div>
                                <div class="col-12 mt-4 pt-3 border-top border-secondary border-opacity-25">
                                    <label class="form-label fw-semibold text-secondary small text-uppercase">Certification Document</label>
                                    @if (cert.HasDocument)
                                    {
                                        <div class="d-flex align-items-center gap-3 bg-white p-3 rounded-3 shadow-sm">
                                            <span class="text-success fw-medium"><i class="bi bi-check-circle-fill me-1"></i> Document uploaded</span>
                                            <a class="btn btn-sm btn-outline-primary rounded-pill px-3 ms-auto" href="@(certUrls.GetValueOrDefault(cert.Id))" target="_blank"><i class="bi bi-eye me-1"></i> View</a>
                                            @if (!IsReadOnly)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => DeleteDocumentAsync(cert)"><i class="bi bi-trash me-1"></i> Remove</button>
                                            }
                                        </div>
                                    }
                                    else if (!IsReadOnly)
                                    {
                                        <InputFile class="form-control bg-white border-0 shadow-sm" accept=".pdf,.jpg,.jpeg,.png" OnChange="@(e => UploadDocumentAsync(e, cert))"/>
                                        <small class="text-muted mt-2 d-block"><i class="bi bi-paperclip me-1"></i> PDF, JPG, or PNG. Max 5 MB.</small>
                                    }
                                    else
                                    {
                                        <div class="text-muted small fst-italic">No document uploaded.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    @if(!IsReadOnly) {
        <button type="button" class="btn btn-outline-primary rounded-pill px-4 fw-medium shadow-sm" @onclick="AddCertification"><i class="bi bi-plus-circle me-1"></i> Add Certification</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
    
    private Dictionary<int, string> certUrls = new();

    protected override async Task OnParametersSetAsync()
    {
        foreach (var cert in Profile.Certifications.Where(c => c.HasDocument))
        {
            if (!certUrls.ContainsKey(cert.Id))
            {
                certUrls[cert.Id] = await StorageSvc.GetSignedUrlAsync(cert.DocumentBlobPath!);
            }
        }
    }

    private void AddCertification()
    {
        Profile.Certifications.Add(new DriverCertification());
    }

    private async Task UploadDocumentAsync(InputFileChangeEventArgs e, DriverCertification cert)
    {
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024) return;

        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        var folder = $"certifications/{Profile.UserId}";
        cert.DocumentBlobPath = await StorageSvc.UploadAsync(stream, file.Name, file.ContentType, folder);
        cert.DocumentUploadedAt = DateTime.UtcNow;
        
        await SaveProfileAsync();
        certUrls[cert.Id] = await StorageSvc.GetSignedUrlAsync(cert.DocumentBlobPath);
    }

    private async Task DeleteDocumentAsync(DriverCertification cert)
    {
        if (cert.DocumentBlobPath is null) return;
        await StorageSvc.DeleteAsync(cert.DocumentBlobPath);
        cert.DocumentBlobPath = null;
        cert.DocumentUploadedAt = null;
        certUrls.Remove(cert.Id);
        await SaveProfileAsync();
    }

    private async Task SaveProfileAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)!.Value;
        if (Profile.Id > 0) 
        {
            await ProfileService.UpdateAsync(Profile, currentUserId);
        }
    }
}
