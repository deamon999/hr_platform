@using HrPlatform.Data.Entities

<div>
    <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center bg-light">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-primary"></i>
        <div>
            <strong>Optional Documents:</strong> You may upload any additional certifications, training records, or TWIC cards here.
        </div>
    </div>

    @if (!Profile.Documents.Any())
    {
        <div class="text-center text-muted py-5 border rounded-3 bg-light mb-4">
            <i class="bi bi-file-earmark-text fs-1 text-secondary mb-3 d-block"></i>
            <p class="fs-5 mb-0">No documents uploaded yet.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            @foreach (var doc in OtherDocs)
            {
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-3 bg-light p-3 rounded-3 shadow-none border">
                        <i class="bi bi-file-earmark-pdf fs-3 text-danger"></i>
                        <div class="flex-grow-1 text-truncate">
                            <div class="fw-medium text-truncate">@doc.FileName</div>
                            <small class="text-muted">@doc.DocumentType • @TimeZoneService.ToUserTime(doc.UploadedAt).ToString("g")</small>
                        </div>
                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(doc.Id) && !doc.IsUnsaved)
                            {
                                <button type="button" @onclick="() => PreviewDocument(doc)"
                                        class="btn btn-sm btn-outline-primary rounded-pill px-3 me-2" title="View Document">
                                    <i class="bi bi-eye"></i>
                                </button>
                            }
                            @if (!IsReadOnly)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                        @onclick="() => DeleteDocumentAsync(doc)" title="Delete Document"><i class="bi bi-trash"></i></button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!IsReadOnly)
    {
        <div class="card shadow-none border bg-light mt-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3">Upload New Document</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Document Type *</label>
                        <select class="form-select bg-white border-0 shadow-sm" @bind="newDocType">
                            <option value="TWIC">TWIC Card</option>
                            <option value="Training">Training Certificate</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Select File *</label>
                        <InputFile class="form-control bg-white border-0 shadow-sm" accept=".pdf,.jpg,.jpeg,.png" OnChange="HandleFileSelected"/>
                        <small class="text-muted mt-2 d-block"><i class="bi bi-paperclip me-1"></i> PDF, JPG, or PNG. Max 5 MB.</small>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (showPreviewModal && previewDoc != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg bg-dark">
                    <div class="modal-header border-secondary border-bottom">
                        <h5 class="modal-title text-white">@previewDoc.FileName</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="ClosePreview"></button>
                    </div>
                    <div class="modal-body p-0" style="height: 70vh;">
                        @if (previewDoc.ContentType.StartsWith("image/"))
                        {
                            <div class="w-100 h-100 d-flex justify-content-center align-items-center bg-black">
                                <img src="@previewUrl" alt="@previewDoc.FileName"
                                     style="max-width: 100%; max-height: 100%; object-fit: contain;"/>
                            </div>
                        }
                        else
                        {
                            <iframe src="@previewUrl" style="width: 100%; height: 100%; border: none;"></iframe>
                        }
                    </div>
                    <div class="modal-footer border-secondary border-top">
                        <a href="@previewUrl" target="_blank" download="@previewDoc.FileName" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-download me-2"></i> Download
                        </a>
                        <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="ClosePreview">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter][EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
    [Inject] private IDocumentStorageService StorageService { get; set; } = default!;

    private IEnumerable<DocumentFile> OtherDocs => Profile.Documents.Where(d => d.DocumentType != "CDL License" && d.DocumentType != "Medical Card");

    private string newDocType = "TWIC";
    private bool showPreviewModal;
    private DocumentFile? previewDoc;
    private string previewUrl = "";

    private async Task PreviewDocument(DocumentFile doc)
    {
        previewDoc = doc;
        previewUrl = await StorageService.GetSignedUrlAsync(doc.Id);
        showPreviewModal = true;
    }

    private void ClosePreview()
    {
        showPreviewModal = false;
        previewDoc = null;
        previewUrl = "";
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024) return;

        using var stream = file.OpenReadStream(5 * 1024 * 1024);
        var blobId = await StorageService.UploadAsync(stream, file.Name, file.ContentType, Profile.Id.ToString());

        var docFile = new DocumentFile
        {
            Id = blobId,
            DriverProfileId = Profile.Id,
            DocumentType = newDocType,
            FileName = file.Name,
            ContentType = file.ContentType,
            FilePath = $"{Profile.Id}/{blobId}",
            UploadedAt = DateTime.UtcNow,
            IsUnsaved = true
        };

        Profile.Documents.Add(docFile);
    }

    private Task DeleteDocumentAsync(DocumentFile doc)
    {
        Profile.Documents.Remove(doc);
        return Task.CompletedTask;
    }

}
