@using HrPlatform.Data.Models
@using HrPlatform.Data.Enums

<div class="card shadow-sm border-0" style="background-color: #1a1b1e; color: #e9ecef; border-radius: 12px;">
    <div class="card-body p-4 p-md-5">

        <h5 class="fw-bold mb-4" style="color: #e9ecef;">Preferences</h5>
        
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-uppercase" style="color: #adb5bd;">Preferred Position</label>
                <InputSelect disabled="@IsReadOnly" class="form-select border-0 shadow-sm" style="background-color: #2b2d31; color: #e9ecef;" @bind-Value="Profile.PreferredPosition">
                    <option value="">Any</option>
                    <option value="Company Driver">Company Driver</option>
                    <option value="Owner Operator">Owner Operator</option>
                    <option value="Lease Purchase">Lease Purchase</option>
                </InputSelect>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold small" style="color: #adb5bd;">Preferred Route Type</label>
                <InputSelect disabled="@IsReadOnly" class="form-select border-0 shadow-sm" style="background-color: #2b2d31; color: #e9ecef;" @bind-Value="Profile.PreferredRouteType">
                    <option value="">No Preference</option>
                    @foreach (var rt in Enum.GetValues<RouteType>())
                    {
                        <option value="@rt">@rt.ToString()</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-uppercase" style="color: #adb5bd;">Minimum Weekly Pay</label>
                <div class="position-relative">
                    <InputSelect disabled="@IsReadOnly" class="form-select border-0 shadow-sm" style="background-color: #2b2d31; color: #e9ecef;" @bind-Value="Profile.MinimumWeeklyPay">
                        <option value="">Any</option>
                        <option value="$1,000 - $1,499">$1,000 - $1,499</option>
                        <option value="$1,500 - $1,999">$1,500 - $1,999</option>
                        <option value="$2,000 - $2,499">$2,000 - $2,499</option>
                        <option value="$2,500+">$2,500+</option>
                    </InputSelect>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-uppercase" style="color: #adb5bd;">Available Start Date</label>
                <InputDate disabled="@IsReadOnly" class="form-control border-0 shadow-sm" style="background-color: #2b2d31; color: #e9ecef;" @bind-Value="Profile.AvailableStartDate" />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold mb-3" style="color: #f6c042;">Preferred Freight</label>
            <div class="d-flex flex-wrap gap-4">
                @foreach (var freight in new[] { "Reefer", "Flatbed", "Dry Van", "Car Hauling", "Open Deck", "Other" })
                {
                    <div class="form-check custom-checkbox">
                        <input class="form-check-input" type="checkbox" disabled="@IsReadOnly" 
                               id="freight_@freight.Replace(" ", "")" 
                               checked="@(Profile.PreferredFreight?.Contains(freight) ?? false)"
                               @onchange="@(e => ToggleFreight(freight, e))" />
                        <label class="form-check-label" for="freight_@freight.Replace(" ", "")">@freight</label>
                    </div>
                }
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold mb-3" style="color: #f6c042;">Preferred Regions</label>
            <div class="d-flex flex-wrap gap-4">
                @foreach (var region in new[] { "Midwest", "Southeast", "Northeast", "West Coast", "Southwest", "Other" })
                {
                    <div class="form-check custom-checkbox">
                        <input class="form-check-input" type="checkbox" disabled="@IsReadOnly" 
                               id="region_@region.Replace(" ", "")" 
                               checked="@(Profile.PreferredRegions?.Contains(region) ?? false)"
                               @onchange="@(e => ToggleRegion(region, e))" />
                        <label class="form-check-label" for="region_@region.Replace(" ", "")">@region</label>
                    </div>
                }
            </div>
        </div>

        <div class="mb-5">
            <label class="form-label fw-bold mb-3" style="color: #f6c042;">Additional Preferences</label>
            <div class="d-flex flex-wrap gap-4">
                <div class="form-check custom-checkbox">
                    <input class="form-check-input" type="checkbox" disabled="@IsReadOnly" 
                           id="chkPets" 
                           checked="@Profile.WantsToDriveWithPets"
                           @onchange="@(e => Profile.WantsToDriveWithPets = (bool)(e.Value ?? false))" />
                    <label class="form-check-label" for="chkPets">Willing to Take Pets</label>
                </div>
                <div class="form-check custom-checkbox">
                    <input class="form-check-input" type="checkbox" disabled="@IsReadOnly" 
                           id="chkRiders" 
                           checked="@Profile.WantsToDriveWithRiders"
                           @onchange="@(e => Profile.WantsToDriveWithRiders = (bool)(e.Value ?? false))" />
                    <label class="form-check-label" for="chkRiders">Willing to Take a Rider</label>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .custom-checkbox .form-check-input {
        background-color: #2b2d31;
        border-color: #495057;
    }
    .custom-checkbox .form-check-input:checked {
        background-color: #f6c042;
        border-color: #f6c042;
    }
    .custom-checkbox .form-check-label {
        color: #adb5bd;
    }
    /* Switch styling to put toggle on right if needed */
    .form-switch .form-check-input {
        width: 2.5em;
        height: 1.25em;
    }
    .form-switch .form-check-input:checked {
        background-color: #f6c042;
        border-color: #f6c042;
    }
</style>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
    
    protected override void OnInitialized()
    {
        Profile.PreferredFreight ??= new List<string>();
        Profile.PreferredRegions ??= new List<string>();
    }

    private void ToggleFreight(string freight, ChangeEventArgs e)
    {
        if (IsReadOnly) return;
        
        bool isChecked = (bool)(e.Value ?? false);
        Profile.PreferredFreight ??= new List<string>();
        
        if (isChecked && !Profile.PreferredFreight.Contains(freight))
            Profile.PreferredFreight.Add(freight);
        else if (!isChecked && Profile.PreferredFreight.Contains(freight))
            Profile.PreferredFreight.Remove(freight);
    }

    private void ToggleRegion(string region, ChangeEventArgs e)
    {
        if (IsReadOnly) return;
        
        bool isChecked = (bool)(e.Value ?? false);
        Profile.PreferredRegions ??= new List<string>();
        
        if (isChecked && !Profile.PreferredRegions.Contains(region))
            Profile.PreferredRegions.Add(region);
        else if (!isChecked && Profile.PreferredRegions.Contains(region))
            Profile.PreferredRegions.Remove(region);
    }
}
