@using HrPlatform.Data.Models
@using HrPlatform.Data.Enums
@using HrPlatform.Utils
@using HrPlatform.Services
@using System.Security.Claims

@inject IDocumentStorageService StorageSvc
@inject IDriverProfileService ProfileService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<div>
    <h5 class="mb-4 text-primary fw-bold">Driver License</h5>
    
    @if (Profile.License == null)
    {
        if(!IsReadOnly) {
            <button type="button" class="btn btn-outline-primary rounded-pill px-4 fw-medium shadow-sm mb-5" @onclick="() => Profile.License = new DriverLicense()"><i class="bi bi-plus-circle me-1"></i> Add License</button>
        } else {
            <div class="text-muted fst-italic mb-5">No license information provided.</div>
        }
    }
    else
    {
        <div class="card shadow-sm border-0 bg-light mb-5">
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">License Number *</label>
                        <InputText disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="Profile.License.LicenseNumber"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Issuing State *</label>
                        <InputText disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" maxlength="2" @bind-Value="Profile.License.IssuingState"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">CDL Class *</label>
                        <InputSelect disabled="@IsReadOnly" class="form-select bg-white border-0 shadow-sm" @bind-Value="Profile.License.Class">
                            @foreach (var c in Enum.GetValues<CdlClass>())
                            {
                                <option value="@c">Class @c</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Issued Date *</label>
                        <InputDate disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="Profile.License.IssuedDate"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Expiration Date *</label>
                        <InputDate disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="Profile.License.ExpiryDate"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Restrictions</label>
                        <InputText disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="Profile.License.Restrictions"/>
                    </div>
                    <div class="col-12 mt-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase d-block mb-3">Endorsements</label>
                        <div class="d-flex flex-wrap gap-3">
                            @foreach (var end in Enum.GetValues<CdlEndorsement>())
                            {
                                <div class="form-check">
                                    <input type="checkbox" disabled="@IsReadOnly" class="form-check-input" id="end_@end" 
                                           checked="@Profile.License.HasEndorsement(end)" 
                                           @onchange="e => ToggleEndorsement(end, (bool)e.Value!)" />
                                    <label class="form-check-label fw-medium" for="end_@end">@end.GetDescriptionValue()</label>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="col-12 mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">CDL Document</label>
                        @if (Profile.License.HasDocument)
                        {
                            <div class="d-flex align-items-center gap-3 bg-white p-3 rounded-3 shadow-sm">
                                <span class="text-success fw-medium"><i class="bi bi-check-circle-fill me-1"></i> Document uploaded</span>
                                <a class="btn btn-sm btn-outline-primary rounded-pill px-3 ms-auto" href="@licenseUrl" target="_blank"><i class="bi bi-eye me-1"></i> View</a>
                                @if (!IsReadOnly)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="DeleteLicenseDocumentAsync"><i class="bi bi-trash me-1"></i> Remove</button>
                                }
                            </div>
                        }
                        else if (!IsReadOnly)
                        {
                            <InputFile class="form-control bg-white border-0 shadow-sm" accept=".pdf,.jpg,.jpeg,.png" OnChange="UploadLicenseDocumentAsync"/>
                            <small class="text-muted mt-2 d-block"><i class="bi bi-paperclip me-1"></i> PDF, JPG, or PNG. Max 5 MB.</small>
                        }
                        else
                        {
                            <div class="text-muted small fst-italic">No document uploaded.</div>
                        }
                    </div>
                    
                    @if(!IsReadOnly) {
                        <div class="col-12 mt-4 text-end">
                            <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-medium" @onclick="() => Profile.License = null"><i class="bi bi-trash me-1"></i> Remove License</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <h5 class="mb-4 text-primary fw-bold">DOT Medical Card</h5>
    
    @if (Profile.MedicalCard == null)
    {
        if(!IsReadOnly) {
            <button type="button" class="btn btn-outline-primary rounded-pill px-4 fw-medium shadow-sm" @onclick="() => Profile.MedicalCard = new DriverMedicalCard()"><i class="bi bi-plus-circle me-1"></i> Add Medical Card</button>
        } else {
            <div class="text-muted fst-italic">No medical card provided.</div>
        }
    }
    else
    {
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Examiner Name *</label>
                        <InputText disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="Profile.MedicalCard.MedicalExaminerName"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Registry Number</label>
                        <InputText disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="Profile.MedicalCard.MedicalExaminerCertNumber"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Expiration Date *</label>
                        <InputDate disabled="@IsReadOnly" class="form-control bg-white border-0 shadow-sm" @bind-Value="Profile.MedicalCard.ExpiryDate"/>
                    </div>

                    <div class="col-12 mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">DOT Medical Card Document</label>
                        @if (Profile.MedicalCard.HasDocument)
                        {
                            <div class="d-flex align-items-center gap-3 bg-white p-3 rounded-3 shadow-sm">
                                <span class="text-success fw-medium"><i class="bi bi-check-circle-fill me-1"></i> Document uploaded</span>
                                <a class="btn btn-sm btn-outline-primary rounded-pill px-3 ms-auto" href="@medicalCardUrl" target="_blank"><i class="bi bi-eye me-1"></i> View</a>
                                @if (!IsReadOnly)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="DeleteMedicalCardDocumentAsync"><i class="bi bi-trash me-1"></i> Remove</button>
                                }
                            </div>
                        }
                        else if (!IsReadOnly)
                        {
                            <InputFile class="form-control bg-white border-0 shadow-sm" accept=".pdf,.jpg,.jpeg,.png" OnChange="UploadMedicalCardDocumentAsync"/>
                            <small class="text-muted mt-2 d-block"><i class="bi bi-paperclip me-1"></i> PDF, JPG, or PNG. Max 5 MB.</small>
                        }
                        else
                        {
                            <div class="text-muted small fst-italic">No document uploaded.</div>
                        }
                    </div>
                    
                    @if(!IsReadOnly) {
                        <div class="col-12 mt-4 text-end">
                            <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-medium" @onclick="() => Profile.MedicalCard = null"><i class="bi bi-trash me-1"></i> Remove Medical Card</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
    
    private string? licenseUrl;
    private string? medicalCardUrl;

    protected override async Task OnParametersSetAsync()
    {
        if (Profile.License?.HasDocument == true)
            licenseUrl = await StorageSvc.GetSignedUrlAsync(Profile.License.DocumentBlobPath!);
            
        if (Profile.MedicalCard?.HasDocument == true)
            medicalCardUrl = await StorageSvc.GetSignedUrlAsync(Profile.MedicalCard.DocumentBlobPath!);
    }

    private void ToggleEndorsement(CdlEndorsement endorsement, bool add)
    {
        if (add)
            Profile.License?.AddEndorsement(endorsement);
        else
            Profile.License?.RemoveEndorsement(endorsement);
    }

    private async Task UploadLicenseDocumentAsync(InputFileChangeEventArgs e)
    {
        if (Profile?.License is null) return;
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024) return;

        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        var folder = $"licenses/{Profile.UserId}";
        Profile.License.DocumentBlobPath = await StorageSvc.UploadAsync(stream, file.Name, file.ContentType, folder);
        Profile.License.DocumentUploadedAt = DateTime.UtcNow;
        await SaveProfileAsync();
        licenseUrl = await StorageSvc.GetSignedUrlAsync(Profile.License.DocumentBlobPath);
    }

    private async Task DeleteLicenseDocumentAsync()
    {
        if (Profile?.License?.DocumentBlobPath is null) return;
        await StorageSvc.DeleteAsync(Profile.License.DocumentBlobPath);
        Profile.License.DocumentBlobPath = null;
        Profile.License.DocumentUploadedAt = null;
        licenseUrl = null;
        await SaveProfileAsync();
    }

    private async Task UploadMedicalCardDocumentAsync(InputFileChangeEventArgs e)
    {
        if (Profile?.MedicalCard is null) return;
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024) return;

        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        var folder = $"medical/{Profile.UserId}";
        Profile.MedicalCard.DocumentBlobPath = await StorageSvc.UploadAsync(stream, file.Name, file.ContentType, folder);
        Profile.MedicalCard.DocumentUploadedAt = DateTime.UtcNow;
        await SaveProfileAsync();
        medicalCardUrl = await StorageSvc.GetSignedUrlAsync(Profile.MedicalCard.DocumentBlobPath);
    }

    private async Task DeleteMedicalCardDocumentAsync()
    {
        if (Profile?.MedicalCard?.DocumentBlobPath is null) return;
        await StorageSvc.DeleteAsync(Profile.MedicalCard.DocumentBlobPath);
        Profile.MedicalCard.DocumentBlobPath = null;
        Profile.MedicalCard.DocumentUploadedAt = null;
        medicalCardUrl = null;
        await SaveProfileAsync();
    }

    private async Task SaveProfileAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)!.Value;
        if (Profile.Id > 0) 
        {
            await ProfileService.UpdateAsync(Profile, currentUserId);
        }
    }
}
