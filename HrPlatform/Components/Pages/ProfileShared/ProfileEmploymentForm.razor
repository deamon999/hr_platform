@using HrPlatform.Data.Models
@using HrPlatform.Data.Enums
@using HrPlatform.Utils

<div>
    <p class="text-secondary small mb-4">Please list your last 10 years of employment history.</p>

    @if (!Profile.EmploymentHistory.Any())
    {
        <div class="text-center py-5 mb-4">
            <p class="fs-5 text-secondary mb-0">No employment history available.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-5 mb-4">
            @foreach (var (emp, i) in Profile.EmploymentHistory.Select((e, i) => (e, i)))
            {
                <div class="position-relative">
                    <div class="d-flex align-items-center mb-4">
                        <h6 class="fw-bold text-warning mb-0 me-3 text-nowrap">@(i == 0 && !emp.EndDate.HasValue ? "Current Employer" : $"Employer #{i + 1}")</h6>
                        <div class="flex-grow-1 border-bottom border-warning opacity-50"></div>
                        @if(!IsReadOnly) {
                            <button type="button" class="btn btn-sm btn-link text-danger ms-3 text-decoration-none" @onclick="() => Profile.EmploymentHistory.Remove(emp)">
                                <i class="bi bi-x-lg"></i> Remove
                            </button>
                        }
                    </div>
                    
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Company Name *</label>
                            <InputText disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="emp.CompanyName"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Company Phone</label>
                            <InputText disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="emp.CompanyPhone"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Company Email</label>
                            <InputText disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="emp.CompanyEmail"/>
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Position / Job Title *</label>
                            <InputText disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="emp.JobTitle"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Start Date *</label>
                            <InputDate disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="emp.StartDate"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">End Date</label>
                            <InputDate disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="emp.EndDate"/>
                            <div class="form-text text-secondary mt-1" style="font-size: 0.75rem;">Leave blank if current employer</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Pay Type</label>
                            <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="emp.PayType">
                                <option value="">Select...</option>
                                @foreach (var p in Enum.GetValues<PayPeriod>())
                                {
                                    <option value="@p">Per @p.ToString()</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Average Weekly Miles</label>
                            <InputNumber disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="emp.AverageWeeklyMiles"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">May we contact?</label>
                            <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="emp.MayWeContact">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </InputSelect>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small mb-2 d-block">Equipment Driven</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var type in Enum.GetValues<TrailerType>())
                                {
                                    bool isChecked = emp.HasTrailerType(type);
                                    <div class="form-check me-2">
                                        <input type="checkbox" disabled="@IsReadOnly" class="form-check-input darker-border-checkbox" id="emp_@(i)_tt_@type" 
                                               checked="@isChecked" 
                                               @onchange="e => ToggleTrailerType(emp, type, (bool)e.Value!)" />
                                        <label class="form-check-label text-white small" for="emp_@(i)_tt_@type">@type</label>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Reason for Leaving</label>
                            <InputText disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="emp.ReasonForLeaving" placeholder="Leave blank if current employer"/>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    @if(!IsReadOnly) {
        <button type="button" class="btn btn-outline-warning rounded-pill px-4 fw-medium" @onclick="AddEmployment"><i class="bi bi-plus-lg me-1"></i> Add Another Employer</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
    
    private void AddEmployment()
    {
        Profile.EmploymentHistory.Add(new DriverEmployment { StartDate = DateOnly.FromDateTime(DateTime.Today) });
    }
    
    private void ToggleTrailerType(DriverEmployment emp, TrailerType type, bool add)
    {
        if (add)
            emp.AddTrailerType(type);
        else
            emp.RemoveTrailerType(type);
    }
}
