@using HrPlatform.Data.Models

<div>
    <div class="p-4 bg-light rounded-3 border-0 shadow-sm mb-4">
        <div class="d-flex gap-3 text-muted align-items-center mb-3">
            <i class="bi bi-info-circle fs-5"></i> 
            <p class="mb-0">Add skills related to driving, maintenance, or logistics.</p>
        </div>
        
        @if(!IsReadOnly) {
            <div class="d-flex gap-2 mb-4">
                <InputText class="form-control bg-white border-0 shadow-sm rounded-pill px-4" @bind-Value="newSkill" placeholder="e.g. Forklift Certified, Flatbed, HAZMAT Handling" />
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" @onclick="AddSkill">Add</button>
            </div>
        }

        <div class="d-flex flex-wrap gap-2">
            @foreach (var skill in Profile.GetSkillValues())
            {
                <span class="badge text-bg-primary rounded-pill px-3 py-2 fs-6 shadow-sm d-flex align-items-center gap-2">
                    @skill
                    @if(!IsReadOnly) {
                        <button type="button" class="btn-close btn-close-white" style="font-size: 0.65rem;" @onclick="() => Profile.RemoveSkill(skill)"></button>
                    }
                </span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
    
    private string newSkill = string.Empty;
    
    private void AddSkill()
    {
        if (string.IsNullOrWhiteSpace(newSkill) || Profile is null) return;
        Profile.AddSkill(newSkill.Trim());
        newSkill = string.Empty;
    }
}
