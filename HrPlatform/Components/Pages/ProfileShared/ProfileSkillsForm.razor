@using HrPlatform.Data.Models

<div>
    <p class="text-muted">Add skills related to driving, maintenance, or logistics.</p>
    
    @if(!IsReadOnly) {
        <div class="d-flex gap-2 mb-4">
            <InputText class="form-control" @bind-Value="newSkill" placeholder="e.g. Forklift Certified, Flatbed, HAZMAT Handling" />
            <button type="button" class="btn btn-primary" @onclick="AddSkill">Add</button>
        </div>
    }

    <div class="d-flex flex-wrap gap-2">
        @foreach (var skill in Profile.GetSkillValues())
        {
            <span class="badge bg-secondary d-flex align-items-center gap-2 p-2">
                @skill
                @if(!IsReadOnly) {
                    <button type="button" class="btn-close btn-close-white" style="font-size: 0.5rem;" @onclick="() => Profile.RemoveSkill(skill)"></button>
                }
            </span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
    
    private string newSkill = string.Empty;
    
    private void AddSkill()
    {
        if (string.IsNullOrWhiteSpace(newSkill) || Profile is null) return;
        Profile.AddSkill(newSkill.Trim());
        newSkill = string.Empty;
    }
}
