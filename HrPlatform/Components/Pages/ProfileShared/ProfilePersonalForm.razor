@using HrPlatform.Data.Enums
@using HrPlatform.Utils

<div class="row g-4">
    <div class="col-12"><h6 class="fw-bold border-bottom pb-2">Basic Information</h6></div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">First Name *</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.FirstName"/>
        <ValidationMessage For="() => Profile.FirstName" class="text-danger small mt-1"/>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Middle Name</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.MiddleName"/>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Last Name *</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.LastName"/>
        <ValidationMessage For="() => Profile.LastName" class="text-danger small mt-1"/>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Date of Birth *</label>
        <InputDate disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.DateOfBirth"/>
        <ValidationMessage For="() => Profile.DateOfBirth" class="text-danger small mt-1"/>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Phone *</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.PhoneNumber"/>
        <ValidationMessage For="() => Profile.PhoneNumber" class="text-danger small mt-1"/>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Alternate Phone</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.AlternatePhone"/>
    </div>
    <div class="col-12">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Email Address *</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.Email"/>
        <ValidationMessage For="() => Profile.Email" class="text-danger small mt-1"/>
    </div>
    
    <div class="col-12 mt-4"><h6 class="fw-bold border-bottom pb-2">Current Address</h6></div>
    
    <div class="col-md-6">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Street Address</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.StreetAddress"/>
    </div>
    <div class="col-md-6">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Apt, Suite, Unit, etc. (Optional)</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.AddressLine2"/>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">City</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.City"/>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">State</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" maxlength="2" @bind-Value="Profile.State"/>
    </div>
    <div class="col-md-4">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Zip Code</label>
        <InputText disabled="@IsReadOnly" class="form-control bg-light border-0 shadow-sm" @bind-Value="Profile.ZipCode"/>
    </div>
    
</div>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }
}
