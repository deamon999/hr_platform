@using HrPlatform.Data.Models
@using HrPlatform.Data.Entities
@using HrPlatform.Data.Enums
@using HrPlatform.Utils

<div>
    <h6 class="fw-bold text-warning mb-4">License Suspensions</h6>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <label class="form-label fw-semibold text-secondary small">Has your license ever been suspended or revoked?</label>
            <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="Profile.HasLicenseSuspension">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </InputSelect>
        </div>
        @if (Profile.HasLicenseSuspension)
        {
            <div class="col-md-4">
                <label class="form-label fw-semibold text-secondary small">Date</label>
                <InputDate disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="Profile.LicenseSuspensionDate" />
            </div>
            <div class="col-md-12 mt-3">
                <label class="form-label fw-semibold text-secondary small">Reason</label>
                <InputTextArea disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Reason for suspension" @bind-Value="Profile.LicenseSuspensionReason" />
            </div>
        }
    </div>

    <h6 class="fw-bold text-warning mb-4">Drug & Alcohol History</h6>
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <label class="form-label fw-semibold text-secondary small">Have you ever failed a drug test?</label>
            <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="Profile.HasFailedDrugTest">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </InputSelect>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-secondary small">Have you ever refused a drug test?</label>
            <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="Profile.HasRefusedDrugTest">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </InputSelect>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold text-secondary small">Have you completed a SAP program?</label>
            <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="Profile.HasCompletedSAPProgram">
                <option value="true">Yes</option>
                <option value="false">No</option>
            </InputSelect>
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center" style="background-color: rgba(13, 202, 240, 0.1);">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
        <div class="text-secondary small">
            <strong>DOT disclosure:</strong> List all moving violations, accidents, and DUI convictions in the past 3 years.
        </div>
    </div>

    @if (Profile.ViolationHistory == null || !Profile.ViolationHistory.Any())
    {
        <div class="text-center py-5 mb-4">
            <p class="fs-5 text-secondary mb-0">No safety records or violations reported.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-5 mb-5">
            @foreach (var (viol, vi) in Profile.ViolationHistory.Select((v,i)=>(v,i)))
            {
                <div class="position-relative">
                    <div class="d-flex align-items-center mb-4">
                        <h6 class="fw-bold text-warning mb-0 me-3 text-nowrap">Record #@(vi + 1)</h6>
                        <div class="flex-grow-1 border-bottom border-warning opacity-50"></div>
                        @if (!IsReadOnly)
                        {
                            <button type="button" class="btn btn-sm btn-link text-danger ms-3 text-decoration-none"
                                    @onclick="() => Profile.ViolationHistory.Remove(viol)">
                                <i class="bi bi-x-lg"></i> Remove
                            </button>
                        }
                    </div>
                    
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Type *</label>
                            <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="viol.Type">
                                @foreach (var vt in Enum.GetValues<ViolationType>())
                                { <option value="@vt">@(vt.GetDescriptionValue() ?? vt.ToString())</option> }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Date *</label>
                            <InputDate disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="viol.OccurredDate"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">At fault?</label>
                            <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="viol.AtFault">
                                <option value="true">Yes</option>
                                <option value="false">No</option>
                            </InputSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary small">Description</label>
                            <InputTextArea disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" rows="2"
                                           @bind-Value="viol.Description"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Resolution</label>
                            <InputText disabled="@IsReadOnly" class="form-control bg-dark text-white border-secondary" @bind-Value="viol.Resolution"
                                       placeholder="e.g. Fine paid, license suspended 30 days"/>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    @if (!IsReadOnly)
    {
        <button type="button" class="btn btn-outline-warning rounded-pill px-4 fw-medium mb-5"
                @onclick="AddViolation">
            <i class="bi bi-plus-lg me-1"></i> Add Safety Record
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }

    private void AddViolation()
    {
        Profile.ViolationHistory.Add(new DriverViolation {
            DriverProfileId = Profile.Id,
            OccurredDate = DateOnly.FromDateTime(DateTime.Today)
        });
    }
}
