@using HrPlatform.Data.Models
@using HrPlatform.Data.Enums

<div class="row g-4">
    <div class="col-12 mb-2">
        <h5 class="fw-bold text-white mb-3">Driving Experience</h5>
    </div>
    
    <div class="col-md-3">
        <label class="form-label fw-semibold text-secondary small">Total CDL Experience (Years) *</label>
        <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="Profile.YearsOfExperience">
            @for (int i = 0; i <= 50; i++)
            {
                <option value="@i">@i</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-semibold text-secondary small">OTR Experience (Years)</label>
        <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="Profile.OtrExperience">
            @for (int i = 0; i <= 50; i++)
            {
                <option value="@i">@i</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-semibold text-secondary small">Local Experience (Years)</label>
        <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="Profile.LocalExperience">
            @for (int i = 0; i <= 50; i++)
            {
                <option value="@i">@i</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-3">
        <label class="form-label fw-semibold text-secondary small">Owner Operator Experience (Years)</label>
        <InputSelect disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" @bind-Value="Profile.OwnerOperatorExperience">
            @for (int i = 0; i <= 50; i++)
            {
                <option value="@i">@i</option>
            }
        </InputSelect>
    </div>
    
    <div class="col-12 mt-5">
        <h5 class="fw-bold text-white mb-3 border-bottom border-secondary pb-2">Equipment Experience (Years)</h5>
    </div>
    
    @{
        var equipmentFields = new[]
        {
            ("Dry Van", nameof(DriverProfile.DryVanExperience), Profile.DryVanExperience),
            ("Reefer", nameof(DriverProfile.ReeferExperience), Profile.ReeferExperience),
            ("Flatbed", nameof(DriverProfile.FlatbedExperience), Profile.FlatbedExperience),
            ("Step Deck", nameof(DriverProfile.StepDeckExperience), Profile.StepDeckExperience),
            ("RGN", nameof(DriverProfile.RgnExperience), Profile.RgnExperience),
            ("Lowboy", nameof(DriverProfile.LowboyExperience), Profile.LowboyExperience),
            ("Tanker", nameof(DriverProfile.TankerExperience), Profile.TankerExperience),
            ("Car Hauler", nameof(DriverProfile.CarHaulerExperience), Profile.CarHaulerExperience),
            ("Dump", nameof(DriverProfile.DumpExperience), Profile.DumpExperience),
            ("Other", nameof(DriverProfile.PneumaticExperience), Profile.PneumaticExperience)
        };
    }

    <div class="row g-3 mt-2">
        @foreach (var eq in equipmentFields)
        {
            <div class="col-md-2 col-sm-4">
                <label class="form-label fw-semibold text-secondary small">@eq.Item1</label>
                <select disabled="@IsReadOnly" class="form-select bg-dark text-white border-secondary" value="@eq.Item3" @onchange="@(e => UpdateEquipment(eq.Item2, e.Value))">
                    @for (int i = 0; i <= 50; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>
        }
    </div>

</div>

@code {
    [Parameter, EditorRequired] public DriverProfile Profile { get; set; } = default!;
    [Parameter] public bool IsReadOnly { get; set; }

    private void UpdateEquipment(string propertyName, object? value)
    {
        if (value == null || !int.TryParse(value.ToString(), out int val)) return;

        var prop = typeof(DriverProfile).GetProperty(propertyName);
        if (prop != null)
        {
            prop.SetValue(Profile, val);
        }
    }
}
