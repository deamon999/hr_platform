@page "/users/{Id}"
@page "/users/edit/{Id}"
@using HrPlatform.Models
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject ICompanyService CompanySvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IAdminUserService UserService

<h2>User Management</h2>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (IsViewMode)
{
    <h3>View User</h3>
    <div class="card">
        <div class="card-body">
            <p><strong>Username:</strong> @model?.Username</p>
            <p><strong>Email:</strong> @model?.Email</p>
            <p><strong>Phone:</strong> @model?.Phone</p>
            <p><strong>Role:</strong> @model?.Roles</p>
            <p><strong>Company ID:</strong> @model?.CompanyId</p>
            <p><strong>Company Name:</strong> @model?.CompanyName</p>
        </div>
    </div>
    <button class="btn btn-outline-secondary" type="button" @onclick="GoToUsers">Back</button>
}
else
{
    <h3>Edit User: </h3>
    <EditForm Model="model" OnValidSubmit="UpdateAsync">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <div class="mb-3">
            <label class="form-label">User Name *</label>
            <InputText class="form-control" @bind-Value="model.Username"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Email *</label>
            <InputText class="form-control" @bind-Value="model.Email"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Phone *</label>
            <InputText class="form-control" @bind-Value="model.Phone"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Role</label>
            <InputSelect class="form-select" @bind-Value="model.Roles">
                @foreach (var r in roles)
                {
                    <option value="@r">@r</option>
                }
            </InputSelect>
        </div>

        @if (isAdmin)
        {
            <div class="mb-3">
                <label class="form-label">Company</label>
                <InputSelect class="form-select" @bind-Value="model.CompanyId">
                    <option value="">— none —</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Company</label>
                <div>@(myCompany?.Name ?? "(none)")</div>
            </div>
        }

        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save User</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="GoToUsers">Back</button>
        </div>
    </EditForm>
}

@code {
    [Parameter] public string Id { get; set; }
    private bool isLoading = true;
    private bool IsViewMode = false;
    private bool isAdmin = false;

    private Company? myCompany;
    private List<Company>? companies;
    private List<string?> roles = new();

    private UserViewModel model = new();
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.IsInRole(RoleConstants.Admin);

        // load roles synchronously from RoleManager (store may not support EF async here)
        roles =  RoleManager.Roles
            .Where(r => !r.NormalizedName.Equals("ADMIN"))
            .Select(r => r.Name)
            .ToList();

        if (isAdmin)
        {
            companies = await CompanySvc.GetAllAsync();
        }
        else
        {
            // manager: determine their company
            var currentUser = await UserManager.GetUserAsync(user);
            if (currentUser?.CompanyId != null)
            {
                myCompany = await CompanySvc.GetByIdAsync(currentUser.CompanyId.Value);
                model.CompanyId = myCompany?.Id;
            }
        }

        // Check if we are in view or edit mode based on the current route and load data accordingly
        var uri = Nav.Uri.ToLower();
        if (uri.Contains("/edit/"))
        {
            model = await UserService.GetUserByIdAsync(Id);
        }
        else
        {
            // If we are in view mode, load the user details
            model = await UserService.GetUserByIdAsync(Id);
            IsViewMode = true;
        }

        isLoading = false;
    }

    private void GoToUsers()
    {
        Nav.NavigateTo("/users"); // Assuming /users is a list view if implemented elsewhere
    }

    private async Task UpdateAsync()
    {
        errorMessage = null;

        var user = await UserManager.FindByIdAsync(Id);
        if (user == null)
        {
            errorMessage = "User not found.";
            return;
        }

        // Update user details
        user.UserName = model.Username;
        user.Email = model.Email;
        user.PhoneNumber = model.Phone;

        if (isAdmin)
        {
            user.CompanyId = model.CompanyId ?? user.CompanyId; // Keep existing if null in form submission
        }
        else
        {
            // For non-admins, company ID is usually inherited or managed differently based on context.
            // We use the value submitted from the form.
            user.CompanyId = model.CompanyId ?? user.CompanyId;
        }

        // Swap roles: remove all current, assign new single role
        var currentRoles = await UserManager.GetRolesAsync(user);
        var removeResult = await UserManager.RemoveFromRolesAsync(user, currentRoles);
        if (!removeResult.Succeeded)
        {
            errorMessage = "Could not remove current roles: " +
                           string.Join(", ", removeResult.Errors.Select(e => e.Description));
            return;
        }

        var addResult = await UserManager.AddToRoleAsync(user, model.Roles);
        if (!addResult.Succeeded)
        {
            errorMessage = "Could not assign role: " +
                           string.Join(", ", addResult.Errors.Select(e => e.Description));
            return;
        }


        var result = await UserManager.UpdateAsync(user);

        if (!result.Succeeded)
        {
            errorMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            return;
        }

        successMessage = "User updated successfully.";
        GoToUsers();
    }

}