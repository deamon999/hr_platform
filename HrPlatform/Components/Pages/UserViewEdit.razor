@page "/users/{Id}"
@page "/users/edit/{Id}"
@using HrPlatform.Models
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject ICompanyService CompanySvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IAdminUserService UserService
@inject IJSRuntime JSRuntime

<PageTitle>User Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-dark">@(IsViewMode ? "View User" : "Edit User")</h2>
    @if (IsViewMode)
    {
        <button class="btn btn-primary rounded-pill px-4" @onclick='() => Nav.NavigateTo($"/users/edit/{Id}")'><i class="bi bi-pencil me-1"></i> Edit</button>
    }
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm"></div>
        Loading...
    </div>
}
else
{
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 app-card">
                <div class="card-body p-4 p-md-5">
    <EditForm Model="model" OnValidSubmit="UpdateAsync">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">User Name *</label>
                            <InputText class="form-control bg-light border-0" @bind-Value="model.Username" disabled="@IsViewMode"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Email *</label>
                            <InputText class="form-control bg-light border-0" @bind-Value="model.Email" disabled="@IsViewMode"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Phone *</label>
                            <InputText class="form-control bg-light border-0" @bind-Value="model.Phone" disabled="@IsViewMode"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Role</label>
                            <InputSelect class="form-select bg-light border-0" @bind-Value="model.Roles" disabled="@IsViewMode">
                                @foreach (var r in roles)
                                {
                                    <option value="@r">@r</option>
                                }
                            </InputSelect>
                        </div>

                        @if (isAdmin)
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small text-uppercase">Company</label>
                                <InputSelect class="form-select bg-light border-0" @bind-Value="model.CompanyId" disabled="@IsViewMode">
                                    <option value="">-- none --</option>
                                    @foreach (var c in companies)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small text-uppercase">Company</label>
                                <div class="p-2 bg-light rounded text-dark">@(myCompany?.Name ?? "(none)")</div>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2 pt-3 border-top border-secondary">
                        @if (!IsViewMode)
                        {
                            <button class="btn btn-primary px-4 py-2 fw-bold rounded-pill" type="submit">Save Changes</button>
                        }
                        <button class="btn btn-outline-secondary px-4 py-2 rounded-pill" type="button" @onclick="GoToUsers">
                            <i class="bi bi-arrow-left me-1"></i> Back to Users
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>
}

<style>
    .app-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
</style>

@code {
    [Parameter] public string Id { get; set; }
    private bool isLoading = true;
    private bool IsViewMode = false;
    private bool isAdmin = false;

    private Company? myCompany;
    private List<Company>? companies;
    private List<string?> roles = new();

    private UserViewModel model = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.IsInRole(RoleConstants.Admin);

        // load roles synchronously from RoleManager (store may not support EF async here)
        roles = RoleManager.Roles
            .Where(r => !r.NormalizedName.Equals("ADMIN"))
            .Select(r => r.Name)
            .ToList();

        if (isAdmin)
        {
            companies = await CompanySvc.GetAllAsync();
        }
        else
        {
            // manager: determine their company
            var currentUser = await UserManager.GetUserAsync(user);
            if (currentUser?.CompanyId != null)
            {
                myCompany = await CompanySvc.GetByIdAsync(currentUser.CompanyId.Value);
                model.CompanyId = myCompany?.Id;
            }
        }

        // Check if we are in view or edit mode based on the current route and load data accordingly
        var uri = Nav.Uri.ToLower();
        if (uri.Contains("/edit/"))
        {
            model = await UserService.GetUserByIdAsync(Id);
        }
        else
        {
            // If we are in view mode, load the user details
            model = await UserService.GetUserByIdAsync(Id);
            IsViewMode = true;
        }

        isLoading = false;
    }

    private async Task GoToUsers()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }

    private async Task UpdateAsync()
    {
        errorMessage = null;

        var user = await UserManager.FindByIdAsync(Id);
        if (user == null)
        {
            errorMessage = "User not found.";
            return;
        }

        // Update user details
        user.UserName = model.Username;
        user.Email = model.Email;
        user.PhoneNumber = model.Phone;

        if (isAdmin)
        {
            user.CompanyId = model.CompanyId ?? user.CompanyId; // Keep existing if null in form submission
        }
        else
        {
            // For non-admins, company ID is usually inherited or managed differently based on context.
            // We use the value submitted from the form.
            user.CompanyId = model.CompanyId ?? user.CompanyId;
        }

        // Swap roles: remove all current, assign new single role
        var currentRoles = await UserManager.GetRolesAsync(user);
        var removeResult = await UserManager.RemoveFromRolesAsync(user, currentRoles);
        if (!removeResult.Succeeded)
        {
            errorMessage = "Could not remove current roles: " +
                           string.Join(", ", removeResult.Errors.Select(e => e.Description));
            return;
        }

        var addResult = await UserManager.AddToRoleAsync(user, model.Roles);
        if (!addResult.Succeeded)
        {
            errorMessage = "Could not assign role: " +
                           string.Join(", ", addResult.Errors.Select(e => e.Description));
            return;
        }


        var result = await UserManager.UpdateAsync(user);

        if (!result.Succeeded)
        {
            errorMessage = string.Join("; ", result.Errors.Select(e => e.Description));
            return;
        }


        GoToUsers();
    }

}
