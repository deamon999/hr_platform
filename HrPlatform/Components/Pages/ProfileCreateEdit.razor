@page "/profiles/new"
@page "/profiles/edit/{Id:int}"
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Driver}")]
@inject IDriverProfileService ProfileService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>@(isNew ? "Driver Application" : "Edit Application")</PageTitle>

<div>
    @if (profile is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted">
            <div class="spinner-border spinner-border-sm"></div>
            Loading...
        </div>
    }
    else if (showWelcomeOverlay)
    {
        <div class="row g-0 h-100 p-4" style="min-height: calc(100vh - 4.5rem); background-color: var(--bg-color);">
            <div class="col-12 col-xl-10 mx-auto">
                <HrPlatform.Components.Pages.ProfileShared.ProfileRequirementsWelcome OnContinue="StartWizard"/>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-5 overflow-hidden">
            <div class="row g-0">
                <!-- Sidebar Progress -->
                <div class="col-lg-3 p-4" style="background-color: var(--bg-card); border-right: 1px solid var(--border-color);">
                    <div class="mb-4">
                        <h4 class="fw-bold mb-4">Complete Profile</h4>

                        <h5 class="text-secondary fw-bold text-uppercase mb-2" style="font-size: 0.8rem; letter-spacing: 1px;">Application
                            Progress</h5>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <small class="text-muted fw-medium">@Math.Min((activeTab + 1) * 100 / tabs.Length, 100)% Complete</small>
                        </div>
                        <div class="progress mb-4" style="height: 6px; background-color: rgba(255,255,255,0.1);">
                            <div class="progress-bar bg-primary"
                                 style="width: @Math.Min((activeTab + 1) * 100 / tabs.Length, 100)%; transition: width 0.3s ease;"></div>
                        </div>

                        <ul class="nav flex-column gap-3 wizard-steps">
                            @foreach (var (label, index) in tabs.Select((l, i) => (l, i)))
                            {
                                var locked = index > maxReachedTab;
                                var completed = index < maxReachedTab;
                                var active = activeTab == index;

                                <li class="nav-item">
                                    <button type="button"
                                            class="nav-link text-start w-100 p-0 d-flex align-items-center @(active ? "active-step" : "inactive-step") @(locked ? "disabled opacity-50" : "")"
                                            @onclick="() => ActivateTab(index)"
                                            disabled="@locked"
                                            style="background: transparent; border: none;">
                                        <div
                                            class="step-circle @(active ? "active-circle" : completed ? "completed-circle" : "inactive-circle") me-3 d-flex justify-content-center align-items-center rounded-circle"
                                            style="width: 24px; height: 24px; font-size: 0.75rem;">
                                            @if (completed)
                                            {
                                                <i class="bi bi-check"></i>
                                            }
                                            else
                                            {
                                                <span>@(index + 1)</span>
                                            }
                                        </div>
                                        <span style="font-size: 0.9rem;">@label</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="mt-auto pt-5">
                        <div class="d-flex align-items-center text-muted">
                            <i class="bi bi-question-circle fs-4 me-3 text-primary"></i>
                            <div>
                                <div class="fw-bold text-light" style="font-size: 0.9rem;">Need Help?</div>
                                <small>Our team is here to help you.</small>
                                <div class="mt-1">
                                    <a href="mailto:contact@cdlpool.com" class="text-primary text-decoration-none small"><i
                                            class="bi bi-envelope me-1"></i> Contact Support</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content Area -->
                <div class="col-lg-9 d-flex flex-column" style="background-color: var(--bg-card); color: var(--text-primary);">
                    <EditForm EditContext="editContext" class="d-flex flex-column">
                        <DataAnnotationsValidator/>

                        <!-- Top Bar -->
                        <div class="px-3 px-md-5 py-3 py-md-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center border-bottom gap-3" style="border-color: var(--border-color) !important;">
                            <h4 class="mb-0 fw-bold text-uppercase d-flex align-items-center">
                                <span class="text-primary me-2">@(activeTab + 1).</span> @tabs[activeTab]
                            </h4>
                            <div>
                                <button type="button" class="btn btn-link text-muted text-decoration-none" @onclick="CancelEdit">
                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                </button>
                            </div>
                        </div>

                        <div class="px-3 px-md-5 py-3 py-md-4">
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger shadow-sm rounded-3 mb-4 d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                                    <div>@errorMessage</div>
                                </div>
                            }
                            <ValidationSummary class="text-danger mb-4"/>

                            <div class="@(activeTab == 0 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfilePersonalForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 1 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileLicenseForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 2 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileDrivingStatsForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 3 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileEmploymentForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 4 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileSafetyForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 5 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfilePreferencesForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 6 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileEducationForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 7 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileDocumentsForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 8 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileConsentsForm Profile="profile" IsReadOnly="false" />
                            </div>
                            <div class="@(activeTab == 9 ? "" : "d-none")">
                                <HrPlatform.Components.Pages.ProfileShared.ProfileReviewForm Profile="profile" />
                            </div>
                        </div>

                        <!-- Bottom Nav Bar -->
                        <div class="px-3 px-md-5 py-3 py-md-4 border-top d-flex justify-content-between align-items-center mt-auto" style="border-color: var(--border-color) !important; background-color: var(--bg-card);">
                            @if (activeTab > 0)
                            {
                                <button type="button" class="btn btn-outline-secondary px-3 px-md-4" @onclick="GoPrevious">
                                    <i class="bi bi-arrow-left d-none d-sm-inline me-2"></i><i class="bi bi-arrow-left d-inline d-sm-none"></i> <span class="d-none d-sm-inline">Previous</span>
                                </button>
                            }
                            else
                            {
                                <div></div>
                            }

                            @if (activeTab < 9)
                            {
                                <div class="d-flex gap-2 gap-sm-3">
                                    <button type="button" class="btn btn-outline-primary px-3 px-md-4 fw-medium d-none d-sm-block" @onclick="SaveAndExitAsync">
                                        Save & Exit
                                    </button>
                                    <button type="button" class="btn btn-primary px-3 px-md-4 fw-medium" @onclick="SaveAndContinueAsync">
                                        <span class="d-none d-sm-inline">Save & Continue</span><span class="d-inline d-sm-none">Next</span> <i class="bi bi-arrow-right ms-1 ms-sm-2"></i>
                                    </button>
                                </div>
                            }
                            else if (activeTab == 9)
                            {
                                <div class="d-flex gap-2 gap-sm-3">
                                    <button type="button" class="btn btn-outline-primary px-3 px-md-4 fw-medium d-none d-sm-block" @onclick="SaveAndExitAsync">
                                        Save & Exit
                                    </button>
                                    @if (profile!.IsApplicationCompleted)
                                    {
                                        <button type="button" class="btn btn-primary px-3 px-md-5 fw-bold" @onclick="SaveAndExitAsync">
                                            <span class="d-none d-sm-inline">Save Changes</span><span class="d-inline d-sm-none">Save</span> <i class="bi bi-check-circle ms-1 ms-sm-2"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary px-3 px-md-5 fw-bold" @onclick="SubmitApplicationAsync">
                                            <span class="d-none d-sm-inline">Submit Profile</span><span class="d-inline d-sm-none">Submit</span> <i class="bi bi-check-circle ms-1 ms-sm-2"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>

        <style>
            .wizard-steps .active-step {
                color: var(--text-primary);
                font-weight: 600;
            }

            .wizard-steps .inactive-step {
                color: var(--text-secondary);
            }

            .wizard-steps .inactive-step:hover:not(.disabled) {
                color: var(--text-primary);
            }

            .step-circle {
                border: 1px solid var(--border-color);
            }

            .active-circle {
                background-color: var(--accent-primary);
                border-color: var(--accent-primary);
                color: #000;
            }

            .completed-circle {
                background-color: transparent;
                border-color: var(--text-secondary);
                color: var(--text-secondary);
            }

            .inactive-circle {
                background-color: transparent;
                color: var(--text-secondary);
            }
        </style>

        @if (showCancelConfirm)
        {
            <div class="modal show d-block shadow" tabindex="-1" style="background:rgba(0,0,0,.5); backdrop-filter: blur(2px);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-header bg-danger text-white border-0">
                            <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Discard changes?</h5>
                        </div>
                        <div class="modal-body p-4 fs-5">
                            You have unsaved changes. Are you sure you want to exit?
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-secondary px-4" @onclick="() => showCancelConfirm = false">
                                Cancel
                            </button>
                            <button type="button" class="btn btn-danger px-4" @onclick="ConfirmCancel">Exit</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Success Modal -->
    @if (showSuccessModal)
    {
        <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(5px);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="background-color: var(--bg-card); color: var(--text-color);">
                    <div class="modal-body text-center py-5">
                        <i class="bi bi-check-circle-fill text-primary" style="font-size: 4rem;"></i>
                        <h2 class="mt-4 mb-3 fw-bold text-dark">Application Submitted!</h2>
                        <p class="text-secondary mb-5">Thank you! Your profile has been submitted successfully.<br/>You can now apply to jobs that
                            match your profile.</p>
                        <div class="d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-outline-primary px-4 py-2" @onclick="GoToProfile">View My Profile</button>
                            <a href="/jobs" class="btn btn-primary px-4 py-2">Browse Jobs</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [Parameter] public int Id { get; set; }

    private DriverProfile? profile;
    private EditContext editContext = default!;
    private bool isNew;
    private string userId = default!;
    private string? errorMessage;
    private int activeTab;
    private int maxReachedTab;
    private bool showCancelConfirm;
    private bool showSuccessModal;
    private bool showWelcomeOverlay;

    private void StartWizard()
    {
        showWelcomeOverlay = false;
    }

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private static readonly string[] tabs =
        ["Personal Information", "CDL License & Medical", "Driving Experience", "Employment History", "Safety History", "Preferences", "Education", "Other Documents", "Consents & Authorizations", "Review & Submit"];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)!.Value;

        var existing = Id > 0
            ? await ProfileService.GetByIdAsync(Id)
            : await ProfileService.GetByUserIdAsync(userId);

        if (existing is null && Id > 0)
        {
            Nav.NavigateTo("/profiles");
            return;
        }

        if (existing is null)
        {
            isNew = true;
            showWelcomeOverlay = true;
            maxReachedTab = 0;
            activeTab = 0;
            var appUser = await UserManager.FindByIdAsync(userId);
            profile = new DriverProfile
            {
                UserId = userId,
                DateOfBirth = Today,
                FirstName = appUser?.FirstName ?? string.Empty,
                LastName = appUser?.LastName ?? string.Empty,
                Email = appUser?.Email ?? string.Empty
            };
        }
        else
        {
            if (Id > 0 && existing.UserId != userId)
            {
                Nav.NavigateTo($"/profiles/{existing.Id}");
                return;
            }

            isNew = false;

            // Clamp LastWizardStep in case tabs were removed
            if (existing.LastWizardStep >= tabs.Length)
            {
                existing.LastWizardStep = tabs.Length - 1;
            }

            maxReachedTab = existing.IsApplicationCompleted ? tabs.Length - 1 : existing.LastWizardStep;
            activeTab = existing.IsApplicationCompleted ? 0 : existing.LastWizardStep;
            profile = existing;
        }

        editContext = new EditContext(profile!);
    }

    private void ActivateTab(int index)
    {
        try
        {
            errorMessage = null;
            if (!profile!.IsApplicationCompleted && index > maxReachedTab)
                return;

            if (activeTab == 1 && index > activeTab && (!profile.Documents.Any(d => d.DocumentType == "CDL License") || !profile.Documents.Any(d => d.DocumentType == "Medical Card")))
            {
                errorMessage = "CDL License and DOT Medical Card documents are required before proceeding.";
                return;
            }

            activeTab = index;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error in ActivateTab: {ex.Message}";
        }
    }

    private void GoNext()
    {
        if (activeTab >= tabs.Length - 1)
            return;

        activeTab++;

        if (activeTab > maxReachedTab)
            maxReachedTab = activeTab;
    }

    private void GoPrevious()
    {
        if (activeTab > 0)
            activeTab--;
    }

    private async Task SaveAndContinueAsync()
    {
        try
        {
            errorMessage = null;
            if (activeTab == 1 && (!profile!.Documents.Any(d => d.DocumentType == "CDL License") || !profile.Documents.Any(d => d.DocumentType == "Medical Card")))
            {
                errorMessage = "CDL License and DOT Medical Card documents are required before proceeding.";
                return;
            }

            if (ValidateProfileSafe())
            {
                if (activeTab < 9)
                {
                    var nextTab = activeTab + 1;
                    if (nextTab > maxReachedTab) maxReachedTab = nextTab;
                    if (nextTab > profile!.LastWizardStep) profile.LastWizardStep = nextTab;
                }

                await SaveProfileToDbAsync();

                if (activeTab < 9)
                {
                    activeTab++;
                }
            }
        }
        catch (DbUpdateException ex) when (ex.InnerException?.Message.Contains("IX_DriverLicenses_LicenseNumber") == true)
        {
            errorMessage = "This CDL License Number is already registered in the system.";
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while saving the profile: " + ex.Message;
        }
    }

    private bool ValidateProfileSafe()
    {
        var tempLicense = profile!.License;
        if (tempLicense != null && tempLicense.Id == 0 && string.IsNullOrWhiteSpace(tempLicense.LicenseNumber))
            profile.License = null;

        var tempMedical = profile.MedicalCard;
        if (tempMedical != null && tempMedical.Id == 0 && tempMedical.SelfCertification == null && string.IsNullOrWhiteSpace(tempMedical.MedicalExaminerName))
            profile.MedicalCard = null;

        var isValid = editContext.Validate();

        foreach (var edu in profile.Educations)
        {
            if (string.IsNullOrWhiteSpace(edu.SchoolName) ||
                string.IsNullOrWhiteSpace(edu.City) ||
                string.IsNullOrWhiteSpace(edu.State) ||
                edu.Level == null)
            {
                isValid = false;
                if (string.IsNullOrWhiteSpace(errorMessage))
                {
                    errorMessage = "Please complete all required fields (Level, School Name, City, State) for your added Education records.";
                }
            }
        }

        foreach (var emp in profile.EmploymentHistory)
        {
            if (string.IsNullOrWhiteSpace(emp.JobTitle) || string.IsNullOrWhiteSpace(emp.CompanyName))
            {
                isValid = false;
                if (string.IsNullOrWhiteSpace(errorMessage))
                {
                    errorMessage = "Please complete all required fields (Company Name, Job Title) for your added Employment records.";
                }
            }
        }

        profile.License = tempLicense;
        profile.MedicalCard = tempMedical;

        return isValid;
    }

    private async Task SaveAndExitAsync()
    {
        try
        {
            errorMessage = null;

            if (ValidateProfileSafe())
            {
                try
                {
                    await SaveProfileToDbAsync();
                    Nav.NavigateTo(ReturnUrl ?? "/my-profile");
                }
                catch (Exception ex)
                {
                    errorMessage = "An error occurred while saving the profile: " + ex.Message;
                }
            }
            else
            {
                errorMessage = "Validation failed. Please fill in all required fields.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Critical Error in Save: {ex.Message}";
        }
    }

    private async Task SubmitApplicationAsync()
    {
        try
        {
            if (ValidateProfileSafe())
            {
                profile!.IsApplicationCompleted = true;
                await SaveProfileToDbAsync();
                showSuccessModal = true;
                StateHasChanged();
            }
        }
        catch (DbUpdateException ex) when (ex.InnerException?.Message.Contains("IX_DriverLicenses_LicenseNumber") == true)
        {
            errorMessage = "This CDL License Number is already registered in the system.";
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while submitting the profile: " + ex.Message;
        }
    }

    private async Task SaveProfileToDbAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var currentUserId = auth.User.FindFirst(ClaimTypes.NameIdentifier)!.Value;

        if (activeTab > profile!.LastWizardStep)
        {
            profile.LastWizardStep = activeTab;
        }

        // Temporarily null out empty nested objects to prevent EF from trying to insert them
        var licenseWasEmpty = false;
        if (profile!.License != null && profile.License.Id == 0 && string.IsNullOrWhiteSpace(profile.License.LicenseNumber))
        {
            profile.License = null;
            licenseWasEmpty = true;
        }

        var medicalCardWasEmpty = false;
        if (profile.MedicalCard != null && profile.MedicalCard.Id == 0 && profile.MedicalCard.SelfCertification == null && string.IsNullOrWhiteSpace(profile.MedicalCard.MedicalExaminerName))
        {
            profile.MedicalCard = null;
            medicalCardWasEmpty = true;
        }

        if (isNew)
        {
            profile.UserId = currentUserId;
            await ProfileService.CreateAsync(profile!);
            isNew = false;
        }
        else
        {
            await ProfileService.UpdateAsync(profile!, currentUserId);
        }

        // Restore for UI binding
        if (licenseWasEmpty) profile.License = new DriverLicense();
        if (medicalCardWasEmpty) profile.MedicalCard = new DriverMedicalCard();

        // Reset IsUnsaved for all documents since they are now saved
        foreach (var doc in profile.Documents)
        {
            doc.IsUnsaved = false;
        }

        // Mark form as unmodified so we don't prompt on exit
        editContext.MarkAsUnmodified();
    }

    private void CancelEdit()
    {
        try
        {
            if (editContext.IsModified())
            {
                showCancelConfirm = true;
            }
            else
            {
                ConfirmCancel();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error in CancelEdit: {ex.Message}";
        }
    }

    private void ConfirmCancel()
    {
        if (isNew)
            Nav.NavigateTo("/jobs");
        else
            Nav.NavigateTo(ReturnUrl ?? $"/profiles/{profile!.Id}");
    }

    private void GoToProfile()
    {
        Nav.NavigateTo($"/profiles/{profile!.Id}");
    }

}

