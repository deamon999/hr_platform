@page "/applications/{ApplicationId:int}/chat"
@using System.Security.Claims
@using HrPlatform.Data.Entities
@rendermode InteractiveServer
<TimezoneInitializer/>

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Driver},{RoleConstants.Manager}")]
@inject IApplicationMessageService MessageService
@inject IJobApplicationService AppService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Application Chat</PageTitle>

@if (_isLoading)
{
    <LoadingSpinner Text="Loading chat..." />
}
else if (_application == null)
{
    <EmptyState Icon="bi-chat-left-text"
                Title="Application not found"
                Message="The requested application could not be found or you do not have permission to access this conversation."
                ActionText="Back to Applications"
                ActionIcon="bi-arrow-left"
                OnAction="GoBack" />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-light">Chat: @_application.Job.Title</h2>
        <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="GoBack">
            <i class="bi bi-arrow-left me-1"></i> Back to Applications
        </button>
    </div>

    <div class="card shadow-sm border bg-dark text-light app-card mb-4" style="border-color: var(--border-color) !important;">
        <div class="card-header border-bottom py-3" style="background-color: var(--bg-card); border-color: var(--border-color) !important;">
            <h5 class="mb-0 fw-bold text-light">
                @if (_isManager)
                {
                    <text>Candidate: @_application.User.FirstName @_application.User.LastName</text>
                }
                else
                {
                    <text>Manager: @DisplayCompanyName(_application.Job)</text>
                }
            </h5>
        </div>
        <div class="card-body" style="height: 400px; overflow-y: auto; background-color: var(--bg-dark);" id="chat-container">
            @if (!_messages.Any())
            {
                <EmptyState Icon="bi-chat-dots"
                            Title="No messages yet"
                            Message="Start the conversation by typing a message below." />
            }
            else
            {
                @foreach (var msg in _messages)
                {
                    var isMine = msg.SenderId == _currentUserId;
                    <div class="d-flex flex-column mb-3 @(isMine ? "align-items-end" : "align-items-start")">
                        <div class="p-3 rounded-3 shadow-sm @(isMine ? "bg-primary text-white" : "text-light")"
                             style="@(isMine ? "" : "background-color: var(--bg-card); border: 1px solid var(--border-color);") max-width: 75%;">
                            @msg.Content
                        </div>
                        <small class="text-secondary mt-1" style="font-size: 0.75rem;">
                            @TimeZoneService.ToUserTime(msg.SentAt).ToString("g")
                            @if (!isMine && msg.IsRead)
                            {
                                <text> (Read)</text>
                            }
                        </small>
                    </div>
                }
            }
        </div>
        <div class="card-footer border-top py-3" style="background: transparent;">
            <div class="d-flex gap-2">
                <input type="text" class="form-control rounded-pill px-4 py-2"
                       style="background-color: var(--bg-dark); border-color: var(--border-color); color: var(--text-primary);"
                       placeholder="Type your message..." @bind="_newMessage" @bind:event="oninput" @onkeyup="HandleKeyUp" disabled="@_isSending"/>
                <button class="btn btn-primary rounded-pill px-4 fw-bold" type="button" @onclick="SendMessageAsync"
                        disabled="@(_isSending || string.IsNullOrWhiteSpace(_newMessage))">
                    @if (_isSending)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-send-fill me-1"></i>
                    }
                    Send
                </button>
            </div>
        </div>
    </div>
}

<style>
    .app-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
</style>

@code {
    [Parameter] public int ApplicationId { get; set; }

    private JobApplication? _application;
    private List<ApplicationMessage> _messages = new();
    private string _newMessage = "";
    private string? _currentUserId;
    private bool _isManager;
    private bool isApplicant;
    private bool isAdmin;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        isAdmin = auth.User.IsInRole(RoleConstants.Admin);
        var user = auth.User;
        _currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        isApplicant = user.IsInRole(RoleConstants.Driver);
        _isManager = user.IsInRole(RoleConstants.Manager) || isAdmin;
    }

    private string DisplayCompanyName(Job job)
    {
        if (job.IsConfidential && !isAdmin) return "CDL Pool Client";
        return job.Company?.Name ?? "Company";
    }

    protected override async Task OnParametersSetAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        _application = await AppService.GetAsync(ApplicationId);

        if (_application == null)
        {
            _isLoading = false;
            return;
        }

        // Validate access
        if (_isManager && !isAdmin)
        {
            var companyIdStr = user.FindFirst(ClaimTypes.GroupSid)?.Value ?? user.FindFirst("companyId")?.Value;
            if (int.TryParse(companyIdStr, out var companyId))
            {
                if (_application.Job.CompanyId != companyId)
                {
                    _application = null; // Deny access
                }
            }
        }
        else if (isApplicant && _application.UserId != _currentUserId)
        {
            _application = null; // Deny access
        }

        if (_application != null)
        {
            await LoadMessagesAsync();
        }

        _isLoading = false;
    }

    private async Task LoadMessagesAsync()
    {
        _messages = await MessageService.GetMessagesForApplicationAsync(ApplicationId);

        if (_currentUserId != null)
        {
            await MessageService.MarkMessagesAsReadAsync(ApplicationId, _currentUserId);
        }
    }

    private bool _isSending;

    private async Task SendMessageAsync()
    {
        if (_isSending || string.IsNullOrWhiteSpace(_newMessage) || _currentUserId == null) return;

        _isSending = true;
        try
        {
            var text = _newMessage.Trim();
            _newMessage = "";
            var msg = await MessageService.SendMessageAsync(ApplicationId, _currentUserId, text);
            _messages.Add(msg);
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessageAsync();
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/applications");
    }

}
