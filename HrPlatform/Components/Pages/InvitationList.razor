@using HrPlatform.Data.Entities
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
<TimezoneInitializer/>
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IInvitationService InvitationService
@inject ICompanyService CompanyService

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2">
        <DebounceInput class="form-control form-control-sm bg-dark text-light border-secondary shadow-sm"
                       placeholder="Search by email, phone, or company"
                       @bind-Value="_searchTerm"
                       @bind-Value:after="ResetPageAndLoad"
                       disabled="@isLoading"/>
        <select class="form-select form-select-sm bg-dark text-light border-secondary shadow-sm" style="min-width: 140px;" @bind="_filterStatus" @bind:after="ResetPageAndLoad" disabled="@isLoading">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Used">Used</option>
            <option value="Expired">Expired</option>
        </select>
        @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_filterStatus))
        {
            <button class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="ClearFilters" disabled="@isLoading">Clear</button>
        }
        <button type="button" class="btn btn-sm btn-primary px-4 text-nowrap" @onclick="GoToInvite"><i class="bi bi-person-plus me-1"></i> Invite User
        </button>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
        <select class="form-select form-select-sm bg-dark text-light border-secondary shadow-sm" style="width: 70px;" @bind="PageSize" @bind:after="ResetPageAndLoad">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        Loading invitations…
    </div>
}
else
{
    @if (_statusMessage is not null)
    {
        <div class="alert @_statusClass alert-dismissible mb-3" role="alert">
            @_statusMessage
            <button type="button" class="btn-close"
                    @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <div>
        <div class="row g-3">
            @foreach (var inv in pagedInvitations)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 bg-white h-100 app-card">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <div class="d-flex flex-wrap align-items-center mb-2 gap-2">
                                        <h4 class="fw-bold mb-0 text-dark text-break">
                                            @if (!string.IsNullOrWhiteSpace(inv.Email))
                                            {
                                                @inv.Email
                                            }
                                            else
                                            {
                                                @inv.Phone
                                            }
                                        </h4>
                                        @if (inv.IsUsed)
                                        {
                                            <span class="badge bg-success rounded-pill" title="Used"><i class="bi bi-check-circle"></i> Used</span>
                                        }
                                        else if (inv.ExpiresAt < DateTime.UtcNow)
                                        {
                                            <span class="badge bg-secondary rounded-pill" title="Expired"><i class="bi bi-exclamation-triangle"></i> Expired</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill" title="Pending"><i
                                                    class="bi bi-hourglass-split"></i> Pending</span>
                                        }
                                    </div>

                                    <div class="mb-3 text-secondary small">
                                        <div class="d-flex flex-wrap align-items-center gap-3 mb-1">
                                            @if (!string.IsNullOrWhiteSpace(inv.Email))
                                            {
                                                <span><i class="bi bi-envelope"></i> @inv.Email</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(inv.Phone))
                                            {
                                                <span><i class="bi bi-telephone"></i> @inv.Phone</span>
                                            }
                                        </div>
                                        @if (inv.CompanyId.HasValue)
                                        {
                                            <div class="text-muted"><i class="bi bi-building"></i> @GetCompanyName(inv.CompanyId)</div>
                                        }
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 text-secondary small">
                                        <span class="badge bg-info rounded-pill px-3 py-2 border"><i class="bi bi-person-badge"></i> @inv.Role</span>
                                        <span
                                            class="badge bg-light @(inv.ExpiresAt < DateTime.UtcNow && !inv.IsUsed ? "text-danger border-danger" : "text-dark") rounded-pill px-3 py-2 border"><i
                                                class="bi bi-clock-history me-1"></i> Expires: @TimeZoneService.ToUserTime(inv.ExpiresAt).ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>

                                <div class="col-md-5 d-flex gap-2 justify-content-md-end align-items-end flex-wrap mt-3 mt-md-0">
                                    @if (!inv.IsUsed && inv.ExpiresAt < DateTime.UtcNow)
                                    {
                                        <button class="btn btn-outline-warning" @onclick="() => ResendInvitationAsync(inv)"><i
                                                class="bi bi-arrow-clockwise"></i> Resend
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteInvitationAsync(inv)"><i
                                            class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .app-card {
                transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            }

            .app-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
            }
        </style>
    </div>

    @if (pagedInvitations.Count == 0)
    {
        <div class="alert alert-info mt-3">No invitations found matching the selected filters.</div>
    }

    @if (totalPages > 1)
    {
        <nav aria-label="Invitation list pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                </li>

                @for (var i = 1; i <= totalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<Invitation> pagedInvitations = new();

    // UI State
    public string? SearchQuery { get; set; }
    public int? PageQuery { get; set; }
    public int? SizeQuery { get; set; }

    private int currentPage = 1;
    public int PageSize { get; set; } = 10;
    private int totalPages = 1;
    private string? _searchTerm;
    private string? _filterStatus;
    private bool isLoading;
    private string? _statusMessage;
    private string _statusClass = "alert-success";
    private List<Company> _companies = new();
    private bool isAdmin;
    private int? companyId;

    protected override async Task OnInitializedAsync()
    {
        _companies = await CompanyService.GetAllAsync();

        Nav.LocationChanged += OnLocationChanged;
        ParseParametersFromUri();

        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.IsInRole(RoleConstants.Admin);

        if (!isAdmin)
        {
            var companyIdClaim = user.FindFirst("companyId")?.Value;
            if (int.TryParse(companyIdClaim, out var parsedCompanyId))
            {
                companyId = parsedCompanyId;
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(async () =>
        {
            ParseParametersFromUri();
            await LoadAsync(_searchTerm);
            StateHasChanged();
        });
    }

    private void ParseParametersFromUri()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        _searchTerm = query.TryGetValue("q", out var q) ? (string?)q : null;
        _filterStatus = query.TryGetValue("status", out var s) ? (string?)s : null;
        currentPage = query.TryGetValue("page", out var p) && int.TryParse(p, out var page) ? page : 1;
        PageSize = query.TryGetValue("size", out var sz) && int.TryParse(sz, out var size) ? size : 10;

        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        ParseParametersFromUri();
        await LoadAsync(_searchTerm);
    }

    private string GetCompanyName(int? companyId)
    {
        if (companyId is null) return "—";
        return _companies.FirstOrDefault(c => c.Id == companyId.Value)?.Name ?? $"Company #{companyId.Value}";
    }

    private async Task LoadAsync(string? searchTerm)
    {
        isLoading = true;

        try
        {
            // Fetch a larger pool of data so pagination has content to work with
            var allInvitations = await InvitationService.GetRecentInvitationsAsync(500);
            var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;

            // 1. Role-based filtering
            if (user.IsInRole("Manager") && user.FindFirst("companyId") != null)
            {
                var userCompanyId = Convert.ToInt32(user.FindFirst("companyId")!.Value);
                allInvitations = allInvitations.Where(i => i.CompanyId == userCompanyId).ToList();
            }

            // 2. Search Text Filtering
            var filteredInvitations = allInvitations;
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filteredInvitations = allInvitations.Where(u =>
                        (u.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.Phone?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (GetCompanyName(u.CompanyId)?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }

            // 2.5 Status Filtering
            if (!string.IsNullOrWhiteSpace(_filterStatus))
            {
                var now = DateTime.UtcNow;
                if (_filterStatus.Equals("Used", StringComparison.OrdinalIgnoreCase))
                {
                    filteredInvitations = filteredInvitations.Where(i => i.IsUsed).ToList();
                }
                else if (_filterStatus.Equals("Expired", StringComparison.OrdinalIgnoreCase))
                {
                    filteredInvitations = filteredInvitations.Where(i => !i.IsUsed && i.ExpiresAt < now).ToList();
                }
                else if (_filterStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                {
                    filteredInvitations = filteredInvitations.Where(i => !i.IsUsed && i.ExpiresAt >= now).ToList();
                }
            }

            // 3. Calculate Pages
            totalPages = (int)Math.Ceiling(filteredInvitations.Count / (double)PageSize);
            if (totalPages < 1) totalPages = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            // 4. Extract current page items
            pagedInvitations = filteredInvitations
                .Skip((currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string RoleBadgeClass(string role)
    {
        return role switch
        {
            "Manager" => "bg-primary",
            "Driver" => "bg-info ",
            _ => ""
        };
    }

    private async Task ResetPageAndLoad()
    {
        currentPage = 1;
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tab"] = "invitations",
            ["page"] = null,
            ["size"] = PageSize == 10 ? null : PageSize,
            ["q"] = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
            ["status"] = string.IsNullOrWhiteSpace(_filterStatus) ? null : _filterStatus
        });
        await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", uri);
        await LoadAsync(_searchTerm);
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["tab"] = "invitations",
            ["page"] = page,
            ["size"] = PageSize,
            ["q"] = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
            ["status"] = string.IsNullOrWhiteSpace(_filterStatus) ? null : _filterStatus
        });
        Nav.NavigateTo(uri);
    }

    private async Task ClearFilters()
    {
        _searchTerm = null;
        _filterStatus = null;
        await ResetPageAndLoad();
    }

    private void GoToInvite()
    {
        Nav.NavigateTo("/users/invite");
    }

    private async Task ResendInvitationAsync(Invitation inv)
    {
        var baseUri = new Uri(Nav.BaseUri);
        var result = await InvitationService.ResendAsync(inv.Id, baseUri);

        _statusMessage = result.Success
            ? "Invitation resent successfully."
            : result.Error ?? "Failed to resend invitation.";
        _statusClass = result.Success ? "alert-success" : "alert-danger";

        await LoadAsync(_searchTerm);
    }

    private async Task DeleteInvitationAsync(Invitation inv)
    {
        var success = await InvitationService.DeleteAsync(inv.Id);
        if (success)
        {
            _statusMessage = "Invitation deleted successfully.";
            _statusClass = "alert-success";
            await LoadAsync(_searchTerm);
        }
        else
        {
            _statusMessage = "Failed to delete invitation.";
            _statusClass = "alert-danger";
        }
    }

}


