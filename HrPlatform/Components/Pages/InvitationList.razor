@using HrPlatform.Data.Entities
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IInvitationService InvitationService
@inject ICompanyService CompanyService

<div class="d-flex justify-content-between align-items-center mb-3">
    <button type="button" class="btn btn-primary btn-sm" @onclick="GoToInvite">+ Invite User</button>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        Loading invitations…
    </div>
}
else if (!pagedInvitations.Any() && string.IsNullOrEmpty(_searchTerm))
{
    <div class="alert alert-info">No invitations found.</div>
}
else
{
    <div class="mb-3" style="max-width:320px">
        <input class="form-control"
               placeholder="Search by email, phone, or company"
               value="@_searchTerm"
               @oninput="HandleSearchInput"/>
    </div>

    @if (_statusMessage is not null)
    {
        <div class="alert @_statusClass alert-dismissible mb-3" role="alert">
            @_statusMessage
            <button type="button" class="btn-close"
                    @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <div class="table-responsive d-none d-md-block">
        <table class="table  table-hover align-middle">
            <thead class="">
            <tr>
                <th>Contact</th>
                <th>Role</th>
                <th>Company</th>
                <th>Expires</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var inv in pagedInvitations)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(inv.Email))
                        {
                            <strong>@inv.Email</strong>
                        }
                        else
                        {
                            <strong>@inv.Phone</strong>
                        }

                        @if (!string.IsNullOrWhiteSpace(inv.Phone) && !string.IsNullOrWhiteSpace(inv.Email))
                        {
                            <br/>
                            <small class="">@inv.Phone</small>
                        }
                    </td>
                    <td>
                        <span class="badge @RoleBadgeClass(inv.Role)">
                            @inv.Role
                        </span>
                    </td>
                    <td>@GetCompanyName(inv.CompanyId)</td>
                    <td class="text-nowrap @(inv.ExpiresAt < DateTime.UtcNow ? "text-danger" : "")">
                        @inv.ExpiresAt.ToString("MMM dd, yyyy")
                    </td>
                    <td>
                        @if (inv.IsUsed)
                        {
                            <span class="badge bg-success">Used</span>
                        }
                        else if (inv.ExpiresAt < DateTime.UtcNow)
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge ">Expired</span>
                                <button class="btn btn-sm btn-outline-primary py-0"
                                        @onclick="() => ResendInvitationAsync(inv)">
                                    Resend
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-warning ">Pending</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="d-block d-md-none">
        @foreach (var inv in pagedInvitations)
        {
            <div class="card mb-3  border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h6 class="card-title mb-0 fw-bold">
                                @if (!string.IsNullOrWhiteSpace(inv.Email))
                                {
                                    @inv.Email
                                }
                                else
                                {
                                    @inv.Phone
                                }
                            </h6>
                            @if (!string.IsNullOrWhiteSpace(inv.Phone) && !string.IsNullOrWhiteSpace(inv.Email))
                            {
                                <small class="">@inv.Phone</small>
                            }
                        </div>
                        <div>
                            @if (inv.IsUsed)
                            {
                                <span class="badge bg-success">Used</span>
                            }
                            else if (inv.ExpiresAt < DateTime.UtcNow)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge ">Expired</span>
                                    <button class="btn btn-sm btn-outline-primary py-0"
                                            @onclick="() => ResendInvitationAsync(inv)">
                                        Resend
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-warning ">Pending</span>
                            }
                        </div>
                    </div>

                    <div class="card-text">
                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="">Role:</span>
                            <span class="badge @RoleBadgeClass(inv.Role)">@inv.Role</span>
                        </div>

                        <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                            <span class="">Company:</span>
                            <span class="text-end text-break ms-2">@GetCompanyName(inv.CompanyId)</span>
                        </div>

                        <div class="d-flex justify-content-between pt-1">
                            <span class="">Expires:</span>
                            <span class="@(inv.ExpiresAt < DateTime.UtcNow ? "text-danger fw-bold" : "")">
                            @inv.ExpiresAt.ToString("MMM dd, yyyy")
                        </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (pagedInvitations.Count == 0 && !string.IsNullOrEmpty(_searchTerm))
    {
        <div class="alert alert-info">No invitations match your search.</div>
    }

    @if (totalPages > 1)
    {
        <nav aria-label="Invitation list pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                </li>

                @for (var i = 1; i <= totalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<Invitation> pagedInvitations = new();

    // UI State
    private string _searchTerm = string.Empty;
    private string? _statusMessage;
    private string _statusClass = "alert-success";
    private bool isLoading = true;
    private List<Company> _companies = new();

    // Pagination State
    private int currentPage = 1;
    private const int PageSize = 10;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        _companies = await CompanyService.GetAllAsync();
        await LoadAsync(null);
    }

    private string GetCompanyName(int? companyId)
    {
        if (companyId is null) return "—";
        return _companies.FirstOrDefault(c => c.Id == companyId.Value)?.Name ?? $"Company #{companyId.Value}";
    }

    private async Task LoadAsync(string? searchTerm)
    {
        isLoading = true;

        try
        {
            // Fetch a larger pool of data so pagination has content to work with
            var allInvitations = await InvitationService.GetRecentInvitationsAsync(500);
            var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;

            // 1. Role-based filtering
            if (user.IsInRole("Manager") && user.FindFirst("companyId") != null)
            {
                var userCompanyId = Convert.ToInt32(user.FindFirst("companyId")!.Value);
                allInvitations = allInvitations.Where(i => i.CompanyId == userCompanyId).ToList();
            }

            // 2. Search Text Filtering
            var filteredInvitations = allInvitations;
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filteredInvitations = allInvitations.Where(u =>
                        (u.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.Phone?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (GetCompanyName(u.CompanyId)?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }

            // 3. Calculate Pages
            totalPages = (int)Math.Ceiling(filteredInvitations.Count / (double)PageSize);
            if (totalPages < 1) totalPages = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            // 4. Extract current page items
            pagedInvitations = filteredInvitations
                .Skip((currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string RoleBadgeClass(string role)
    {
        return role switch
        {
            "Manager" => "bg-primary",
            "Driver" => "bg-info ",
            _ => ""
        };
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        currentPage = 1; // Always reset to page 1 when modifying search filter
        await LoadAsync(_searchTerm);
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadAsync(_searchTerm);
    }

    private void GoToInvite()
    {
        Nav.NavigateTo("/users/invite");
    }

    private async Task ResendInvitationAsync(Invitation inv)
    {
        var baseUri = new Uri(Nav.BaseUri);
        var result = await InvitationService.ResendAsync(inv.Id, baseUri);

        _statusMessage = result.Success
            ? "Invitation resent successfully."
            : result.Error ?? "Failed to resend invitation.";
        _statusClass = result.Success ? "alert-success" : "alert-danger";

        await LoadAsync(_searchTerm);
    }

}


