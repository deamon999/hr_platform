@using HrPlatform.Data.Entities
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inject IInvitationService InvitationService
@inject ICompanyService CompanyService

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div class="d-flex justify-content-between align-items-center gap-2 w-100" style="max-width: 600px;">
        <div style="flex: 1;">
            <DebounceInput class="form-control"
                           placeholder="Search by email, phone, or company"
                           @bind-Value="_searchTerm"
                           @bind-Value:after="ResetPageAndLoad"
                           disabled="@isLoading" />
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
            <select class="form-select border-0 bg-white shadow-sm" style="width: 75px;" @bind="PageSize" @bind:after="ResetPageAndLoad">
                <option value="10">10</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
    <button type="button" class="btn btn-primary px-4" @onclick="GoToInvite">+ Invite User</button>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        Loading invitations…
    </div>
}
else if (!pagedInvitations.Any() && string.IsNullOrEmpty(_searchTerm))
{
    <div class="alert alert-info">No invitations found.</div>
}
else
{

    @if (_statusMessage is not null)
    {
        <div class="alert @_statusClass alert-dismissible mb-3" role="alert">
            @_statusMessage
            <button type="button" class="btn-close"
                    @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <div>
        <div class="row g-3">
            @foreach (var inv in pagedInvitations)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0 bg-white h-100 app-card">
                        <div class="card-body p-4">
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <div class="d-flex align-items-center mb-2 gap-2">
                                        <h4 class="fw-bold mb-0 text-dark">
                                            @if (!string.IsNullOrWhiteSpace(inv.Email))
                                            {
                                                @inv.Email
                                            }
                                            else
                                            {
                                                @inv.Phone
                                            }
                                        </h4>
                                        <span class="badge @RoleBadgeClass(inv.Role) rounded-pill px-3 py-1">@inv.Role</span>
                                    </div>
                                    
                                    <div class="mb-3 text-secondary small">
                                        @if (!string.IsNullOrWhiteSpace(inv.Phone) && !string.IsNullOrWhiteSpace(inv.Email))
                                        {
                                            <div class="mb-1"><i class="bi bi-telephone"></i> @inv.Phone</div>
                                        }
                                        <div class="d-flex align-items-center gap-3 mb-1">
                                            <span><i class="bi bi-building"></i> @GetCompanyName(inv.CompanyId)</span>
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 text-secondary small">
                                        <span class="badge bg-light @(inv.ExpiresAt < DateTime.UtcNow && !inv.IsUsed ? "text-danger border-danger" : "text-dark") rounded-pill px-3 py-2 border"><i class="bi bi-clock-history me-1"></i> Expires: @inv.ExpiresAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                                
                                <div class="col-md-5 d-flex flex-column gap-2 justify-content-center align-items-md-end mt-3 mt-md-0">
                                    <div class="mb-2">
                                        @if (inv.IsUsed)
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle"></i> Used</span>
                                        }
                                        else if (inv.ExpiresAt < DateTime.UtcNow)
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-exclamation-triangle"></i> Expired</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-hourglass-split"></i> Pending</span>
                                        }
                                    </div>
                                    
                                    <div class="d-flex gap-2 mt-2">
                                        @if (!inv.IsUsed && inv.ExpiresAt < DateTime.UtcNow)
                                        {
                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => ResendInvitationAsync(inv)">
                                                <i class="bi bi-arrow-clockwise"></i> Resend
                                            </button>
                                        }
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteInvitationAsync(inv)">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .app-card {
                transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
            }
            .app-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
            }
        </style>
    </div>

    @if (pagedInvitations.Count == 0 && !string.IsNullOrEmpty(_searchTerm))
    {
        <div class="alert alert-info">No invitations match your search.</div>
    }

    @if (totalPages > 1)
    {
        <nav aria-label="Invitation list pagination" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                </li>

                @for (var i = 1; i <= totalPages; i++)
                {
                    var pageIndex = i;
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<Invitation> pagedInvitations = new();

    // UI State
    [SupplyParameterFromQuery(Name = "q")]
    public string? _searchTerm { get; set; } = string.Empty;

    private string? _statusMessage;
    private string _statusClass = "alert-success";
    private bool isLoading = true;
    private List<Company> _companies = new();

    // Pagination State
    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 10;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        _companies = await CompanyService.GetAllAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;
        await LoadAsync(_searchTerm);
    }

    private string GetCompanyName(int? companyId)
    {
        if (companyId is null) return "—";
        return _companies.FirstOrDefault(c => c.Id == companyId.Value)?.Name ?? $"Company #{companyId.Value}";
    }

    private async Task LoadAsync(string? searchTerm)
    {
        isLoading = true;

        try
        {
            // Fetch a larger pool of data so pagination has content to work with
            var allInvitations = await InvitationService.GetRecentInvitationsAsync(500);
            var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;

            // 1. Role-based filtering
            if (user.IsInRole("Manager") && user.FindFirst("companyId") != null)
            {
                var userCompanyId = Convert.ToInt32(user.FindFirst("companyId")!.Value);
                allInvitations = allInvitations.Where(i => i.CompanyId == userCompanyId).ToList();
            }

            // 2. Search Text Filtering
            var filteredInvitations = allInvitations;
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filteredInvitations = allInvitations.Where(u =>
                        (u.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (u.Phone?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (GetCompanyName(u.CompanyId)?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                    .ToList();
            }

            // 3. Calculate Pages
            totalPages = (int)Math.Ceiling(filteredInvitations.Count / (double)PageSize);
            if (totalPages < 1) totalPages = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            // 4. Extract current page items
            pagedInvitations = filteredInvitations
                .Skip((currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string RoleBadgeClass(string role)
    {
        return role switch
        {
            "Manager" => "bg-primary",
            "Driver" => "bg-info ",
            _ => ""
        };
    }

    private async Task ResetPageAndLoad()
    {
        currentPage = 1;
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = null,
            ["size"] = PageSize == 10 ? null : PageSize,
            ["q"] = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm
        });
        await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", uri);
        await LoadAsync(_searchTerm);
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = page,
            ["size"] = PageSize,
            ["q"] = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm
        });
        Nav.NavigateTo(uri);
    }

    private void GoToInvite()
    {
        Nav.NavigateTo("/users/invite");
    }

    private async Task ResendInvitationAsync(Invitation inv)
    {
        var baseUri = new Uri(Nav.BaseUri);
        var result = await InvitationService.ResendAsync(inv.Id, baseUri);

        _statusMessage = result.Success
            ? "Invitation resent successfully."
            : result.Error ?? "Failed to resend invitation.";
        _statusClass = result.Success ? "alert-success" : "alert-danger";

        await LoadAsync(_searchTerm);
    }

    private async Task DeleteInvitationAsync(Invitation inv)
    {
        var success = await InvitationService.DeleteAsync(inv.Id);
        if (success)
        {
            _statusMessage = "Invitation deleted successfully.";
            _statusClass = "alert-success";
            await LoadAsync(_searchTerm);
        }
        else
        {
            _statusMessage = "Failed to delete invitation.";
            _statusClass = "alert-danger";
        }
    }

}


