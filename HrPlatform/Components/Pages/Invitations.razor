@page "/invitations"
@rendermode InteractiveServer

@using HrPlatform.Data.Entities
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IInvitationService InvitationService
@inject ICompanyService CompanyService

<PageTitle>Invitation Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Invitations</h2>
    <button type="button" class="btn btn-primary btn-sm" @onclick="GoToInvite">+ Invite User</button>
</div>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        Loading invitations…
    </div>
}
else if (!_recentInvitations.Any())
{
    <p>No invitations found.</p>
}
else
{
    <div class="mb-3" style="max-width:320px">
        <input class="form-control"
               placeholder="Search by email or phone number or company name"
               value="@_searchTerm"
               @oninput="HandleSearchInput"/>
    </div>

    @if (_statusMessage is not null)
    {
        <div class="alert @_statusClass alert-dismissible mb-3" role="alert">
            @_statusMessage
            <button type="button" class="btn-close"
                    @onclick="() => _statusMessage = null"></button>
        </div>
    }

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">Recent Invitations</span>
                <button class="btn btn-link btn-sm p-0" @onclick="async () => await LoadAsync(null)">
                    ↺ Refresh
                </button>
            </div>
            <div class="card-body p-0">
                @if (_recentInvitations.Count == 0)
                {
                    <p class="text-muted p-3 mb-0">No invitations sent yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                            <tr>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Company</th>
                                <th>Expires</th>
                                <th>Status</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var inv in _recentInvitations)
                            {
                                <tr>
                                    <td class="text-truncate" style="max-width:160px">
                                        @inv.Email
                                    </td>
                                    <td>
                                                <span class="badge @RoleBadgeClass(inv.Role)">
                                                    @inv.Role
                                                </span>
                                    </td>
                                    <td>@GetCompanyName(inv.CompanyId)</td>
                                    <td class="@(inv.ExpiresAt < DateTime.UtcNow ? "text-danger" : "")">
                                        @inv.ExpiresAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @if (inv.IsUsed)
                                        {
                                            <span class="badge bg-success">Used</span>
                                        }
                                        else if (inv.ExpiresAt < DateTime.UtcNow)
                                        {
                                            <span class="badge bg-secondary">Expired</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<Invitation> _recentInvitations = new();
    private string _searchTerm = string.Empty;
    private string? _statusMessage;
    private string _statusClass = "alert-success";
    private bool isLoading = true;
    private List<Company> _companies = new();

    protected override async Task OnInitializedAsync()
    {
        _companies = await CompanyService.GetAllAsync();
        await LoadAsync(null);
    }

    private string GetCompanyName(int? companyId)
    {
        if (companyId is null)
        {
            return "—";
        }

        return _companies.FirstOrDefault(c => c.Id == companyId.Value)?.Name
               ?? $"Company #{companyId.Value}";
    }

    private async Task LoadAsync(string? searchTerm)
    {
        isLoading = true;
        _recentInvitations = await InvitationService.GetRecentInvitationsAsync(20);
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        if (user.IsInRole("Manager") && user.FindFirst("companyId") != null)
        {
            _recentInvitations = _recentInvitations.Where(i => i.CompanyId == Convert.ToInt32(user.FindFirst("companyId").Value)).ToList();
        }

        if (!string.IsNullOrEmpty(searchTerm))
        {
            _recentInvitations = _recentInvitations.Where(u =>
                    string.IsNullOrEmpty(_searchTerm) ||
                    (u.Email?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Phone?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }

        isLoading = false;
    }

    private static string RoleBadgeClass(string role) => role switch
    {
        "Manager" => "bg-primary",
        "Driver" => "bg-info text-dark",
        _ => "bg-secondary"
    };

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadAsync(_searchTerm); // Reload data whenever the search term changes
    }

    private void GoToInvite()
    {
        Nav.NavigateTo("/users/invite");
    }

    private void GoToView(string id)
    {
        Nav.NavigateTo($"/users/{id}");
    }

    private void GoToEdit(string id)
    {
        Nav.NavigateTo($"/users/edit/{id}");
    }

    private async Task DeleteAsync()
    {
        // TODO implement deltetion of invitation
        await LoadAsync(null);
    }

}