@page "/companies"
@using HrPlatform.Models
@rendermode InteractiveServer

@attribute [Authorize(Roles = RoleConstants.Admin)]
@inject ICompanyService CompanySvc
@inject NavigationManager Nav

<PageTitle>Companies</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Companies</h2>
    <button type="button" class="btn btn-primary" @onclick="GoToCreate">Create Company</button>
</div>

@if (paginationResult is null)
{
    <p>Loading...</p>
}
else if (!paginationResult.Items.Any())
{
    <div class="alert alert-info">No companies created yet.</div>
}
else
{
    <div class="d-none d-lg-block">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Reg #</th>
                    <th>Registered</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var c in paginationResult.Items)
                {
                    <tr>
                        <td><strong>@c.Name</strong></td>
                        <td>@c.RegistrationNumber</td>
                        <td>@((c.DateRegistered?.ToString("d") ?? "—"))</td>
                        <td>
                            <div class="d-flex gap-1 flex-nowrap">
                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => GoToView(c.Id)">View</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => GoToEdit(c.Id)">Edit</button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="async () => ConfirmDelete(c)">Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-block d-lg-none">
        @foreach (var c in paginationResult.Items)
        {
            var company = c;
            <div class="card mb-3 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0 fw-bold">@company.Name</h5>
                        <div></div>
                    </div>

                    <div class="mb-3 text-muted small">
                        <strong>Reg #:</strong> @company.RegistrationNumber<br/>
                        <strong>Registered:</strong> @((company.DateRegistered?.ToString("d") ?? "—"))
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-3 pt-3 border-top">
                        <button type="button" class="btn btn-sm btn-primary flex-grow-1" @onclick="() => GoToView(company.Id)">View</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" @onclick="() => GoToEdit(company.Id)">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger flex-grow-1" @onclick="async () => ConfirmDelete(company)">Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (paginationResult.TotalPages > 1)
    {
        <nav aria-label="Company list pagination" class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                </li>

                @for (int i = 1; i <= paginationResult.TotalPages; i++)
                {
                    var pageIndex = i; // Local variable capture needed for Blazor loops
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }

                <li class="page-item @(currentPage == paginationResult.TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>

            </ul>
        </nav>
    }
}

@if (deleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    Delete <strong>@deleteTarget.Name</strong>?
                    This will also remove all @deleteTarget.Jobs.Count job(s) and @deleteTarget.Users.Count user(s).
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PaginationResult<Company>? paginationResult;
    private Company? deleteTarget;

    // Pagination State
    private int currentPage = 1;
    private const int PageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Calling your paged service
        paginationResult = await CompanySvc.GetPagedAsync(currentPage, PageSize);
    }

    private async Task ChangePage(int page)
    {
        // Prevent out-of-bounds clicks
        if (page < 1 || page > (paginationResult?.TotalPages ?? 1)) return;

        currentPage = page;
        await LoadAsync();
    }

    private void GoToCreate()
    {
        Nav.NavigateTo("/companies/new");
    }

    private void GoToView(int id)
    {
        Nav.NavigateTo($"/companies/{id}");
    }

    private void GoToEdit(int id)
    {
        Nav.NavigateTo($"/companies/edit/{id}");
    }

    private void ConfirmDelete(Company? company)
    {
        deleteTarget = company;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget is null) return;
        await CompanySvc.DeleteAsync(deleteTarget.Id);
        deleteTarget = null;

        // Reload current page after delete, falling back to page 1 if current page becomes empty
        await LoadAsync();
        if (paginationResult?.Items.Any() == false && currentPage > 1)
        {
            currentPage--;
            await LoadAsync();
        }
    }
}