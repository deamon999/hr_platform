@page "/companies"
@using HrPlatform.Models
@rendermode InteractiveServer

@attribute [Authorize(Roles = RoleConstants.Admin)]
@inject ICompanyService CompanySvc
@inject NavigationManager Nav

<PageTitle>Companies</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Companies</h2>
    <button type="button" class="btn btn-primary" @onclick="GoToCreate">Create Company</button>
</div>

<div class="d-flex justify-content-between align-items-center gap-2 mb-3">
    <div class="d-flex flex-wrap align-items-center gap-2" style="flex: 1;">
        <input type="text" class="form-control form-control-sm" style="width: 250px;" placeholder="Search company name..." @bind="searchName" @bind:after="ResetPageAndLoad" />
        <select class="form-select form-select-sm w-auto" style="min-width: 200px;" @bind="sortBy" @bind:after="ResetPageAndLoad">
            <option value="name">Sort: Name</option>
            <option value="date">Sort: Date Registered</option>
        </select>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
        <select class="form-select form-select-sm border-0 bg-white shadow-sm" style="width: 70px;" @bind="PageSize" @bind:after="ResetPageAndLoad">
            <option value="10">10</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (paginationResult is null)
{
    <p>Loading...</p>
}
else if (!paginationResult.Items.Any())
{
    <div class="alert alert-info">No companies created yet.</div>
}
else
{
    <div class="row g-3">
        @foreach (var c in paginationResult.Items)
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 bg-white h-100 app-card">
                    <div class="card-body p-4">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-7">
                                <h4 class="fw-bold mb-2 text-dark">@c.Name</h4>
                                <div class="text-secondary small">
                                    <span class="me-3"><i class="bi bi-building"></i> Reg #: @c.RegistrationNumber</span>
                                    <span><i class="bi bi-calendar3"></i> Registered @((c.DateRegistered?.ToString("MMM dd, yyyy") ?? "—"))</span>
                                </div>
                            </div>
                            
                            <div class="col-md-5 d-flex gap-2 justify-content-md-end flex-wrap">
                                <button type="button" class="btn btn-primary px-4" @onclick="() => GoToView(c.Id)">View</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => GoToEdit(c.Id)">Edit</button>
                                <button type="button" class="btn btn-outline-danger" @onclick="async () => ConfirmDelete(c)"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <style>
        .app-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .app-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
        }
    </style>

    @if (paginationResult.TotalPages > 1)
    {
        <nav aria-label="Company list pagination" class="mt-4">
            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" tabindex="-1">Previous</button>
                </li>

                @for (int i = 1; i <= paginationResult.TotalPages; i++)
                {
                    var pageIndex = i; // Local variable capture needed for Blazor loops
                    <li class="page-item @(currentPage == pageIndex ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    </li>
                }

                <li class="page-item @(currentPage == paginationResult.TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)">Next</button>
                </li>

            </ul>
        </nav>
    }
}

@if (deleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    Delete <strong>@deleteTarget.Name</strong>?
                    This will also remove all @deleteTarget.Jobs.Count job(s) and @deleteTarget.Users.Count user(s).
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => deleteTarget = null">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteConfirmedAsync">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private PaginationResult<Company>? paginationResult;
    private Company? deleteTarget;
    [SupplyParameterFromQuery(Name = "q")]
    public string? searchName { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    public string sortBy { get; set; } = "name";

    // Pagination State
    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 10;

    protected override async Task OnParametersSetAsync()
    {
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;
        await LoadAsync();
    }

    private void ResetPageAndLoad()
    {
        ChangePage(1);
    }

    private async Task LoadAsync()
    {
        // Calling your paged service
        paginationResult = await CompanySvc.GetPagedAsync(currentPage, PageSize, searchName, sortBy);
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = page,
            ["size"] = PageSize,
            ["q"] = string.IsNullOrWhiteSpace(searchName) ? null : searchName,
            ["sort"] = sortBy == "name" ? null : sortBy
        });
        Nav.NavigateTo(uri);
    }

    private void GoToCreate()
    {
        Nav.NavigateTo("/companies/new");
    }

    private void GoToView(int id)
    {
        Nav.NavigateTo($"/companies/{id}");
    }

    private void GoToEdit(int id)
    {
        Nav.NavigateTo($"/companies/edit/{id}");
    }

    private void ConfirmDelete(Company? company)
    {
        deleteTarget = company;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget is null) return;
        await CompanySvc.DeleteAsync(deleteTarget.Id);
        deleteTarget = null;

        // Reload current page after delete, falling back to page 1 if current page becomes empty
        await LoadAsync();
        if (paginationResult?.Items.Any() == false && currentPage > 1)
        {
            currentPage--;
            await LoadAsync();
        }
    }
}


