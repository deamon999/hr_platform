@page "/companies/new"
@page "/companies/{Id:int}"
@page "/companies/edit/{Id:int}"
@page "/my-company"
@using System.Security.Claims
@rendermode InteractiveServer

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Driver},{RoleConstants.Manager}")]
@inject ICompanyService CompanySvc
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<PageTitle>@Title</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-dark">@Title</h2>
    @if (isView && company != null && user != null)
    {
        <div class="d-flex gap-2">
            @{
                bool canEdit = user.IsInRole(RoleConstants.Admin) || 
                               (user.IsInRole(RoleConstants.Manager) && user.FindFirst("companyId")?.Value == company.Id.ToString());
            }
            @if (canEdit)
            {
                <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="() => GoToEdit(company.Id)"><i class="bi bi-pencil me-1"></i> Edit</button>
            }
            @if (user.IsInRole(RoleConstants.Admin))
            {
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="Cancel"><i class="bi bi-arrow-left me-1"></i> Back</button>
            }
        </div>
    }
</div>

@if (company is null)
{
    <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-border spinner-border-sm"></div>
        Loading...
    </div>
}
else
{
    <div class="card shadow-sm border-0 app-card mb-4">
        <div class="card-body p-4">
            <EditForm Model="company" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator/>
                <ValidationSummary class="text-danger mb-4"/>

                <div class="row g-4 mb-4">
                    <div class="col-md-12">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Company Name *</label>
                        <InputText class="form-control form-control-lg bg-light border-0" @bind-Value="company.Name" disabled="@isView"/>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Registration #</label>
                        <InputText class="form-control bg-light border-0" @bind-Value="company.RegistrationNumber" disabled="@isView"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Date Registered</label>
                        <InputDate class="form-control bg-light border-0" @bind-Value="company.DateRegistered" disabled="@isView"/>
                    </div>
                    
                    <div class="col-12">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Address</label>
                        <InputText class="form-control bg-light border-0" @bind-Value="company.Address" disabled="@isView"/>
                    </div>
                    
                    <div class="col-12">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Description</label>
                        <InputTextArea class="form-control bg-light border-0" @bind-Value="company.Description" disabled="@isView" rows="3"/>
                    </div>
                    
                    <div class="col-12">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Website URL</label>
                        <InputText class="form-control bg-light border-0" @bind-Value="company.WebsiteUrl" disabled="@isView"/>
                    </div>
                </div>

                <hr class="my-4 text-muted opacity-25" />
                <h5 class="fw-bold mb-3">Trucking & Benefits</h5>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small text-uppercase">Fleet Size</label>
                        <InputNumber class="form-control bg-light border-0" @bind-Value="company.FleetSize" disabled="@isView"/>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Typical Route Type</label>
                        <InputSelect class="form-select bg-light text-dark border-secondary" @bind-Value="company.RouteType" disabled="@isView">
                            <option value="">-- Select --</option>
                            @foreach (var rt in Enum.GetValues<HrPlatform.Data.Enums.RouteType>())
                            {
                                <option value="@rt">@rt.ToString()</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                
                <div class="row g-4 mb-4">
                    <div class="col-md-3">
                        <div class="form-check form-switch mt-1">
                            <InputCheckbox class="form-check-input" @bind-Value="company.PaidCdlTraining" disabled="@isView" id="paidTraining" />
                            <label class="form-check-label fw-medium ms-2" for="paidTraining">Paid CDL Training</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check form-switch mt-1">
                            <InputCheckbox class="form-check-input" @bind-Value="company.SignOnBonus" disabled="@isView" id="signOnBonus" />
                            <label class="form-check-label fw-medium ms-2" for="signOnBonus">Sign-On Bonus</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check form-switch mt-1">
                            <InputCheckbox class="form-check-input" @bind-Value="company.BenefitsOffered" disabled="@isView" id="benefits" />
                            <label class="form-check-label fw-medium ms-2" for="benefits">Benefits Offered</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check form-switch mt-1">
                            <InputCheckbox class="form-check-input" @bind-Value="company.HiringNewGrads" disabled="@isView" id="newGrads" />
                            <label class="form-check-label fw-medium ms-2" for="newGrads">Hiring New Grads</label>
                        </div>
                    </div>
                </div>
                
                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary small text-uppercase">Benefits Summary</label>
                    <InputTextArea class="form-control bg-light border-0" @bind-Value="company.BenefitsSummary" disabled="@isView" rows="2"/>
                </div>

                @if (!isView)
                {
                    <div class="d-flex gap-2 pt-3 border-top border-secondary">
                        <button type="submit" class="btn btn-primary px-5 py-2 fw-bold rounded-pill">
                            @(isNew ? "Create Company" : "Save Changes")
                        </button>
                        <button type="button" class="btn btn-outline-secondary px-4 py-2 rounded-pill" @onclick="Cancel">Cancel</button>
                    </div>
                }
            </EditForm>
        </div>
    </div>
}

<style>
    .app-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private Company? company;
    private int companyId;
    private bool isNew;
    private bool isView;
    private ClaimsPrincipal user = default!;

    private string Title => isView ? "Company Details" : (isNew ? "Create Company" : "Edit Company");

    protected override async Task OnInitializedAsync()
    {
        companyId = Id;
        var auth = await AuthState.GetAuthenticationStateAsync();
        user = auth.User;
        var uri = Nav.Uri.ToLower();

        // Determine mode based on URL
        isNew = uri.Contains("/new");
        isView = !isNew && !uri.Contains("/edit/");

        if (isNew)
        {
            if (!user.IsInRole(RoleConstants.Admin))
            {
                Nav.NavigateTo("/");
                return;
            }
            company = new Company();
        }
        else
        {
            if (companyId == 0)
            {
                string? companyClaim = user.FindFirst("companyId")?.Value;
                if (!string.IsNullOrEmpty(companyClaim))
                {
                    companyId = int.Parse(companyClaim);
                }
            }

            // Security check: if trying to edit, ensure permissions
            if (!isView && !user.IsInRole(RoleConstants.Admin))
            {
                if (user.IsInRole(RoleConstants.Driver))
                {
                    Nav.NavigateTo("/");
                    return;
                }

                string? companyClaim = user.FindFirst("companyId")?.Value;
                if (companyClaim != null && int.TryParse(companyClaim, out int userCompanyId))
                {
                    if (companyId != 0 && companyId != userCompanyId)
                    {
                        Nav.NavigateTo("/");
                        return;
                    }
                }
            }

            company = await CompanySvc.GetByIdAsync(companyId);
            if (company is null) Nav.NavigateTo("/companies");
        }
    }

    private async Task SaveAsync()
    {
        if (isView) return; // Guard clause

        if (isNew)
        {
            if (!user.IsInRole(RoleConstants.Admin)) return;
            await CompanySvc.CreateAsync(company!);
        }
        else
        {
            if (!user.IsInRole(RoleConstants.Admin))
            {
                if (user.IsInRole(RoleConstants.Driver)) return;
                string? companyClaim = user.FindFirst("companyId")?.Value;
                if (companyClaim != null && int.TryParse(companyClaim, out int userCompanyId))
                {
                    if (company!.Id != userCompanyId) return;
                }
            }
            await CompanySvc.UpdateAsync(company!);
        }

        GoBack();
    }

    private void Cancel()
    {
        GoBack();
    }

    private void GoToEdit(int id)
    {
        Nav.NavigateTo($"/companies/edit/{id}");
    }

    private void GoBack()
    {
        if (user.IsInRole(RoleConstants.Admin))
        {
            Nav.NavigateTo("/companies");
        }
        else
        {
            Nav.NavigateTo("/my-company");
        }
    }

}
