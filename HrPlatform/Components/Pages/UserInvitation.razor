@page "/users/invite"
@page "/jobs/invite/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using HrPlatform.Data.Entities
@using HrPlatform.Models

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject ICompanyService CompanyService
@inject IInvitationService InvitationService
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject RoleManager<IdentityRole> RoleManager

<PageTitle>Send Invitation</PageTitle>

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-dark">Send Invitation</h2>
        <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="GoToInvitations">
            <i class="bi bi-arrow-left me-1"></i> Back to Invitations
        </button>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0 app-card">
                <div class="card-body p-4 p-md-5">

                    @if (!string.IsNullOrEmpty(_successMessage))
                    {
                        <div class="alert alert-success alert-dismissible" role="alert">
                            @_successMessage
                            <button type="button" class="btn-close"
                                    @onclick="() => _successMessage = string.Empty"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            @_errorMessage
                            <button type="button" class="btn-close"
                                    @onclick="() => _errorMessage = string.Empty"></button>
                        </div>
                    }

                    <EditForm Model="_model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator/>
                        <ValidationSummary class="text-danger"/>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Contact Method</label>
                            
                            <div class="d-flex gap-3 mt-2">
                                <InputRadioGroup @bind-Value="_model.ContactMethod" Name="contactMethod">
                                    <div class="form-check form-check-inline">
                                        <InputRadio class="form-check-input" Value="@ContactMethod.Email" id="contactEmail"/>
                                        <label class="form-check-label fw-medium ms-1" for="contactEmail">Email</label>
                                    </div>

                                    <div class="form-check form-check-inline">
                                        <InputRadio class="form-check-input" Value="@ContactMethod.Phone" id="contactPhone"/>
                                        <label class="form-check-label fw-medium ms-1" for="contactPhone">Phone</label>
                                    </div>
                                </InputRadioGroup>
                            </div>
                        </div>

                        @if (_model.ContactMethod == ContactMethod.Phone)
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-secondary small text-uppercase">Phone Number</label>
                                <InputText class="form-control form-control-lg bg-light border-0" @bind-Value="_model.Phone" placeholder="+1234567890"/>
                                <ValidationMessage For="() => _model.Phone" class="text-danger small mt-1"/>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-secondary small text-uppercase">Email address</label>
                                <InputText @bind-Value="_model.Email"
                                           class="form-control form-control-lg bg-light border-0"
                                           placeholder="user@example.com"/>
                                <ValidationMessage For="() => _model.Email" class="text-danger small mt-1"/>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small text-uppercase">Role</label>
                            <InputSelect @bind-Value="_model.Role" class="form-select form-select-lg bg-light border-0">
                                <option value="">-- Select a role --</option>
                                @foreach (var role in _roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => _model.Role" class="text-danger small mt-1"/>
                        </div>

                        @if (_model.Role == "Manager")
                        {
                            <div class="mb-4">
                                <label class="form-label fw-semibold text-secondary small text-uppercase">Company</label>
                                <InputSelect @bind-Value="_model.CompanyId"
                                             class="form-select form-select-lg bg-light border-0"
                                             disabled="@_isManager">
                                    <option value="">-- Select a company --</option>
                                    @foreach (var company in _companies)
                                    {
                                        <option value="@company.Id">@company.Name</option>
                                    }
                                </InputSelect>
                                <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i> This will be stored on the user's profile automatically.</div>
                                <ValidationMessage For="() => _model.CompanyId" class="text-danger small mt-1"/>
                            </div>
                        }

                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold" disabled="@_sending">
                                @if (_sending)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                }
                                Send Invitation
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .app-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
</style>

@code {
    [Parameter] public int? Id { get; set; }
    private InviteModel _model = new();
    private string _successMessage = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _sending;
    private List<Company> _companies = new();
    private List<string> _roles = new();
    private AuthenticationState auth = default!;
    private bool _isManager;

    protected override async Task OnInitializedAsync()
    {
        _companies = await CompanyService.GetAllAsync();
        _roles = RoleManager.Roles
            .Select(r => r.Name)
            .ToList()!;
        auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        _isManager = user.IsInRole(RoleConstants.Manager);
        
        if (Id.HasValue)
        {
            _model.JobId = Id.Value;
            _roles = _roles
                .Where(r => r.Equals(RoleConstants.Driver, StringComparison.OrdinalIgnoreCase))
                .ToList()!;
            _model.Role = RoleConstants.Driver;
            
            if (_isManager)
            {
                _model.CompanyId = Convert.ToInt32(user.FindFirstValue("companyId"));
            }
        }
        else if (!Id.HasValue && user.IsInRole(RoleConstants.Manager))
        {
            // Managers can invite Managers and Drivers, but not Admins
            _roles = _roles
                .Where(r => !r.Equals(RoleConstants.Admin, StringComparison.OrdinalIgnoreCase))
                .ToList()!;
            _model.CompanyId = Convert.ToInt32(user.FindFirstValue("companyId"));
        }
        else
        {
            // Admins can invite anyone, including other Admins
        }
    }

    private async Task HandleSubmit()
    {
        _sending = true;
        _successMessage = string.Empty;
        _errorMessage = string.Empty;

        try
        {
            if (_isManager)
            {
                if (string.Equals(_model.Role, RoleConstants.Admin, StringComparison.OrdinalIgnoreCase))
                {
                    _errorMessage = "You do not have permission to invite an Admin.";
                    return;
                }
                // Force company to be the manager's company to prevent tampering
                var companyClaim = auth.User.FindFirstValue("companyId");
                if (companyClaim != null && int.TryParse(companyClaim, out int userCompanyId))
                {
                    _model.CompanyId = userCompanyId;
                }
            }

            if (_model.Role == RoleConstants.Manager && _model.CompanyId is null)
            {
                _errorMessage = "Please select a company for the manager invitation.";
                return;
            }

            if (_model.CompanyId.HasValue)
            {
                var companyExists = await CompanyService.GetByIdAsync(_model.CompanyId.Value);
                if (companyExists == null)
                {
                    _errorMessage = "Selected company was not found.";
                    return;
                }
            }

            var normalisedEmail = _model.Email?.Trim().ToLowerInvariant() ?? "";
            var normalisedPhone = _model.Phone?.Trim().ToLowerInvariant() ?? "";

            var invitation = new Invitation
            {
                ContactMethod = _model.ContactMethod,
                Email = normalisedEmail,
                Phone = normalisedPhone,
                Role = _model.Role,
                CompanyId = _model.CompanyId,
                JobId = _model.JobId
            };

            var link = Nav.ToAbsoluteUri($"/Account/Register?token={invitation.Token}");

            var inviteAsyncResult = await InvitationService.InviteAsync(invitation, link);
            if (inviteAsyncResult.Success)
            {
                _successMessage = ContactMethod.Email == invitation.ContactMethod ? $"Invitation sent to {invitation.Email}." : $"Invitation sent to {invitation.Phone}.";   
            }
            else
            {
                _errorMessage = ContactMethod.Email == invitation.ContactMethod ? $"Invitation was not sent to {invitation.Email}." : $"Invitation was not sent to {invitation.Phone}.";
            }

            await InvitationService.CreateAsync(invitation);
            _model = new();
            await GoToInvitations();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to send invitation: {ex.Message}";
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task GoToInvitations()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }

}
