@page "/jobs/{Id:int}"
@using System.Security.Claims
@using HrPlatform.Utils
@rendermode InteractiveServer

@inject IJobService JobSvc
@inject IJobApplicationService AppSvc
@inject IDriverProfileService ProfileSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Job Details</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Job Details</h2>
    <AuthorizeView Roles="@($"{RoleConstants.Manager}")">
        <button type="button" class="btn btn-primary btn-sm" @onclick="GoToInvite">+ Invite User</button>
    </AuthorizeView>
</div>

@if (loading)
{
    <p>Loading...</p>
}
else if (job is null)
{
    <div class="alert alert-danger">Job not found.</div>
}
else
{
    <div class="card mb-4 ">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Job Information</h4>

            @if (job.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge ">Inactive</span>
            }
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Job Title</label>
                    <input class="form-control" value="@Display(job.Title)" disabled/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Company</label>
                    <input class="form-control" value="@Display(job.Company?.Name)" disabled/>
                </div>

                <div class="col-md-5">
                    <label class="form-label">City</label>
                    <input class="form-control" value="@Display(job.City)" disabled/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">State</label>
                    <input class="form-control" value="@Display(job.State)" disabled/>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Zip Code</label>
                    <input class="form-control" value="@Display(job.ZipCode)" disabled/>
                </div>

                <div class="col-12">
                    <label class="form-label">Job Description</label>
                    <textarea class="form-control" rows="8" disabled>@Display(job.Description)</textarea>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Pay Rate</label>
                    <input class="form-control" value="@(job.PayRate.HasValue ? $"${job.PayRate.Value:N2}" : "")" disabled/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Pay Period</label>
                    <input class="form-control" value="@(job.PayPeriod.HasValue ? $"per {job.PayPeriod.ToString()!.ToLower()}" : "")" disabled/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Pay Notes</label>
                    <input class="form-control" value="@Display(job.PayNotes)" disabled/>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Required CDL Class</label>
                    <input class="form-control" value="@(job.RequiredCdlClass.HasValue ? $"CDL-{job.RequiredCdlClass}" : "Any")" disabled/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Required Trailer Type</label>
                    <input class="form-control" value="@(job.RequiredTrailerType?.ToString() ?? "Any")" disabled/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Min. Years Experience</label>
                    <input class="form-control" value="@(job.MinYearsExperience > 0 ? job.MinYearsExperience.ToString() : "")" disabled/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Employment Type</label>
                    <input class="form-control" value="@(job.EmploymentType.HasValue ? job.EmploymentType.Value.GetDescriptionValue() : "Any")"
                           disabled/>
                </div>

                <div class="col-12">
                    <label class="form-label d-block">Required Endorsements</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var end in Enum.GetValues<CdlEndorsement>())
                        {
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="end_@end"
                                       checked="@job.RequiredEndorsements.Contains(end)"
                                       disabled/>
                                <label class="form-check-label" for="end_@end">@end</label>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Posted</label>
                    <input class="form-control" value="@job.PostedAt.ToLocalTime().ToString("MM/dd/yyyy")" disabled/>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Updated</label>
                    <input class="form-control" value="@job.UpdatedAt.ToLocalTime().ToString("MM/dd/yyyy")" disabled/>
                </div>
            </div>
        </div>
    </div>

    <AuthorizeView Roles="Driver">
        <Authorized>
            @if (applied)
            {
                <div class="alert alert-success">
                    <h5 class="alert-heading">Application Submitted!</h5>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Job ID</label>
                            <input class="form-control" value="#@appliedApp.Job.Title" disabled/>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Date Submitted</label>
                            <input class="form-control" value="@appliedApp.AppliedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")" disabled/>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <input class="form-control" value="@appliedApp.Status" disabled/>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="GoToEditProfile">
                            Review Profile
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="GoToApplications">
                            All Applications
                        </button>
                    </div>
                </div>
            }
            else if (alreadyApplied)
            {
                <div class="alert alert-info">You have already applied for this position.</div>
            }
            else if (driverProfile is null)
            {
                <div class="alert alert-warning">
                    <strong>Driver profile required.</strong>
                    <a class="alert-link ms-1" role="button" style="cursor:pointer" @onclick="GoToCreateProfile">
                        Create your profile
                    </a>
                    before applying.
                </div>
            }
            else
            {
                <div class="card mb-4 ">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Step 1 - Review Your Profile</strong>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GoToEditProfile">
                            Update Profile
                        </button>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">First Name</label>
                                <input class="form-control" value="@Display(driverProfile.FirstName)" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Last Name</label>
                                <input class="form-control" value="@Display(driverProfile.LastName)" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Email</label>
                                <input class="form-control" value="@Display(driverProfile.Email)" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Phone</label>
                                <input class="form-control" value="@Display(driverProfile.PhoneNumber)" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">City</label>
                                <input class="form-control" value="@Display(driverProfile.City)" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">State</label>
                                <input class="form-control" value="@Display(driverProfile.State)" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">CDL Class</label>
                                <input class="form-control" value="@(driverProfile.License is not null ? $"CDL-{driverProfile.License.Class}" : "")"
                                       disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">License Number</label>
                                <input class="form-control" value="@(driverProfile.License?.LicenseNumber ?? "")" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">License Expiration</label>
                                <input class="form-control" type="date" value="@FormatDate(driverProfile.License?.ExpiryDate)" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Years of Experience</label>
                                <input class="form-control" type="number" value="@driverProfile.YearsOfExperience" disabled/>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Total Miles Driven</label>
                                <input class="form-control" type="number" value="@driverProfile.TotalMilesDriven" disabled/>
                            </div>

                            <div class="col-12">
                                @{
                                    var trailerTypes = driverProfile.AllTrailerTypes.ToList();
                                }

                                @if (trailerTypes.Any())
                                {
                                    <label class="form-label">Trailer Types</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var t in trailerTypes)
                                        {
                                            <span class="badge ">@t</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4 ">
                    <div class="card-header">
                        <strong>Step 2 - Confirm Application</strong>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Job</label>
                                <input class="form-control" value="@job.Title (#@job.Id)" disabled/>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Company</label>
                                <input class="form-control" value="@Display(job.Company?.Name)" disabled/>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Profile ID</label>
                                <input class="form-control" value="#@driverProfile.Id" disabled/>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Date</label>
                                <input class="form-control" value="@DateTime.Now.ToString("MM/dd/yyyy")" disabled/>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-success btn-lg" @onclick="SubmitAsync" disabled="@submitting">
                    @(submitting ? "Submitting..." : "Submit Application")
                </button>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger mt-3">@error</div>
                }
            }
        </Authorized>

        <NotAuthorized>
            @if (!isAuthenticated)
            {
                <div class="alert alert-info">
                    <NavLink href="/Account/Login">Please sign in to apply.</NavLink>
                </div>
            }
        </NotAuthorized>
    </AuthorizeView>

    <div class="d-flex justify-content-end gap-2 mt-3 mb-4">
        <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">Back</button>
        @if (!isDriver)
        {
            <button type="button" class="btn btn-primary" @onclick="GoToEdit">Edit Job</button>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Job? job;
    private DriverProfile? driverProfile;
    private JobApplication? appliedApp;
    private string userId;
    private bool alreadyApplied;
    private bool applied;
    private bool loading = true;
    private bool submitting;
    private string? error;
    private bool isAuthenticated;
    private bool isDriver;

    protected override async Task OnInitializedAsync()
    {
        job = await JobSvc.GetByIdAsync(Id);

        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;
        isDriver = isAuthenticated && user.IsInRole(RoleConstants.Driver);

        if (isDriver)
        {
            userId = user.FindFirst(ClaimTypes.NameIdentifier)!.Value;
            driverProfile = await ProfileSvc.GetByUserIdAsync(userId);

            if (driverProfile is not null)
                alreadyApplied = await AppSvc.HasAppliedAsync(Id, userId);
        }

        loading = false;
    }

    private async Task SubmitAsync()
    {
        if (driverProfile is null || job is null)
            return;

        submitting = true;
        error = null;

        try
        {
            appliedApp = await AppSvc.ApplyAsync(Id, userId);
            applied = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            submitting = false;
        }
    }

    private void GoToEdit()
    {
        Nav.NavigateTo($"/jobs/edit/{Id}");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/jobs");
    }

    private void GoToCreateProfile()
    {
        var returnUrl = Uri.EscapeDataString($"/jobs/{Id}");
        Nav.NavigateTo($"/profiles/new?returnUrl={returnUrl}");
    }

    private void GoToEditProfile()
    {
        var returnUrl = Uri.EscapeDataString($"/jobs/{Id}");
        Nav.NavigateTo($"/profiles/new?returnUrl={returnUrl}");
    }

    private void GoToApplications()
    {
        Nav.NavigateTo("/applications");
    }

    private void GoToInvite()
    {
        Nav.NavigateTo($"/jobs/invite/{Id}");
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? string.Empty : value;
    }

    private static string FormatDate(DateOnly? value)
    {
        return value.HasValue && value.Value != default
            ? value.Value.ToString("yyyy-MM-dd")
            : string.Empty;
    }

}

