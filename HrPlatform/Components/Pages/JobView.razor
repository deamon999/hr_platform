@page "/jobs/{Id:int}"
@using System.Security.Claims
@using HrPlatform.Utils
@rendermode InteractiveServer

@inject IJobService JobSvc
@inject IJobApplicationService AppSvc
@inject IDriverProfileService ProfileSvc
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Job Details</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Job Details</h2>
    <AuthorizeView Roles="@($"{RoleConstants.Manager}")">
        <button type="button" class="btn btn-primary btn-sm" @onclick="GoToInvite">+ Invite User</button>
    </AuthorizeView>
</div>

@if (loading)
{
    <p>Loading...</p>
}
else if (job is null)
{
    <div class="alert alert-danger">Job not found.</div>
}
else
{
    <!-- Hero Section -->
    <div class="card shadow-sm mb-4 border-0 bg-white">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3">
                <div>
                    <h1 class="fw-bold mb-2 text-dark">@job.Title</h1>
                    <h5 class="text-primary mb-3">@(job.Company?.Name ?? "Unknown Company")</h5>
                    <div class="d-flex flex-wrap gap-3 text-secondary">
                        <span class="d-flex align-items-center gap-1">
                            <i class="bi bi-geo-alt"></i> @(job.City != null ? $"{job.City}, {job.State}" : job.State) @job.ZipCode
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <i class="bi bi-clock"></i> Posted @job.PostedAt.ToLocalTime().ToString("MMM dd, yyyy")
                        </span>
                        @if (job.EmploymentType.HasValue)
                        {
                            <span class="d-flex align-items-center gap-1">
                                <i class="bi bi-briefcase"></i> @job.EmploymentType.Value.GetDescriptionValue()
                            </span>
                        }
                    </div>
                </div>
                <div class="text-md-end bg-light p-3 rounded border">
                    <div class="text-muted small text-uppercase fw-bold mb-1">Compensation</div>
                    <div class="fs-4 fw-bold text-success">@FormatCompensation(job)</div>
                    @if (job.SignOnBonus > 0)
                    {
                        <div class="badge bg-success mt-2 fs-6 px-3 py-2">
                            <i class="bi bi-gift"></i> $@job.SignOnBonus?.ToString("N0") Sign-On Bonus
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Content (Left Col) -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0 bg-white h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4 border-bottom pb-2">Job Description</h4>
                    <div class="text-secondary" style="white-space: pre-wrap; line-height: 1.6;">
                        @Display(job.Description)
                    </div>
                    
                    @if (!string.IsNullOrWhiteSpace(job.PayNotes))
                    {
                        <h5 class="fw-bold mt-5 mb-3">Pay Notes</h5>
                        <div class="alert alert-info border-0 bg-light text-dark">
                            @job.PayNotes
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Requirements (Right Col) -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 bg-white mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2">Requirements</h5>
                    
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3 d-flex justify-content-between align-items-center">
                            <span class="text-secondary">CDL Class</span>
                            <span class="fw-bold">@(job.RequiredCdlClass.HasValue ? $"Class {job.RequiredCdlClass}" : "Any")</span>
                        </li>
                        <li class="mb-3 d-flex justify-content-between align-items-center">
                            <span class="text-secondary">Experience</span>
                            <span class="fw-bold">@(job.MinYearsExperience > 0 ? $"{job.MinYearsExperience} Years" : "No minimum")</span>
                        </li>
                        @if (job.RequiredTrailerType.HasValue)
                        {
                            <li class="mb-3 d-flex justify-content-between align-items-center">
                                <span class="text-secondary">Trailer Type</span>
                                <span class="fw-bold">@job.RequiredTrailerType.Value.ToString()</span>
                            </li>
                        }
                        @if (job.RouteType.HasValue)
                        {
                            <li class="mb-3 d-flex justify-content-between align-items-center">
                                <span class="text-secondary">Route Type</span>
                                <span class="fw-bold">@job.RouteType.Value.ToString()</span>
                            </li>
                        }
                    </ul>

                    @if (job.RequiredEndorsements.Any())
                    {
                        <div class="mt-4 pt-3 border-top">
                            <div class="text-secondary mb-2 small fw-bold text-uppercase">Endorsements</div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var end in job.RequiredEndorsements)
                                {
                                    <span class="badge bg-secondary">@end.GetDescriptionValue()</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-white">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2">Policies & Perks</h5>
                    <div class="d-flex flex-wrap gap-2">
                        @if (job.AllowsPets)
                        {
                            <span class="badge bg-info text-dark bg-opacity-25 border border-info rounded-pill px-3 py-2"><i class="bi bi-check2"></i> Pets Allowed</span>
                        }
                        @if (job.AllowsRiders)
                        {
                            <span class="badge bg-info text-dark bg-opacity-25 border border-info rounded-pill px-3 py-2"><i class="bi bi-check2"></i> Riders Allowed</span>
                        }
                        @if (job.IsTeamDriving)
                        {
                            <span class="badge bg-primary text-white rounded-pill px-3 py-2"><i class="bi bi-people"></i> Team Driving</span>
                        }
                        @if (job.RequiresManualTransmission)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-gear"></i> Manual Transmission Required</span>
                        }
                    </div>
                    @if (!job.AllowsPets && !job.AllowsRiders && !job.IsTeamDriving && !job.RequiresManualTransmission)
                    {
                        <div class="text-muted fst-italic">No specific policies listed.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <AuthorizeView Roles="Driver">
        <Authorized>
            @if (job.Company != null)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">About @job.Company.Name</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(job.Company.Description))
                        {
                            <p>@job.Company.Description</p>
                        }
                        <div class="row g-2 mt-1">
                            @if (job.Company.FleetSize.HasValue)
                            {
                                <div class="col-auto">
                                    <span class="badge bg-light text-dark border">
                                        @job.Company.FleetSize trucks
                                    </span>
                                </div>
                            }
                            @if (job.Company.RouteType.HasValue)
                            {
                                <div class="col-auto">
                                    <span class="badge bg-info text-dark">
                                        Route: @job.Company.RouteType
                                    </span>
                                </div>
                            }
                            @if (job.Company.PaidCdlTraining)
                            { <div class="col-auto"><span class="badge bg-success">Paid training</span></div> }
                            @if (job.Company.SignOnBonus)
                            { <div class="col-auto"><span class="badge bg-warning text-dark">Sign-on bonus</span></div> }
                            @if (job.Company.BenefitsOffered)
                            { <div class="col-auto"><span class="badge bg-primary">Benefits</span></div> }
                            @if (job.Company.HiringNewGrads)
                            { <div class="col-auto"><span class="badge bg-secondary">New grads OK</span></div> }
                        </div>
                        @if (!string.IsNullOrEmpty(job.Company.WebsiteUrl))
                        {
                            <a href="@job.Company.WebsiteUrl" target="_blank"
                               class="btn btn-sm btn-outline-secondary mt-3">
                                Company website &rarr;
                            </a>
                        }
                    </div>
                </div>
            }
            @if (applied)
            {
                <div class="alert alert-success">
                    <h5 class="alert-heading">Application Submitted!</h5>

                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Job ID</label>
                            <input class="form-control" value="#@appliedApp.Job.Title" disabled/>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Date Submitted</label>
                            <input class="form-control" value="@appliedApp.AppliedAt.ToLocalTime().ToString("MM/dd/yyyy h:mm tt")" disabled/>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <input class="form-control" value="@appliedApp.Status" disabled/>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="GoToEditProfile">
                            Review Profile
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="GoToApplications">
                            All Applications
                        </button>
                    </div>
                </div>
            }
            else if (alreadyApplied)
            {
                <div class="alert alert-info">You have already applied for this position.</div>
            }
            else if (driverProfile is null)
            {
                <div class="alert alert-warning">
                    <strong>Driver profile required.</strong>
                    <a class="alert-link ms-1" role="button" style="cursor:pointer" @onclick="GoToCreateProfile">
                        Create your profile
                    </a>
                    before applying.
                </div>
            }
            else
            {
                <div class="card mb-4 ">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Step 1 - Review Your Profile</strong>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="GoToEditProfile">
                            Update Profile
                        </button>
                    </div>

                    <div class="card-body">
                        <div class="accordion" id="profileAccordion">
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingPersonal">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePersonal" aria-expanded="true" aria-controls="collapsePersonal">
                                        Personal Information
                                    </button>
                                </h2>
                                <div id="collapsePersonal" class="accordion-collapse collapse show" aria-labelledby="headingPersonal" data-bs-parent="#profileAccordion">
                                    <div class="accordion-body">
                                        <HrPlatform.Components.Pages.ProfileShared.ProfilePersonalForm Profile="driverProfile" IsReadOnly="true" />
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingLicense">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLicense" aria-expanded="false" aria-controls="collapseLicense">
                                        License & Medical
                                    </button>
                                </h2>
                                <div id="collapseLicense" class="accordion-collapse collapse" aria-labelledby="headingLicense" data-bs-parent="#profileAccordion">
                                    <div class="accordion-body">
                                        <HrPlatform.Components.Pages.ProfileShared.ProfileLicenseForm Profile="driverProfile" IsReadOnly="true" />
                                    </div>
                                </div>
                            </div>
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="headingStats">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseStats" aria-expanded="false" aria-controls="collapseStats">
                                        Driving Stats
                                    </button>
                                </h2>
                                <div id="collapseStats" class="accordion-collapse collapse" aria-labelledby="headingStats" data-bs-parent="#profileAccordion">
                                    <div class="accordion-body">
                                        <HrPlatform.Components.Pages.ProfileShared.ProfileDrivingStatsForm Profile="driverProfile" IsReadOnly="true" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4 ">
                    <div class="card-header">
                        <strong>Step 2 - Confirm Application</strong>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Job</label>
                                <input class="form-control" value="@job.Title (#@job.Id)" disabled/>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Company</label>
                                <input class="form-control" value="@Display(job.Company?.Name)" disabled/>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Profile ID</label>
                                <input class="form-control" value="#@driverProfile.Id" disabled/>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Date</label>
                                <input class="form-control" value="@DateTime.Now.ToString("MM/dd/yyyy")" disabled/>
                            </div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-success btn-lg" @onclick="SubmitAsync" disabled="@submitting">
                    @(submitting ? "Submitting..." : "Submit Application")
                </button>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger mt-3">@error</div>
                }
            }
        </Authorized>

        <NotAuthorized>
            @if (!isAuthenticated)
            {
                <div class="alert alert-info">
                    <NavLink href="/Account/Login">Please sign in to apply.</NavLink>
                </div>
            }
        </NotAuthorized>
    </AuthorizeView>

    <div class="d-flex justify-content-end gap-2 mt-3 mb-4">
        <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">Back</button>
        @if (!isDriver)
        {
            <button type="button" class="btn btn-primary" @onclick="GoToEdit">Edit Job</button>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Job? job;
    private DriverProfile? driverProfile;
    private JobApplication? appliedApp;
    private string userId = string.Empty;
    private bool alreadyApplied;
    private bool applied;
    private bool loading = true;
    private bool submitting;
    private string? error;
    private bool isAuthenticated;
    private bool isDriver;

    protected override async Task OnInitializedAsync()
    {
        job = await JobSvc.GetByIdAsync(Id);

        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        isAuthenticated = user.Identity?.IsAuthenticated == true;
        isDriver = isAuthenticated && user.IsInRole(RoleConstants.Driver);

        if (isDriver)
        {
            userId = user.FindFirst(ClaimTypes.NameIdentifier)!.Value;
            driverProfile = await ProfileSvc.GetByUserIdAsync(userId);

            if (driverProfile is not null)
                alreadyApplied = await AppSvc.HasAppliedAsync(Id, userId);
        }

        loading = false;
    }

    private async Task SubmitAsync()
    {
        if (driverProfile is null || job is null)
            return;

        submitting = true;
        error = null;

        try
        {
            appliedApp = await AppSvc.ApplyAsync(Id, userId);
            applied = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            submitting = false;
        }
    }

    private void GoToEdit()
    {
        Nav.NavigateTo($"/jobs/edit/{Id}");
    }

    private void GoBack()
    {
        Nav.NavigateTo("/jobs");
    }

    private void GoToCreateProfile()
    {
        var returnUrl = Uri.EscapeDataString($"/jobs/{Id}");
        Nav.NavigateTo($"/profiles/new?returnUrl={returnUrl}");
    }

    private void GoToEditProfile()
    {
        var returnUrl = Uri.EscapeDataString($"/jobs/{Id}");
        Nav.NavigateTo($"/profiles/new?returnUrl={returnUrl}");
    }

    private void GoToApplications()
    {
        Nav.NavigateTo("/applications");
    }

    private void GoToInvite()
    {
        Nav.NavigateTo($"/jobs/invite/{Id}");
    }

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? string.Empty : value;
    }

    private static string FormatDate(DateOnly? value)
    {
        return value.HasValue && value.Value != default
            ? value.Value.ToString("yyyy-MM-dd")
            : string.Empty;
    }

    private static string FormatCompensation(Job? job)
    {
        if (job == null || !job.PayRate.HasValue) return "Not specified";
        
        return job.PayPeriod switch
        {
            PayPeriod.Mile => $"{job.PayRate:N0} CPM (Cents Per Mile)",
            PayPeriod.PercentageOfLoad => $"{job.PayRate:N0}% of Load",
            PayPeriod.Hour => $"${job.PayRate:N2} / hr",
            PayPeriod.Week => $"${job.PayRate:N2} / wk",
            PayPeriod.Month => $"${job.PayRate:N2} / mo",
            PayPeriod.Year => $"${job.PayRate:N0} / yr",
            _ => $"${job.PayRate:N2}"
        };
    }
}

