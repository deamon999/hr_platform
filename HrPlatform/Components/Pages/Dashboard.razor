@page "/dashboard"
@using HrPlatform.Models
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject IDashboardService DashSvc
@inject AuthenticationStateProvider AuthState

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Dashboard</h3>
</div>

@if (stats is null)
{
    <p>Loading...</p>
}
else
{
    <div class="row g-4 mb-4">
        @KpiCard("Active Jobs", stats.OpenJobs, "bi-briefcase", "primary")
        @KpiCard("Applications (7d)", stats.ApplicationsThisWeek, "bi-send", "info")
        @KpiCard("Pending review", stats.PendingApplications, "bi-hourglass", "warning")
        @KpiCard("Accepted (month)", stats.AcceptedThisMonth, "bi-check-circle", "success")
        @KpiCard("Expiring licenses", stats.ExpiringLicenses, "bi-exclamation", "danger")
        @KpiCard("Pending invites", stats.InvitationsPending, "bi-envelope", "secondary")
    </div>

    <div class="card shadow-sm border-0 app-card mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4 border-bottom pb-3">Applications by status</h4>
            <div class="row g-3">
                @foreach (var kv in stats.ApplicationsByStatus)
                {
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="card shadow-sm h-100" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                            <div class="card-body text-center p-3">
                                <div class="fs-2 fw-bold mb-1" style="color: var(--accent-primary);">@kv.Value</div>
                                <div class="text-secondary small fw-medium text-uppercase" style="letter-spacing: 0.05em;">@kv.Key</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private DashboardStats? stats;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        bool admin = user.IsInRole(RoleConstants.Admin);

        if (admin)
            stats = await DashSvc.GetAdminStatsAsync();
        else
        {
            var cid = int.Parse(user.FindFirst("companyId")!.Value);
            stats = await DashSvc.GetManagerStatsAsync(cid);
        }
    }

    private RenderFragment KpiCard(
        string label, int value,
        string icon, string color) => __builder =>
    {
        var gradient = color switch
        {
            "success" => "linear-gradient(135deg, #10b981 0%, #059669 100%)",
            "primary" => "linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-hover) 100%)",
            "info" => "linear-gradient(135deg, #3b82f6 0%, #2563eb 100%)",
            "warning" => "linear-gradient(135deg, #f59e0b 0%, #d97706 100%)",
            "danger" => "linear-gradient(135deg, #ef4444 0%, #dc2626 100%)",
            _ => "rgba(30, 41, 59, 0.7)"
        };

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100 app-card" style="background: @gradient;">
                <div class="card-body d-flex flex-column justify-content-center p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title text-white fw-semibold mb-0">@label</h5>
                        <div class="bg-white bg-opacity-25 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi @icon fs-4 text-white"></i>
                        </div>
                    </div>
                    <h2 class="mb-0 text-white fw-bold display-5">@value</h2>
                </div>
            </div>
        </div>
    };
}

<style>
    .app-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .app-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>

