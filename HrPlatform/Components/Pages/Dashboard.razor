@page "/dashboard"
@using HrPlatform.Models
@using HrPlatform.Data.Entities
@using HrPlatform.Services
@rendermode InteractiveServer
@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]
@inject IDashboardService DashSvc
@inject ILeadService LeadService
@inject AuthenticationStateProvider AuthState

<PageTitle>Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Dashboard</h3>
</div>

@if (stats is null)
{
    <p>Loading...</p>
}
else
{
    <h5 class="fw-bold mb-3 border-bottom pb-2 text-secondary">Active Operations</h5>
    <div class="row g-4 mb-4">
        @KpiCard("Active Jobs", stats.OpenJobs, "bi-briefcase", "primary")
        @KpiCard("Pending review", stats.PendingApplications, "bi-hourglass", "warning")
        @KpiCard("Pending invites", stats.InvitationsPending, "bi-envelope", "secondary")
    </div>

    <h5 class="fw-bold mb-3 border-bottom pb-2 text-secondary mt-4">Alerts</h5>
    <div class="row g-4 mb-4">
        @KpiCard("Actionable Leads", stats.ActiveLeads, "bi-exclamation-circle", "warning", href: "/leads?status=Actionable")
        @KpiCard("Expiring licenses", stats.ExpiringLicenses, "bi-exclamation-triangle", "danger")
    </div>

    <h5 class="fw-bold mb-3 border-bottom pb-2 text-secondary mt-4">Statistics</h5>
    <div class="row g-4 mb-4">
        @KpiCard("Applications (7d)", stats.ApplicationsThisWeek, "bi-graph-up", "primary")
        @KpiCard("Accepted (month)", stats.AcceptedThisMonth, "bi-check-circle", "success")
    </div>

    <div class="card shadow-sm border-0 app-card mb-4">
        <div class="card-body p-4">
            <h4 class="fw-bold mb-4 border-bottom pb-3">Applications by status</h4>
            <div class="row g-3">
                @foreach (var kv in stats.ApplicationsByStatus)
                {
                    <div class="col-6 col-sm-4 col-md-3">
                        <div class="card shadow-sm h-100" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                            <div class="card-body text-center p-3">
                                <div class="fs-2 fw-bold mb-1" style="color: var(--accent-primary);">@kv.Value</div>
                                <div class="text-secondary small fw-medium text-uppercase" style="letter-spacing: 0.05em;">@kv.Key</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private DashboardStats? stats;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;
        bool admin = user.IsInRole(RoleConstants.Admin);
        int? companyIdForLeads = null;

        if (admin)
        {
            stats = await DashSvc.GetAdminStatsAsync();
        }
        else
        {
            var cid = int.Parse(user.FindFirst("companyId")!.Value);
            companyIdForLeads = cid;
            stats = await DashSvc.GetManagerStatsAsync(cid);
        }
    }

    private RenderFragment KpiCard(
        string label, int value,
        string icon, string colorName, string? href = null) => __builder =>
    {
        var iconColor = colorName switch
        {
            "success" => "var(--success-color)",
            "primary" => "var(--accent-primary)",
            "info" => "#3b82f6",
            "warning" => "#f59e0b",
            "danger" => "var(--danger-color)",
            _ => "var(--text-secondary)"
        };

        var iconBg = colorName switch
        {
            "success" => "rgba(16, 185, 129, 0.15)",
            "primary" => "rgba(230, 168, 56, 0.15)",
            "info" => "rgba(59, 130, 246, 0.15)",
            "warning" => "rgba(245, 158, 11, 0.15)",
            "danger" => "rgba(239, 68, 68, 0.15)",
            _ => "rgba(148, 163, 184, 0.15)"
        };

        <div class="col-12 col-md-6 col-lg-4">
            @if (!string.IsNullOrEmpty(href))
            {
                <a href="@href" class="text-decoration-none d-block h-100">
                    <div class="card shadow-sm h-100 app-card position-relative overflow-hidden" style="background-color: var(--bg-card); border: 1px solid var(--border-color) !important; transition: border-color 0.2s;">
                        <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background-color: @iconColor;"></div>
                        
                        <div class="card-body p-4 d-flex align-items-center">
                            <div class="flex-grow-1">
                                <h6 class="text-secondary fw-semibold mb-2 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.8rem;">@label</h6>
                                <h2 class="mb-0 fw-bold text-white display-6">@value</h2>
                            </div>
                            <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 54px; height: 54px; background-color: @iconBg;">
                                <i class="bi @icon fs-3" style="color: @iconColor;"></i>
                            </div>
                        </div>
                    </div>
                </a>
            }
            else
            {
                <div class="card shadow-sm h-100 app-card position-relative overflow-hidden" style="background-color: var(--bg-card); border: 1px solid var(--border-color) !important;">
                    <div class="position-absolute top-0 start-0 w-100" style="height: 3px; background-color: @iconColor;"></div>
                    
                    <div class="card-body p-4 d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="text-secondary fw-semibold mb-2 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.8rem;">@label</h6>
                            <h2 class="mb-0 fw-bold text-white display-6">@value</h2>
                        </div>
                        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 54px; height: 54px; background-color: @iconBg;">
                            <i class="bi @icon fs-3" style="color: @iconColor;"></i>
                        </div>
                    </div>
                </div>
            }
        </div>
    };
}

<style>
    .app-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .app-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>

