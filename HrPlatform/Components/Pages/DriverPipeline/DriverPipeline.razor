@page "/driver-pipeline"
@using System.Security.Claims
@using HrPlatform.Data.Entities
@using HrPlatform.Utils
@rendermode InteractiveServer
<TimezoneInitializer/>

@attribute [Authorize(Roles = $"{RoleConstants.Admin},{RoleConstants.Manager}")]

@inject ILeadService LeadService
@inject ILeadNoteService LeadNoteService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>Pipeline</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Pipeline</h2>
    <button type="button" class="btn btn-primary px-4" @onclick="OpenAddLeadModal">+ Add Candidate</button>
</div>

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2">
        <DebounceInput class="form-control form-control-sm bg-dark text-light border-secondary"
                       placeholder="Search candidates..."
                       @bind-Value="_searchTerm"
                       @bind-Value:after="ResetPageAndLoad"
                       disabled="@isLoading"/>

        <select class="form-select form-select-sm bg-dark text-light border-secondary" style="min-width: 140px;" @bind="_filterStatusStr"
                @bind:after="ResetPageAndLoad">
            <option value="">All Statuses</option>
            <option value="Actionable">Needs Action</option>
            <option value="Registered">Registered Profiles</option>
            @foreach (var status in Enum.GetValues<LeadStatus>().Where(s => !s.IsLegacy()))
            {
                <option value="@status">@(status.GetDescriptionValue() ?? status.ToString())</option>
            }
        </select>

        <select class="form-select form-select-sm bg-dark text-light border-secondary" style="min-width: 140px;" @bind="_filterUserId"
                @bind:after="ResetPageAndLoad">
            <option value="">All Users</option>
            @foreach (var u in _users)
            {
                <option value="@u.Id">@u.Email</option>
            }
        </select>
        
        @if (!string.IsNullOrWhiteSpace(_searchTerm) || !string.IsNullOrWhiteSpace(_filterStatusStr) || !string.IsNullOrWhiteSpace(_filterUserId))
        {
            <button class="btn btn-sm btn-outline-secondary text-nowrap" @onclick="ClearFilters" disabled="@isLoading">Clear</button>
        }
    </div>
    <div class="d-flex align-items-center gap-3">
        @if (isAdmin)
        {
            <div class="form-check form-switch mb-0 d-flex align-items-center gap-2 admin-switch">
                <input class="form-check-input mt-0 fs-5" type="checkbox" id="showAllLeadsSwitch" @bind="_showAllLeads" @bind:after="ResetPageAndLoad"
                       style="cursor: pointer;">
                <label class="form-check-label text-light small fw-bold text-nowrap mb-0" for="showAllLeadsSwitch"
                       style="cursor: pointer; letter-spacing: 0.05em; color: #dfb155 !important;">
                    <i class="bi bi-shield-lock-fill me-1 me-md-1"></i> ADMIN: SHOW ALL LEADS
                </label>
            </div>
        }
        <div class="d-flex align-items-center gap-2">
            <span class="text-secondary small fw-medium text-nowrap d-none d-md-inline">Items per page:</span>
            <select class="form-select form-select-sm bg-dark text-light border-secondary shadow-sm" style="width: 70px;" @bind="PageSize" @bind:after="ResetPageAndLoad">
                <option value="10">10</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>
</div>

@if (isLoading)
{
    <LoadingSpinner Text="Loading pipeline..." />
}
else
{
    <!-- Responsive Card List -->
    <div class="row g-3">
        @foreach (var lead in pagedLeads)
        {
            <div class="col-12">
                <div class="card shadow-sm border border-secondary bg-dark text-light" style="@GetCardStyle(lead.Status)">
                    <div class="card-body p-3">
                        <div class="row align-items-start">
                            
                            <!-- Col 1: Identity -->
                            <div class="col-12 col-md-5 col-lg-4 mb-3 mb-md-0">
                                <h5 class="fw-bold mb-1 d-flex align-items-center flex-wrap gap-2">
                                    @lead.FirstName @lead.LastName
                                    @if (!string.IsNullOrEmpty(lead.ConvertedUserId))
                                    {
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success" style="font-size: 0.65rem;">Registered</span>
                                    }
                                </h5>
                                @if (!string.IsNullOrEmpty(lead.Email))
                                {
                                    <div class="small text-secondary mb-1"><i class="bi bi-envelope me-2 me-md-1"></i>@lead.Email</div>
                                }
                                @if (!string.IsNullOrEmpty(lead.Phone))
                                {
                                    <div class="small text-secondary"><i class="bi bi-telephone me-2 me-md-1"></i>@lead.Phone</div>
                                }
                            </div>

                            <!-- Col 2: Tags & Meta -->
                            <div class="col-12 col-md-4 col-lg-4 mb-3 mb-md-0 d-flex flex-column gap-2">
                                @if (lead.TrailerTypes.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tt in lead.TrailerTypes)
                                        {
                                            <span class="badge bg-secondary">@tt.ToString()</span>
                                        }
                                    </div>
                                }
                                
                                <div class="small text-secondary mt-auto">
                                    Added @TimeZoneService.ToUserTime(lead.CreatedAt).ToString("MMM dd, yyyy") 
                                    @(lead.AddedByUser != null ? $"by {lead.AddedByUser.Email}" : "by Unknown User")
                                </div>
                            </div>

                            <!-- Col 3: Status & Reminder -->
                            <div class="col-12 col-md-3 col-lg-4 d-flex flex-column align-items-md-end gap-2">
                                <select class="form-select form-select-sm border-0 fw-bold shadow-sm @GetStatusClass(lead.Status)"
                                        style="max-width: 200px;"
                                        value="@lead.Status.ToString()"
                                        @onchange="@(async e => await UpdateStatusAsync(lead, e.Value?.ToString()))">
                                    @foreach (var status in Enum.GetValues<LeadStatus>().Where(s => s != LeadStatus.Contacted && s != LeadStatus.Invited && s != LeadStatus.Converted))
                                    {
                                        <option value="@status">@(status.GetDescriptionValue() ?? status.ToString())</option>
                                    }
                                </select>
                                
                                @if (lead.Status != LeadStatus.Hired && lead.Status != LeadStatus.NotInterested && (lead.Status == LeadStatus.NeedsToBeContacted || lead.ReminderDate.HasValue))
                                {
                                    var isDue = lead.ReminderDate.HasValue && lead.ReminderDate.Value.Date <= DateTime.UtcNow.Date;
                                    var colorClass = isDue ? "text-danger fw-bold" : "text-secondary";
                                    <div class="d-flex align-items-center @colorClass">
                                        <i class="bi bi-bell-fill small me-1 me-md-1"></i>
                                        <input type="date" class="form-control form-control-sm border-0 bg-transparent px-1 py-0 shadow-none @colorClass"
                                               style="max-width: 130px; font-size: 0.75rem;"
                                               value="@lead.ReminderDate?.ToString("yyyy-MM-dd")"
                                               @onchange="@(async e => await UpdateReminderDateAsync(lead, e.Value?.ToString()))"/>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <!-- Unified Actions Footer -->
                    <div class="card-footer bg-dark border-top border-secondary p-2 px-3 d-flex justify-content-between align-items-center">
                        <button class="btn btn-sm btn-link text-info text-decoration-none p-0 d-flex align-items-center" 
                                @onclick="() => OpenLeadDrawer(lead)">
                            <i class="bi bi-chat-square-text me-2 me-md-1"></i> 
                            <span class="fw-bold" style="font-size: 0.85rem;">@lead.Notes.Count Notes</span>
                        </button>
                        
                        <div class="d-flex gap-2 flex-wrap justify-content-end">
                            @if (!string.IsNullOrEmpty(lead.ConvertedUserId))
                            {
                                <a href="/profiles/user/@lead.ConvertedUserId" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-person-vcard me-md-1"></i>
                                    <span class="d-none d-md-inline">View Profile</span>
                                </a>
                            }
                            @if (lead.Status != LeadStatus.Hired)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenInviteModal(lead)">
                                    <i class="bi bi-envelope-paper me-md-1"></i>
                                    <span class="d-none d-md-inline">Invite</span>
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenLeadDrawer(lead, true)">
                                <i class="bi bi-pencil me-md-1"></i>
                                <span class="d-none d-md-inline">Edit</span>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(lead)">
                                <i class="bi bi-trash me-md-1"></i>
                                <span class="d-none d-md-inline">Delete</span>
                            </button>
                        </div>
                        </div>
                        </div>
                        </div>
                        }
    </div>

    @if (pagedLeads.Count == 0)
    {
        <EmptyState Icon="bi-funnel"
                    Title="No candidates found"
                    Message="No candidates matched your search or filter criteria."
                    ActionText="+ Add Candidate"
                    ActionIcon="bi-person-plus"
                    OnAction="OpenAddLeadModal" />
    }

    <PaginationNav TotalPages="totalPages" CurrentPage="currentPage" OnPageChanged="ChangePage" AriaLabel="Lead list pagination" />
}

<ConfirmDialog IsOpen="@(deleteTarget != null)"
               Title="Confirm Delete Candidate"
               ConfirmText="Delete"
               ConfirmButtonClass="btn-danger"
               IsProcessing="@isDeleting"
               OnConfirm="DeleteConfirmedAsync"
               OnCancel="CancelDelete">
    <BodyContent>
        @if (deleteTarget != null)
        {
            <p class="mb-0">Are you sure you want to delete candidate <strong class="text-light">@deleteTarget.FirstName @deleteTarget.LastName</strong>? This will also remove all associated notes.</p>
        }
    </BodyContent>
</ConfirmDialog>

@if (isDrawerOpen)
{
    <LeadDrawer Lead="@selectedLead" OnClose="CloseDrawer" OnLeadSaved="HandleLeadSaved" CompanyId="userCompanyId"/>
}

@if (isEditModalOpen)
{
    <LeadEditModal Lead="@editTargetLead" OnClose="CloseEditModal" OnLeadSaved="HandleLeadSaved"/>
}

@if (isInviteModalOpen && inviteTargetLead != null)
{
    <InviteLeadModal Lead="inviteTargetLead" IsAdmin="isAdmin" ManagerCompanyId="userCompanyId" OnClose="CloseInviteModal"
                     OnInvited="HandleInviteSent"/>
}

<style>
    .admin-switch .form-check-input {
        background-color: #2b2d31;
        border: 2px solid #dfb155;
    }

    .admin-switch .form-check-input:checked {
        background-color: #dfb155;
        border-color: #dfb155;
    }

    .admin-switch .form-check-input:focus {
        box-shadow: 0 0 0 0.25rem rgba(223, 177, 85, 0.25);
    }
</style>

@code {
    private List<Lead> pagedLeads = new();

    [SupplyParameterFromQuery(Name = "q")] public string? _searchTerm { get; set; } = string.Empty;

    [SupplyParameterFromQuery(Name = "status")]
    public string? _filterStatusStr { get; set; }

    private LeadStatus? _filterStatus => Enum.TryParse<LeadStatus>(_filterStatusStr, out var s) ? s : null;

    [SupplyParameterFromQuery(Name = "user")]
    public string? _filterUserId { get; set; }

    [SupplyParameterFromQuery(Name = "all")]
    public bool _showAllLeads { get; set; }

    private List<ApplicationUser> _users = new();

    private bool isLoading = true;

    [SupplyParameterFromQuery(Name = "page")]
    public int currentPage { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "size")]
    public int PageSize { get; set; } = 10;

    private int totalPages = 1;

    private bool isAdmin;
    private int? userCompanyId;

    private bool isDrawerOpen;
    private Lead? selectedLead;
    private bool isEditModalOpen;
    private Lead? editTargetLead;
    private bool isInviteModalOpen;
    private Lead? inviteTargetLead;
    private Lead? deleteTarget;

    private bool IsLeadRegistered(Lead lead)
    {
        return !string.IsNullOrEmpty(lead.ConvertedUserId);
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        isAdmin = user.IsInRole(RoleConstants.Admin);

        if (!isAdmin)
        {
            var companyIdClaim = user.FindFirst("companyId")?.Value;
            if (int.TryParse(companyIdClaim, out var parsedCompanyId))
            {
                userCompanyId = parsedCompanyId;
            }
        }

        _users = await LeadService.GetUsersWithLeadsAsync(userCompanyId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (currentPage < 1) currentPage = 1;
        if (PageSize < 1) PageSize = 10;
        await LoadAsync(_searchTerm);
    }

    private async Task LoadAsync(string? searchTerm)
    {
        isLoading = true;
        try
        {
            var isActionable = _filterStatusStr == "Actionable";
            var isRegistered = _filterStatusStr == "Registered";
            var globalOnly = isAdmin && !_showAllLeads;
            var result = await LeadService.GetLeadsPagedAsync(currentPage, PageSize, userCompanyId, searchTerm, _filterStatus, _filterUserId, isActionable, globalOnly, isRegistered);
            pagedLeads = result.Items.ToList();
            totalPages = result.TotalPages;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetPageAndLoad()
    {
        currentPage = 1;
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = null,
            ["size"] = PageSize == 10 ? null : PageSize,
            ["q"] = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
            ["status"] = string.IsNullOrWhiteSpace(_filterStatusStr) ? null : _filterStatusStr,
            ["user"] = string.IsNullOrWhiteSpace(_filterUserId) ? null : _filterUserId,
            ["all"] = _showAllLeads ? true : null
        });
        await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", uri);
        await LoadAsync(_searchTerm);
    }

    private void HandleLeadSaved(bool isNew)
    {
        if (isEditModalOpen) CloseEditModal();
        if (isNew)
        {
            _searchTerm = string.Empty;
            _filterStatusStr = string.Empty;
            _filterUserId = string.Empty;
            ChangePage(1);
        }
        else
        {
            ChangePage(currentPage);
        }
    }

    private void ChangePage(int page)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["page"] = page,
            ["size"] = PageSize,
            ["q"] = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
            ["status"] = string.IsNullOrWhiteSpace(_filterStatusStr) ? null : _filterStatusStr,
            ["user"] = string.IsNullOrWhiteSpace(_filterUserId) ? null : _filterUserId,
            ["all"] = _showAllLeads ? true : null
        });
        Nav.NavigateTo(uri);
    }

    private async Task ClearFilters()
    {
        _searchTerm = null;
        _filterStatusStr = null;
        _filterUserId = null;
        await ResetPageAndLoad();
    }

    private string GetStatusClass(LeadStatus status)
    {
        return status switch
        {
            LeadStatus.New => "text-primary bg-primary bg-opacity-10",
            LeadStatus.NotInterested => "text-secondary bg-secondary bg-opacity-10",
            LeadStatus.NotQualified => "text-danger bg-danger bg-opacity-10",
            LeadStatus.ReadyToStart => "text-success bg-success bg-opacity-10",
            LeadStatus.AttemptContact => "text-warning bg-warning bg-opacity-10",
            LeadStatus.NeedsToBeContacted => "text-warning bg-warning bg-opacity-10",
            LeadStatus.ReadyIn2Weeks => "text-info bg-info bg-opacity-10",
            LeadStatus.Hired => "text-success bg-success bg-opacity-25 border border-success",
            LeadStatus.Contacted => "text-info bg-info bg-opacity-10",
            LeadStatus.Invited => "text-primary bg-primary bg-opacity-10",
            LeadStatus.Rejected => "text-danger bg-danger bg-opacity-10 border border-danger",
            _ => "text-secondary bg-secondary bg-opacity-10"
        };
    }

    private string GetCardStyle(LeadStatus status)
    {
        return status switch
        {
            LeadStatus.New => "background-color: rgba(var(--bs-primary-rgb), 0.1) !important; border-color: var(--bs-primary) !important;",
            LeadStatus.NotInterested => "background-color: rgba(var(--bs-secondary-rgb), 0.1) !important; border-color: var(--bs-secondary) !important;",
            LeadStatus.NotQualified => "background-color: rgba(var(--bs-danger-rgb), 0.1) !important; border-color: var(--bs-danger) !important;",
            LeadStatus.ReadyToStart => "background-color: rgba(var(--bs-success-rgb), 0.1) !important; border-color: var(--bs-success) !important;",
            LeadStatus.AttemptContact => "background-color: rgba(var(--bs-warning-rgb), 0.1) !important; border-color: var(--bs-warning) !important;",
            LeadStatus.NeedsToBeContacted => "background-color: rgba(var(--bs-warning-rgb), 0.1) !important; border-color: var(--bs-warning) !important;",
            LeadStatus.ReadyIn2Weeks => "background-color: rgba(var(--bs-info-rgb), 0.1) !important; border-color: var(--bs-info) !important;",
            LeadStatus.Hired => "background-color: rgba(var(--bs-success-rgb), 0.25) !important; border-color: var(--bs-success) !important; border-width: 2px !important;",
            LeadStatus.Contacted => "background-color: rgba(var(--bs-info-rgb), 0.1) !important; border-color: var(--bs-info) !important;",
            LeadStatus.Invited => "background-color: rgba(var(--bs-primary-rgb), 0.1) !important; border-color: var(--bs-primary) !important;",
            LeadStatus.Rejected => "background-color: rgba(var(--bs-danger-rgb), 0.1) !important; border-color: var(--bs-danger) !important;",
            _ => "border-color: var(--bs-secondary) !important;"
        };
    }

    private async Task UpdateStatusAsync(Lead lead, string? newStatusStr)
    {
        if (Enum.TryParse<LeadStatus>(newStatusStr, out var newStatus))
        {
            lead.Status = newStatus;

            if (newStatus == LeadStatus.ReadyIn2Weeks)
            {
                lead.ReminderDate = DateTime.UtcNow.Date.AddDays(14);
            }

            await LeadService.UpdateAsync(lead);
        }
    }

    private async Task UpdateReminderDateAsync(Lead lead, string? newDateStr)
    {
        if (string.IsNullOrWhiteSpace(newDateStr))
        {
            lead.ReminderDate = null;
        }
        else if (DateTime.TryParse(newDateStr, out var newDate))
        {
            // Set the reminder date exactly to the date selected.
            lead.ReminderDate = DateTime.SpecifyKind(newDate, DateTimeKind.Utc);
        }

        await LeadService.UpdateAsync(lead);
    }


    private void OpenAddLeadModal()
    {
        editTargetLead = new Lead { CompanyId = userCompanyId };
        isEditModalOpen = true;
    }

    private void OpenLeadDrawer(Lead lead, bool editMode = false)
    {
        if (editMode)
        {
            editTargetLead = lead;
            isEditModalOpen = true;
        }
        else
        {
            selectedLead = lead;
            isDrawerOpen = true;
        }
    }

    private void OpenInviteModal(Lead lead)
    {
        inviteTargetLead = lead;
        isInviteModalOpen = true;
    }

    private void CloseInviteModal()
    {
        isInviteModalOpen = false;
        inviteTargetLead = null;
    }

    private async Task HandleInviteSent(string message)
    {
        if (inviteTargetLead != null)
        {
            var currentUserId = (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirstValue(ClaimTypes.NameIdentifier);
            var note = new LeadNote
            {
                LeadId = inviteTargetLead.Id,
                AuthorUserId = currentUserId ?? string.Empty,
                Content = $"System: {message}."
            };
            await LeadNoteService.CreateAsync(note);
        }

        isInviteModalOpen = false;
        inviteTargetLead = null;
        await LoadAsync(_searchTerm);
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
        selectedLead = null;
    }

    private void CloseEditModal()
    {
        isEditModalOpen = false;
        editTargetLead = null;
    }

    private void ConfirmDelete(Lead lead)
    {
        deleteTarget = lead;
    }

    private void CancelDelete()
    {
        deleteTarget = null;
    }

    private bool isDeleting;

    private async Task DeleteConfirmedAsync()
    {
        if (deleteTarget != null && !isDeleting)
        {
            isDeleting = true;
            try
            {
                await LeadService.DeleteAsync(deleteTarget.Id);
                deleteTarget = null;
                await LoadAsync(_searchTerm);
            }
            finally
            {
                isDeleting = false;
            }
        }
    }

}
